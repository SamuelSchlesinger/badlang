-- ============================================================
-- AST Type Declarations
-- ============================================================

oneof Decl
  -- closure is compiler metadata: 0 for source functions, 1 for lifted lambdas.
  DeclFn { name, clauses, closure }
  DeclDo { name, stmts }
  DeclTest { name, stmts }
  DeclStruct { name, fields }
  DeclOneof { name, variants }
  DeclImport { name }
  DeclOpen { name }
end

oneof Stmt
  StmtLet { name, value }
  StmtPrint { value }
  StmtWrite { value }
  StmtExpr { value }
end
