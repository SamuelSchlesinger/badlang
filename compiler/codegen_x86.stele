open Util
open Ast
open Parser
open Codegen_c

-- ============================================================
-- x86-64 Code Generation: Platform Helpers
-- ============================================================

-- Symbol prefix: "_" for macOS, "" for Linux
fn sym_prefix_x86
  case {| mode |} =>
    match str_eq {| a: mode, b: "x86" |}
      case 1 => "_"
      case 0 => ""
    end
end

-- Text section directive
fn text_section_x86
  case {| mode |} =>
    match str_eq {| a: mode, b: "x86" |}
      case 1 => ".section __TEXT,__text"
      case 0 => ".text"
    end
end

-- String/rodata section directive
fn cstring_section_x86
  case {| mode |} =>
    match str_eq {| a: mode, b: "x86" |}
      case 1 => ".section __TEXT,__cstring"
      case 0 => ".section .rodata"
    end
end

-- Local label prefix
fn label_prefix_x86
  case {| mode |} =>
    match str_eq {| a: mode, b: "x86" |}
      case 1 => "L"
      case 0 => ".L"
    end
end

-- ============================================================
-- x86-64 Code Generation: Helpers
-- ============================================================

-- Stack offset for a slot: -(slot+1)*8
fn slot_offset_x86
  case {| slot |} => 0 - ((slot + 1) * 8)
end

-- Generate load from stack slot into register (x86-64, AT&T syntax)
fn emit_load_slot_x86
  case {| slot, reg |} =>
    let off = slot_offset_x86 {| slot: slot |}
    let off_s = int_to_str {| n: off |}
    let s1 = concat {| a: "  movq ", b: off_s |}
    let s2 = concat {| a: s1, b: "(%rbp), " |}
    asm_ln {| s: concat {| a: s2, b: reg |} |}
end

-- Generate store register into stack slot (x86-64, AT&T syntax)
fn emit_store_slot_x86
  case {| slot, reg |} =>
    let off = slot_offset_x86 {| slot: slot |}
    let off_s = int_to_str {| n: off |}
    let s1 = concat {| a: "  movq ", b: reg |}
    let s2 = concat {| a: s1, b: ", " |}
    let s3 = concat {| a: s2, b: off_s |}
    asm_ln {| s: concat {| a: s3, b: "(%rbp)" |} |}
end

-- Generate mov immediate (x86-64)
fn emit_mov_imm_x86
  case {| reg, n |} =>
    let nc = nl {| |}
    let s1 = concat {| a: "  movq $", b: int_to_str {| n: n |} |}
    let s2 = concat {| a: s1, b: ", " |}
    let s3 = concat {| a: s2, b: reg |}
    concat {| a: s3, b: nc |}
end

-- x86-64 function prologue with a 16-byte-aligned, per-function frame.
fn emit_prologue_x86
  case {| frame_size |} =>
    let n = nl {| |}
    let s1 = concat {| a: "  pushq %rbp", b: n |}
    let s2 = concat {| a: s1, b: "  movq %rsp, %rbp" |}
    let s3 = concat {| a: s2, b: n |}
    match frame_size == 0
      case 1 => s3
      case 0 =>
        let s4 = concat {| a: s3, b: "  subq $" |}
        let s5 = concat {| a: s4, b: int_to_str {| n: frame_size |} |}
        concat {| a: concat {| a: s5, b: ", %rsp" |}, b: n |}
    end
end

-- x86-64 function epilogue
fn emit_epilogue_x86
  case {| |} =>
    let n = nl {| |}
    let s1 = concat {| a: "  movq %rbp, %rsp", b: n |}
    let s2 = concat {| a: s1, b: "  popq %rbp" |}
    let s3 = concat {| a: s2, b: n |}
    let s4 = concat {| a: s3, b: "  retq" |}
    concat {| a: s4, b: n |}
end

-- Retain/release code for bound pattern vars (x86-64)
fn gen_retain_code_x86
  case {| names, slots, mode |} =>
    match is_nil {| list: names |}
      case 1 => ""
      case 0 =>
        let head = list_head {| list: names |}
        let tail = list_tail {| list: names |}
        let cn = c_name {| name: head |}
        let slot = lookup_slot {| name: cn, slots: slots |}
        let load = emit_load_slot_x86 {| slot: slot, reg: "%rdi" |}
        let pfx = sym_prefix_x86 {| mode: mode |}
        let s1 = concat {| a: load, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_retain" |} |} |} |}
        let rest = gen_retain_code_x86 {| names: tail, slots: slots, mode: mode |}
        concat {| a: s1, b: rest |}
    end
end

fn gen_release_code_x86
  case {| names, slots, mode |} =>
    match is_nil {| list: names |}
      case 1 => ""
      case 0 =>
        let head = list_head {| list: names |}
        let tail = list_tail {| list: names |}
        let cn = c_name {| name: head |}
        let slot = lookup_slot {| name: cn, slots: slots |}
        let load = emit_load_slot_x86 {| slot: slot, reg: "%rdi" |}
        let pfx = sym_prefix_x86 {| mode: mode |}
        let s1 = concat {| a: load, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_release" |} |} |} |}
        let rest = gen_release_code_x86 {| names: tail, slots: slots, mode: mode |}
        concat {| a: s1, b: rest |}
    end
end

-- ============================================================
-- x86-64: Expression Emission
-- ============================================================

fn emit_int_lit_x86
  case {| node, state, mode |} =>
    let pfx = sym_prefix_x86 {| mode: mode |}
    let f = fresh_var {| prefix: "_t", counter: state.counter |}
    let st1 = {| counter: f.counter, slot_counter: state.slot_counter, slots: state.slots, strs: state.strs |}
    let r = alloc_slot {| name: f.name, state: st1 |}
    let val = str_to_int {| s: node.value |}
    let mov = emit_mov_imm_x86 {| reg: "%rdi", n: val |}
    let store = emit_store_slot_x86 {| slot: r.slot, reg: "%rax" |}
    let code = concat {| a: mov, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "make_int" |} |} |} |}
    {| code: concat {| a: code, b: store |}, var: f.name, state: r.state |}
end

fn emit_str_lit_x86
  case {| node, state, mode |} =>
    let n = nl {| |}
    let pfx = sym_prefix_x86 {| mode: mode |}
    let f = fresh_var {| prefix: "_t", counter: state.counter |}
    let st1 = {| counter: f.counter, slot_counter: state.slot_counter, slots: state.slots, strs: state.strs |}
    let sr = add_str_asm {| s: node.value, state: st1 |}
    let r = alloc_slot {| name: f.name, state: sr.state |}
    let store = emit_store_slot_x86 {| slot: r.slot, reg: "%rax" |}
    let s1 = concat {| a: "  leaq ", b: sr.label |}
    let s2 = concat {| a: s1, b: "(%rip), %rdi" |}
    let s3 = concat {| a: s2, b: n |}
    let code = concat {| a: s3, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "make_str" |} |} |} |}
    {| code: concat {| a: code, b: store |}, var: f.name, state: r.state |}
end

fn emit_var_x86
  case {| node, state, mode |} =>
    let pfx = sym_prefix_x86 {| mode: mode |}
    let cn = c_name {| name: node.name |}
    let src_slot = lookup_slot {| name: cn, slots: state.slots |}
    let f = fresh_var {| prefix: "_t", counter: state.counter |}
    let st1 = {| counter: f.counter, slot_counter: state.slot_counter, slots: state.slots, strs: state.strs |}
    let r = alloc_slot {| name: f.name, state: st1 |}
    let load = emit_load_slot_x86 {| slot: src_slot, reg: "%r8" |}
    let store = emit_store_slot_x86 {| slot: r.slot, reg: "%r8" |}
    let rload = emit_load_slot_x86 {| slot: r.slot, reg: "%rdi" |}
    let s1 = concat {| a: load, b: store |}
    let s2 = concat {| a: s1, b: rload |}
    {| code: concat {| a: s2, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_retain" |} |} |} |}, var: f.name, state: r.state |}
end

fn emit_binop_op_x86
  case {| op |} =>
    let n = nl {| |}
    match op
      case "==" =>
        let s1 = concat {| a: "  cmpq %r9, %r8", b: n |}
        let s2 = concat {| a: s1, b: "  sete %dil" |}
        let s3 = concat {| a: s2, b: n |}
        concat {| a: s3, b: asm_ln {| s: "  movzbl %dil, %edi" |} |}
      case "!=" =>
        let s1 = concat {| a: "  cmpq %r9, %r8", b: n |}
        let s2 = concat {| a: s1, b: "  setne %dil" |}
        let s3 = concat {| a: s2, b: n |}
        concat {| a: s3, b: asm_ln {| s: "  movzbl %dil, %edi" |} |}
      case "<" =>
        let s1 = concat {| a: "  cmpq %r9, %r8", b: n |}
        let s2 = concat {| a: s1, b: "  setl %dil" |}
        let s3 = concat {| a: s2, b: n |}
        concat {| a: s3, b: asm_ln {| s: "  movzbl %dil, %edi" |} |}
      case ">" =>
        let s1 = concat {| a: "  cmpq %r9, %r8", b: n |}
        let s2 = concat {| a: s1, b: "  setg %dil" |}
        let s3 = concat {| a: s2, b: n |}
        concat {| a: s3, b: asm_ln {| s: "  movzbl %dil, %edi" |} |}
      case "<=" =>
        let s1 = concat {| a: "  cmpq %r9, %r8", b: n |}
        let s2 = concat {| a: s1, b: "  setle %dil" |}
        let s3 = concat {| a: s2, b: n |}
        concat {| a: s3, b: asm_ln {| s: "  movzbl %dil, %edi" |} |}
      case ">=" =>
        let s1 = concat {| a: "  cmpq %r9, %r8", b: n |}
        let s2 = concat {| a: s1, b: "  setge %dil" |}
        let s3 = concat {| a: s2, b: n |}
        concat {| a: s3, b: asm_ln {| s: "  movzbl %dil, %edi" |} |}
      case "&&" =>
        let s1 = concat {| a: "  testq %r8, %r8", b: n |}
        let s2 = concat {| a: s1, b: "  setne %al" |}
        let s3 = concat {| a: s2, b: n |}
        let s4 = concat {| a: s3, b: "  testq %r9, %r9" |}
        let s5 = concat {| a: s4, b: n |}
        let s6 = concat {| a: s5, b: "  setne %cl" |}
        let s7 = concat {| a: s6, b: n |}
        let s8 = concat {| a: s7, b: "  andb %cl, %al" |}
        let s9 = concat {| a: s8, b: n |}
        concat {| a: s9, b: asm_ln {| s: "  movzbl %al, %edi" |} |}
      case "||" =>
        let s1 = concat {| a: "  orq %r9, %r8", b: n |}
        let s2 = concat {| a: s1, b: "  testq %r8, %r8" |}
        let s3 = concat {| a: s2, b: n |}
        let s4 = concat {| a: s3, b: "  setne %dil" |}
        let s5 = concat {| a: s4, b: n |}
        concat {| a: s5, b: asm_ln {| s: "  movzbl %dil, %edi" |} |}
    end
end

fn emit_checked_binop_call_x86
  case {| left_slot, right_slot, operation, mode |} =>
    let pfx = sym_prefix_x86 {| mode: mode |}
    let lp = emit_load_slot_x86 {| slot: left_slot, reg: "%rdi" |}
    let rp = emit_load_slot_x86 {| slot: right_slot, reg: "%rsi" |}
    let call = asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: operation |} |} |}
    concat {| a: concat {| a: lp, b: rp |}, b: call |}
end

fn emit_binop_x86
  case {| node, state, mode |} =>
    let pfx = sym_prefix_x86 {| mode: mode |}
    let r1 = emit_expr_x86 {| node: node.left, state: state, mode: mode |}
    let r2 = emit_expr_x86 {| node: node.right, state: r1.state, mode: mode |}
    let f = fresh_var {| prefix: "_t", counter: r2.state.counter |}
    let st = {| counter: f.counter, slot_counter: r2.state.slot_counter, slots: r2.state.slots, strs: r2.state.strs |}
    let ar = alloc_slot {| name: f.name, state: st |}
    let ls = lookup_slot {| name: r1.var, slots: ar.state.slots |}
    let rs = lookup_slot {| name: r2.var, slots: ar.state.slots |}
    let store = emit_store_slot_x86 {| slot: ar.slot, reg: "%rax" |}
    let rll = emit_load_slot_x86 {| slot: ls, reg: "%rdi" |}
    let rrl = emit_load_slot_x86 {| slot: rs, reg: "%rdi" |}
    let s1 = concat {| a: r1.code, b: r2.code |}
    let calc = match node.op
      case "==" =>
        let lp = emit_load_slot_x86 {| slot: ls, reg: "%rdi" |}
        let rp = emit_load_slot_x86 {| slot: rs, reg: "%rsi" |}
        let c1 = concat {| a: lp, b: rp |}
        let c2 = concat {| a: c1, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "stele_value_eq" |} |} |} |}
        let c3 = concat {| a: c2, b: asm_ln {| s: "  movl %eax, %edi" |} |}
        concat {| a: c3, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "make_int" |} |} |} |}
      case "!=" =>
        let lp = emit_load_slot_x86 {| slot: ls, reg: "%rdi" |}
        let rp = emit_load_slot_x86 {| slot: rs, reg: "%rsi" |}
        let c1 = concat {| a: lp, b: rp |}
        let c2 = concat {| a: c1, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "stele_value_neq" |} |} |} |}
        let c3 = concat {| a: c2, b: asm_ln {| s: "  movl %eax, %edi" |} |}
        concat {| a: c3, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "make_int" |} |} |} |}
      case "+" => emit_checked_binop_call_x86 {| left_slot: ls, right_slot: rs, operation: "checked_add", mode: mode |}
      case "-" => emit_checked_binop_call_x86 {| left_slot: ls, right_slot: rs, operation: "checked_sub", mode: mode |}
      case "*" => emit_checked_binop_call_x86 {| left_slot: ls, right_slot: rs, operation: "checked_mul", mode: mode |}
      case "/" => emit_checked_binop_call_x86 {| left_slot: ls, right_slot: rs, operation: "checked_div", mode: mode |}
      case "%" => emit_checked_binop_call_x86 {| left_slot: ls, right_slot: rs, operation: "checked_mod", mode: mode |}
      case _ =>
        let ll = emit_load_slot_x86 {| slot: ls, reg: "%r8" |}
        let rl = emit_load_slot_x86 {| slot: rs, reg: "%r9" |}
        let op = emit_binop_op_x86 {| op: node.op |}
        let c1 = concat {| a: ll, b: asm_ln {| s: "  movq 8(%r8), %r8" |} |}
        let c2 = concat {| a: c1, b: rl |}
        let c3 = concat {| a: c2, b: asm_ln {| s: "  movq 8(%r9), %r9" |} |}
        let c4 = concat {| a: c3, b: op |}
        concat {| a: c4, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "make_int" |} |} |} |}
    end
    let s2 = concat {| a: s1, b: calc |}
    let s3 = concat {| a: s2, b: store |}
    let s4 = concat {| a: s3, b: rll |}
    let s5 = concat {| a: s4, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_release" |} |} |} |}
    let s6 = concat {| a: s5, b: rrl |}
    {| code: concat {| a: s6, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_release" |} |} |} |}, var: f.name, state: ar.state |}
end

fn emit_unop_x86
  case {| node, state, mode |} =>
    let pfx = sym_prefix_x86 {| mode: mode |}
    let r = emit_expr_x86 {| node: node.operand, state: state, mode: mode |}
    let f = fresh_var {| prefix: "_t", counter: r.state.counter |}
    let st = {| counter: f.counter, slot_counter: r.state.slot_counter, slots: r.state.slots, strs: r.state.strs |}
    let ar = alloc_slot {| name: f.name, state: st |}
    let ss = lookup_slot {| name: r.var, slots: ar.state.slots |}
    let load = emit_load_slot_x86 {| slot: ss, reg: "%rdi" |}
    let store = emit_store_slot_x86 {| slot: ar.slot, reg: "%rax" |}
    let rload = emit_load_slot_x86 {| slot: ss, reg: "%rdi" |}
    let s1 = concat {| a: r.code, b: load |}
    let s8 = concat {| a: s1, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "checked_neg" |} |} |} |}
    let s9 = concat {| a: s8, b: store |}
    let s10 = concat {| a: s9, b: rload |}
    {| code: concat {| a: s10, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_release" |} |} |} |}, var: f.name, state: ar.state |}
end

fn emit_field_access_x86
  case {| node, state, mode |} =>
    let n = nl {| |}
    let pfx = sym_prefix_x86 {| mode: mode |}
    let r = emit_expr_x86 {| node: node.obj, state: state, mode: mode |}
    let f = fresh_var {| prefix: "_t", counter: r.state.counter |}
    let st1 = {| counter: f.counter, slot_counter: r.state.slot_counter, slots: r.state.slots, strs: r.state.strs |}
    let sr = add_str_asm {| s: node.field, state: st1 |}
    let ar = alloc_slot {| name: f.name, state: sr.state |}
    let os = lookup_slot {| name: r.var, slots: ar.state.slots |}
    let lo = emit_load_slot_x86 {| slot: os, reg: "%rdi" |}
    let store = emit_store_slot_x86 {| slot: ar.slot, reg: "%rax" |}
    let rl = emit_load_slot_x86 {| slot: ar.slot, reg: "%rdi" |}
    let ol = emit_load_slot_x86 {| slot: os, reg: "%rdi" |}
    let s1 = concat {| a: r.code, b: lo |}
    let s2 = concat {| a: s1, b: "  leaq " |}
    let s3 = concat {| a: s2, b: sr.label |}
    let s4 = concat {| a: s3, b: "(%rip), %rsi" |}
    let s5 = concat {| a: s4, b: n |}
    let s6 = concat {| a: s5, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "record_field" |} |} |} |}
    let s7 = concat {| a: s6, b: store |}
    let s8 = concat {| a: s7, b: rl |}
    let s9 = concat {| a: s8, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_retain" |} |} |} |}
    let s10 = concat {| a: s9, b: ol |}
    {| code: concat {| a: s10, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_release" |} |} |} |}, var: f.name, state: ar.state |}
end

-- Emit all record field value expressions (x86-64)
fn emit_record_vals_loop_x86
  case {| fields, state, code_acc, vars_acc, mode |} =>
    match is_nil {| list: fields |}
      case 1 => {| code: code_acc, vars: vars_acc, state: state |}
      case 0 =>
        let head = list_head {| list: fields |}
        let tail = list_tail {| list: fields |}
        let r = emit_expr_x86 {| node: head.value, state: state, mode: mode |}
        let entry = {| name: head.name, var: r.var |}
        let new_vars = cons {| head: entry, tail: vars_acc |}
        emit_record_vals_loop_x86 {| fields: tail, state: r.state, code_acc: concat {| a: code_acc, b: r.code |}, vars_acc: new_vars, mode: mode |}
    end
end

-- Set up name/value arrays on stack for record creation (x86-64)
fn emit_record_setup_loop_x86
  case {| entries, state, idx, num_fields |} =>
    match is_nil {| list: entries |}
      case 1 => {| code: "", state: state |}
      case 0 =>
        let n = nl {| |}
        let head = list_head {| list: entries |}
        let tail = list_tail {| list: entries |}
        let sr = add_str_asm {| s: head.name, state: state |}
        let names_off = int_to_str {| n: idx * 8 |}
        let vals_off = int_to_str {| n: num_fields * 8 + idx * 8 |}
        let n1 = concat {| a: "  leaq ", b: sr.label |}
        let n2 = concat {| a: n1, b: "(%rip), %r8" |}
        let n3 = concat {| a: n2, b: n |}
        let n4 = concat {| a: n3, b: "  movq %r8, " |}
        let n5 = concat {| a: n4, b: names_off |}
        let n6 = asm_ln {| s: concat {| a: n5, b: "(%rsp)" |} |}
        let vs = lookup_slot {| name: head.var, slots: sr.state.slots |}
        let vl = emit_load_slot_x86 {| slot: vs, reg: "%r9" |}
        let v1 = concat {| a: vl, b: "  movq %r9, " |}
        let v2 = concat {| a: v1, b: vals_off |}
        let v3 = asm_ln {| s: concat {| a: v2, b: "(%rsp)" |} |}
        let rest = emit_record_setup_loop_x86 {| entries: tail, state: sr.state, idx: idx + 1, num_fields: num_fields |}
        let s1 = concat {| a: n6, b: v3 |}
        {| code: concat {| a: s1, b: rest.code |}, state: rest.state |}
    end
end

fn emit_record_x86
  case {| node, state, mode |} =>
    let n = nl {| |}
    let pfx = sym_prefix_x86 {| mode: mode |}
    let nf = list_len {| list: node.fields |}
    let empty = nil {| |}
    let vr = emit_record_vals_loop_x86 {| fields: node.fields, state: state, code_acc: "", vars_acc: empty, mode: mode |}
    let entries = list_reverse {| list: vr.vars |}
    let total = ((nf * 16 + 15) / 16) * 16
    let sr = emit_record_setup_loop_x86 {| entries: entries, state: vr.state, idx: 0, num_fields: nf |}
    let f = fresh_var {| prefix: "_t", counter: sr.state.counter |}
    let st1 = {| counter: f.counter, slot_counter: sr.state.slot_counter, slots: sr.state.slots, strs: sr.state.strs |}
    let ar = alloc_slot {| name: f.name, state: st1 |}
    let store = emit_store_slot_x86 {| slot: ar.slot, reg: "%rax" |}
    let ns_s = int_to_str {| n: nf * 8 |}
    let tot_s = int_to_str {| n: total |}
    let sub_sp = match total == 0
      case 1 => ""
      case 0 => asm_ln {| s: concat {| a: "  subq $", b: concat {| a: tot_s, b: ", %rsp" |} |} |}
    end
    let add_sp = match total == 0
      case 1 => ""
      case 0 => asm_ln {| s: concat {| a: "  addq $", b: concat {| a: tot_s, b: ", %rsp" |} |} |}
    end
    let s1 = concat {| a: vr.code, b: sub_sp |}
    let s2 = concat {| a: s1, b: sr.code |}
    let s3 = concat {| a: s2, b: emit_mov_imm_x86 {| reg: "%rdi", n: nf |} |}
    let s4 = concat {| a: s3, b: "  movq %rsp, %rsi" |}
    let s5 = concat {| a: s4, b: n |}
    let s6 = concat {| a: s5, b: "  leaq " |}
    let s7 = concat {| a: s6, b: ns_s |}
    let s8 = concat {| a: s7, b: "(%rsp), %rdx" |}
    let s9 = concat {| a: s8, b: n |}
    let s10 = concat {| a: s9, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "make_record_with_fields" |} |} |} |}
    let s11 = concat {| a: s10, b: add_sp |}
    {| code: concat {| a: s11, b: store |}, var: f.name, state: ar.state |}
end

fn emit_call_x86
  case {| node, state, mode |} =>
    let n = nl {| |}
    let pfx = sym_prefix_x86 {| mode: mode |}
    let r = emit_expr_x86 {| node: node.arg, state: state, mode: mode |}
    let f = fresh_var {| prefix: "_t", counter: r.state.counter |}
    let st = {| counter: f.counter, slot_counter: r.state.slot_counter, slots: r.state.slots, strs: r.state.strs |}
    let ar = alloc_slot {| name: f.name, state: st |}
    let as2 = lookup_slot {| name: r.var, slots: ar.state.slots |}
    let la = emit_load_slot_x86 {| slot: as2, reg: "%rdi" |}
    let store = emit_store_slot_x86 {| slot: ar.slot, reg: "%rax" |}
    let rla = emit_load_slot_x86 {| slot: as2, reg: "%rdi" |}
    let s1 = concat {| a: r.code, b: la |}
    let s2 = concat {| a: s1, b: "  callq " |}
    let s3 = concat {| a: s2, b: pfx |}
    let s4 = concat {| a: s3, b: "fn_" |}
    let s5 = concat {| a: s4, b: node.name |}
    let s6 = concat {| a: s5, b: n |}
    let s7 = concat {| a: s6, b: store |}
    let s8 = concat {| a: s7, b: rla |}
    {| code: concat {| a: s8, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_release" |} |} |} |}, var: f.name, state: ar.state |}
end

fn emit_readln_x86
  case {| state, mode |} =>
    let pfx = sym_prefix_x86 {| mode: mode |}
    let f = fresh_var {| prefix: "_t", counter: state.counter |}
    let st = {| counter: f.counter, slot_counter: state.slot_counter, slots: state.slots, strs: state.strs |}
    let ar = alloc_slot {| name: f.name, state: st |}
    let store = emit_store_slot_x86 {| slot: ar.slot, reg: "%rax" |}
    {| code: concat {| a: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "runtime_readln" |} |} |}, b: store |}, var: f.name, state: ar.state |}
end

fn emit_readint_x86
  case {| state, mode |} =>
    let pfx = sym_prefix_x86 {| mode: mode |}
    let f = fresh_var {| prefix: "_t", counter: state.counter |}
    let st = {| counter: f.counter, slot_counter: state.slot_counter, slots: state.slots, strs: state.strs |}
    let ar = alloc_slot {| name: f.name, state: st |}
    let store = emit_store_slot_x86 {| slot: ar.slot, reg: "%rax" |}
    {| code: concat {| a: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "runtime_readint" |} |} |}, b: store |}, var: f.name, state: ar.state |}
end

fn emit_let_bindings_loop_x86
  case {| bindings, state, code_acc, names_acc, mode |} =>
    match is_nil {| list: bindings |}
      case 1 => {| code: code_acc, state: state, names: names_acc |}
      case 0 =>
        let head = list_head {| list: bindings |}
        let tail = list_tail {| list: bindings |}
        let rv = emit_expr_x86 {| node: head.value, state: state, mode: mode |}
        let vs = lookup_slot {| name: rv.var, slots: rv.state.slots |}
        let cn = c_name {| name: head.name |}
        let already = list_contains_str {| list: names_acc, s: head.name |}
        -- If variable already bound, release old value before reassigning
        let release_old = match already
          case 1 =>
            let old_slot = lookup_slot {| name: cn, slots: rv.state.slots |}
            let pfx = sym_prefix_x86 {| mode: mode |}
            let load_old = emit_load_slot_x86 {| slot: old_slot, reg: "%rdi" |}
            concat {| a: load_old, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_release" |} |} |} |}
          case 0 => ""
        end
        let new_slots = cons {| head: {| name: cn, slot: vs |}, tail: rv.state.slots |}
        let ns = {| counter: rv.state.counter, slot_counter: rv.state.slot_counter, slots: new_slots, strs: rv.state.strs |}
        let new_names = match already
          case 1 => names_acc
          case 0 => cons {| head: head.name, tail: names_acc |}
        end
        let new_code = cat3 {| a: code_acc, b: rv.code, c: release_old |}
        emit_let_bindings_loop_x86 {| bindings: tail, state: ns, code_acc: new_code, names_acc: new_names, mode: mode |}
    end
end

fn emit_let_in_x86
  case {| node, state, mode |} =>
    let chain = collect_let_chain {| node: node |}
    let empty = nil {| |}
    let br = emit_let_bindings_loop_x86 {| bindings: chain.bindings, state: state, code_acc: "", names_acc: empty, mode: mode |}
    let rb = emit_expr_x86 {| node: chain.body, state: br.state, mode: mode |}
    let release = gen_release_code_x86 {| names: br.names, slots: rb.state.slots, mode: mode |}
    let s1 = concat {| a: br.code, b: rb.code |}
    {| code: concat {| a: s1, b: release |}, var: rb.var, state: rb.state |}
end

-- ============================================================
-- x86-64: Pattern Matching
-- ============================================================

fn emit_rec_field_match_x86
  case {| var_slot, field, fail_label, state, mode |} =>
    let n = nl {| |}
    let pfx = sym_prefix_x86 {| mode: mode |}
    let sr = add_str_asm {| s: field.name, state: state |}
    let tmp = concat {| a: "_f_", b: field.name |}
    let ar = alloc_slot {| name: tmp, state: sr.state |}
    let lr = emit_load_slot_x86 {| slot: var_slot, reg: "%rdi" |}
    let st = emit_store_slot_x86 {| slot: ar.slot, reg: "%rax" |}
    let s1 = concat {| a: lr, b: "  leaq " |}
    let s2 = concat {| a: s1, b: sr.label |}
    let s3 = concat {| a: s2, b: "(%rip), %rsi" |}
    let s4 = concat {| a: s3, b: n |}
    let s5 = concat {| a: s4, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "record_field" |} |} |} |}
    let s6 = concat {| a: s5, b: st |}
    let s7 = concat {| a: s6, b: "  testq %rax, %rax" |}
    let s8 = concat {| a: s7, b: n |}
    let s9 = concat {| a: s8, b: "  je " |}
    let s10 = concat {| a: s9, b: fail_label |}
    let base = concat {| a: s10, b: n |}
    let bind_name = field_binding_name {| field: field |}
    let cn = c_name {| name: bind_name |}
    match field.pat.tag
      case "pat_none" =>
        let ns = cons {| head: {| name: cn, slot: ar.slot |}, tail: ar.state.slots |}
        {| code: base, state: {| counter: ar.state.counter, slot_counter: ar.state.slot_counter, slots: ns, strs: ar.state.strs |} |}
      case "pat_var" =>
        let ns = cons {| head: {| name: cn, slot: ar.slot |}, tail: ar.state.slots |}
        {| code: base, state: {| counter: ar.state.counter, slot_counter: ar.state.slot_counter, slots: ns, strs: ar.state.strs |} |}
      case "pat_wild" =>
        {| code: base, state: ar.state |}
      case _ =>
        let ns = cons {| head: {| name: cn, slot: ar.slot |}, tail: ar.state.slots |}
        let nst = {| counter: ar.state.counter, slot_counter: ar.state.slot_counter, slots: ns, strs: ar.state.strs |}
        let pm = emit_pat_match_x86 {| var_slot: ar.slot, pat: field.pat, fail_label: fail_label, state: nst, mode: mode |}
        {| code: concat {| a: base, b: pm.code |}, state: pm.state |}
    end
end

fn emit_rec_pat_loop_x86
  case {| var_slot, fields, fail_label, state, code_acc, mode |} =>
    match is_nil {| list: fields |}
      case 1 => {| code: code_acc, state: state |}
      case 0 =>
        let head = list_head {| list: fields |}
        let tail = list_tail {| list: fields |}
        let r = emit_rec_field_match_x86 {| var_slot: var_slot, field: head, fail_label: fail_label, state: state, mode: mode |}
        emit_rec_pat_loop_x86 {| var_slot: var_slot, fields: tail, fail_label: fail_label, state: r.state, code_acc: concat {| a: code_acc, b: r.code |}, mode: mode |}
    end
end

fn emit_pat_match_x86
  case {| var_slot, pat, fail_label, state, mode |} =>
    let n = nl {| |}
    let pfx = sym_prefix_x86 {| mode: mode |}
    match pat.tag
      case "pat_wild" => {| code: "", state: state |}
      case "pat_var" =>
        let cn = c_name {| name: pat.name |}
        let ar = alloc_slot {| name: cn, state: state |}
        let load = emit_load_slot_x86 {| slot: var_slot, reg: "%r8" |}
        let store = emit_store_slot_x86 {| slot: ar.slot, reg: "%r8" |}
        {| code: concat {| a: load, b: store |}, state: ar.state |}
      case "pat_int" =>
        let val = str_to_int {| s: pat.value |}
        let load = emit_load_slot_x86 {| slot: var_slot, reg: "%r8" |}
        let s1 = concat {| a: load, b: "  movl (%r8), %r9d" |}
        let s2 = concat {| a: s1, b: n |}
        let s3 = concat {| a: s2, b: "  cmpl $0, %r9d" |}
        let s4 = concat {| a: s3, b: n |}
        let s5 = concat {| a: s4, b: "  jne " |}
        let s6 = concat {| a: s5, b: fail_label |}
        let s7 = concat {| a: s6, b: n |}
        let s8 = concat {| a: s7, b: "  movq 8(%r8), %r8" |}
        let s9 = concat {| a: s8, b: n |}
        let mov = emit_mov_imm_x86 {| reg: "%r9", n: val |}
        let s10 = concat {| a: s9, b: mov |}
        let s11 = concat {| a: s10, b: "  cmpq %r9, %r8" |}
        let s12 = concat {| a: s11, b: n |}
        let s13 = concat {| a: s12, b: "  jne " |}
        let s14 = concat {| a: s13, b: fail_label |}
        {| code: concat {| a: s14, b: n |}, state: state |}
      case "pat_str" =>
        let sr = add_str_asm {| s: pat.value, state: state |}
        let load = emit_load_slot_x86 {| slot: var_slot, reg: "%r8" |}
        let s1 = concat {| a: load, b: "  movl (%r8), %r9d" |}
        let s2 = concat {| a: s1, b: n |}
        let s3 = concat {| a: s2, b: "  cmpl $1, %r9d" |}
        let s4 = concat {| a: s3, b: n |}
        let s5 = concat {| a: s4, b: "  jne " |}
        let s6 = concat {| a: s5, b: fail_label |}
        let s7 = concat {| a: s6, b: n |}
        let s8 = concat {| a: s7, b: "  movq 8(%r8), %rdi" |}
        let s9 = concat {| a: s8, b: n |}
        let s10 = concat {| a: s9, b: "  leaq " |}
        let s11 = concat {| a: s10, b: sr.label |}
        let s12 = concat {| a: s11, b: "(%rip), %rsi" |}
        let s13 = concat {| a: s12, b: n |}
        let s14 = concat {| a: s13, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "strcmp" |} |} |} |}
        let s15 = concat {| a: s14, b: "  testl %eax, %eax" |}
        let s16 = concat {| a: s15, b: n |}
        let s17 = concat {| a: s16, b: "  jne " |}
        let s18 = concat {| a: s17, b: fail_label |}
        {| code: concat {| a: s18, b: n |}, state: sr.state |}
      case "pat_rec" =>
        let load = emit_load_slot_x86 {| slot: var_slot, reg: "%r8" |}
        let s1 = concat {| a: load, b: "  movl (%r8), %r9d" |}
        let s2 = concat {| a: s1, b: n |}
        let s3 = concat {| a: s2, b: "  cmpl $2, %r9d" |}
        let s4 = concat {| a: s3, b: n |}
        let s5 = concat {| a: s4, b: "  jne " |}
        let s6 = concat {| a: s5, b: fail_label |}
        let s7 = concat {| a: s6, b: n |}
        emit_rec_pat_loop_x86 {| var_slot: var_slot, fields: pat.fields, fail_label: fail_label, state: state, code_acc: s7, mode: mode |}
    end
end

-- ============================================================
-- x86-64: Match Expression
-- ============================================================

fn emit_match_clause_x86
  case {| scr_slot, dvn_slot, done_label, clause, state, mode |} =>
    let n = nl {| |}
    let fl = fresh_var {| prefix: "Ldvnf", counter: state.counter |}
    let st1 = {| counter: fl.counter, slot_counter: state.slot_counter, slots: state.slots, strs: state.strs |}
    let saved_slots = st1.slots
    let saved_sc = st1.slot_counter
    let pm = emit_pat_match_x86 {| var_slot: scr_slot, pat: clause.pat, fail_label: fl.name, state: st1, mode: mode |}
    let bound = extract_bound_names {| pat: clause.pat |}
    let retain = gen_retain_code_x86 {| names: bound, slots: pm.state.slots, mode: mode |}
    let rb = emit_expr_x86 {| node: clause.body, state: pm.state, mode: mode |}
    let release = gen_release_code_x86 {| names: bound, slots: rb.state.slots, mode: mode |}
    let bs = lookup_slot {| name: rb.var, slots: rb.state.slots |}
    let lb = emit_load_slot_x86 {| slot: bs, reg: "%r8" |}
    let sd = emit_store_slot_x86 {| slot: dvn_slot, reg: "%r8" |}
    let s1 = concat {| a: pm.code, b: retain |}
    let s2 = concat {| a: s1, b: rb.code |}
    let s3 = concat {| a: s2, b: release |}
    let s4 = concat {| a: s3, b: lb |}
    let s5 = concat {| a: s4, b: sd |}
    let s6 = concat {| a: s5, b: "  jmp " |}
    let s7 = concat {| a: s6, b: done_label |}
    let s8 = concat {| a: s7, b: n |}
    let s9 = concat {| a: s8, b: fl.name |}
    let s10 = concat {| a: s9, b: ":" |}
    let code = concat {| a: s10, b: n |}
    let high_sc = match rb.state.slot_counter > saved_sc
      case 1 => rb.state.slot_counter
      case 0 => saved_sc
    end
    {| code: code, state: {| counter: rb.state.counter, slot_counter: high_sc, slots: saved_slots, strs: rb.state.strs |} |}
end

fn emit_match_clauses_loop_x86
  case {| scr_slot, dvn_slot, done_label, clauses, state, acc, mode |} =>
    match is_nil {| list: clauses |}
      case 1 => {| code: acc, state: state |}
      case 0 =>
        let head = list_head {| list: clauses |}
        let tail = list_tail {| list: clauses |}
        let r = emit_match_clause_x86 {| scr_slot: scr_slot, dvn_slot: dvn_slot, done_label: done_label, clause: head, state: state, mode: mode |}
        emit_match_clauses_loop_x86 {| scr_slot: scr_slot, dvn_slot: dvn_slot, done_label: done_label, clauses: tail, state: r.state, acc: concat {| a: acc, b: r.code |}, mode: mode |}
    end
end

fn emit_match_x86
  case {| node, state, mode |} =>
    let n = nl {| |}
    let pfx = sym_prefix_x86 {| mode: mode |}
    let rs = emit_expr_x86 {| node: node.scrutinee, state: state, mode: mode |}
    let scr = fresh_var {| prefix: "_scr", counter: rs.state.counter |}
    let st1 = {| counter: scr.counter, slot_counter: rs.state.slot_counter, slots: rs.state.slots, strs: rs.state.strs |}
    let scr_r = alloc_slot {| name: scr.name, state: st1 |}
    let src_s = lookup_slot {| name: rs.var, slots: scr_r.state.slots |}
    let ls = emit_load_slot_x86 {| slot: src_s, reg: "%r8" |}
    let ss = emit_store_slot_x86 {| slot: scr_r.slot, reg: "%r8" |}
    let dvn = fresh_var {| prefix: "_dvn", counter: scr_r.state.counter |}
    let st2 = {| counter: dvn.counter, slot_counter: scr_r.state.slot_counter, slots: scr_r.state.slots, strs: scr_r.state.strs |}
    let dvn_r = alloc_slot {| name: dvn.name, state: st2 |}
    let done = fresh_var {| prefix: "Ldone", counter: dvn_r.state.counter |}
    let st3 = {| counter: done.counter, slot_counter: dvn_r.state.slot_counter, slots: dvn_r.state.slots, strs: dvn_r.state.strs |}
    let cr = emit_match_clauses_loop_x86 {| scr_slot: scr_r.slot, dvn_slot: dvn_r.slot, done_label: done.name, clauses: node.clauses, state: st3, acc: "", mode: mode |}
    let mf_sr = add_str_asm {| s: "match", state: cr.state |}
    let mf1 = concat {| a: "  leaq ", b: mf_sr.label |}
    let mf2 = concat {| a: mf1, b: "(%rip), %rdi" |}
    let mf3 = concat {| a: mf2, b: n |}
    let mf4 = concat {| a: mf3, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "stele_match_fail" |} |} |} |}
    let rl = emit_load_slot_x86 {| slot: scr_r.slot, reg: "%rdi" |}
    let s1 = concat {| a: rs.code, b: ls |}
    let s2 = concat {| a: s1, b: ss |}
    let s3 = concat {| a: s2, b: cr.code |}
    let s4 = concat {| a: s3, b: mf4 |}
    let s5 = concat {| a: s4, b: done.name |}
    let s6 = concat {| a: s5, b: ":" |}
    let s7 = concat {| a: s6, b: n |}
    let s8 = concat {| a: s7, b: rl |}
    let code = concat {| a: s8, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_release" |} |} |} |}
    {| code: code, var: dvn.name, state: mf_sr.state |}
end

fn emit_retain_captures_x86
  case {| fields, state, mode |} =>
    match is_nil {| list: fields |}
      case 1 => {| code: "", state: state |}
      case 0 =>
        let head = list_head {| list: fields |}
        let tail = list_tail {| list: fields |}
        let pfx = sym_prefix_x86 {| mode: mode |}
        let cn = c_name {| name: head.name |}
        let src_slot = lookup_slot {| name: cn, slots: state.slots |}
        let load = emit_load_slot_x86 {| slot: src_slot, reg: "%rdi" |}
        let bl = asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_retain" |} |} |}
        let code = concat {| a: load, b: bl |}
        let rest = emit_retain_captures_x86 {| fields: tail, state: state, mode: mode |}
        {| code: concat {| a: code, b: rest.code |}, state: rest.state |}
    end
end

fn emit_closure_env_fields_x86
  case {| fields, state, entries |} =>
    match is_nil {| list: fields |}
      case 1 => {| code: "", entries: entries, state: state |}
      case 0 =>
        let head = list_head {| list: fields |}
        let tail = list_tail {| list: fields |}
        let cn = c_name {| name: head.name |}
        let entry = {| name: head.name, var: cn |}
        let new_entries = cons {| head: entry, tail: entries |}
        emit_closure_env_fields_x86 {| fields: tail, state: state, entries: new_entries |}
    end
end

fn emit_closure_ref_x86
  case {| node, state, mode |} =>
    let n = nl {| |}
    let pfx = sym_prefix_x86 {| mode: mode |}
    let num_fvs = list_len {| list: node.free_vars |}
    match num_fvs == 0
      case 1 =>
        -- No captures: make_closure(fn_ptr, NULL)
        let f = fresh_var {| prefix: "_t", counter: state.counter |}
        let st1 = {| counter: f.counter, slot_counter: state.slot_counter, slots: state.slots, strs: state.strs |}
        let ar = alloc_slot {| name: f.name, state: st1 |}
        let store = emit_store_slot_x86 {| slot: ar.slot, reg: "%rax" |}
        let fn_name = concat {| a: pfx, b: concat {| a: "fn_", b: node.lambda_name |} |}
        let s1 = concat {| a: "  leaq ", b: fn_name |}
        let s2 = concat {| a: s1, b: "(%rip), %rdi" |}
        let s3 = concat {| a: s2, b: n |}
        let s4 = concat {| a: s3, b: asm_ln {| s: "  xorq %rsi, %rsi" |} |}
        let s5 = concat {| a: s4, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "make_closure" |} |} |} |}
        {| code: concat {| a: s5, b: store |}, var: f.name, state: ar.state |}
      case 0 =>
        -- Retain captured values so env record owns them
        let retain_code = emit_retain_captures_x86 {| fields: node.free_vars, state: state, mode: mode |}
        -- Build env record from free vars, then make_closure
        let er = emit_closure_env_fields_x86 {| fields: node.free_vars, state: retain_code.state, entries: nil {| |} |}
        let entries = list_reverse {| list: er.entries |}
        let nf = num_fvs
        let total = ((nf * 16 + 15) / 16) * 16
        let sr = emit_record_setup_loop_x86 {| entries: entries, state: er.state, idx: 0, num_fields: nf |}
        let ns_s = int_to_str {| n: nf * 8 |}
        let tot_s = int_to_str {| n: total |}
        let sub_sp = match total == 0
          case 1 => ""
          case 0 => asm_ln {| s: concat {| a: "  subq $", b: concat {| a: tot_s, b: ", %rsp" |} |} |}
        end
        let add_sp = match total == 0
          case 1 => ""
          case 0 => asm_ln {| s: concat {| a: "  addq $", b: concat {| a: tot_s, b: ", %rsp" |} |} |}
        end
        let s0 = concat {| a: retain_code.code, b: sub_sp |}
        let s1 = concat {| a: s0, b: sr.code |}
        let s2 = concat {| a: s1, b: emit_mov_imm_x86 {| reg: "%rdi", n: nf |} |}
        let s3 = concat {| a: s2, b: "  movq %rsp, %rsi" |}
        let s4 = concat {| a: s3, b: n |}
        let s5 = concat {| a: s4, b: "  leaq " |}
        let s6 = concat {| a: s5, b: ns_s |}
        let s7 = concat {| a: s6, b: "(%rsp), %rdx" |}
        let s8 = concat {| a: s7, b: n |}
        let s9 = concat {| a: s8, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "make_record_with_fields" |} |} |} |}
        let s10 = concat {| a: s9, b: add_sp |}
        -- %rax = env record; pass it directly as the second argument
        let s11 = concat {| a: s10, b: asm_ln {| s: "  movq %rax, %rsi" |} |}
        let fn_name = concat {| a: pfx, b: concat {| a: "fn_", b: node.lambda_name |} |}
        let s12 = concat {| a: s11, b: "  leaq " |}
        let s13 = concat {| a: s12, b: fn_name |}
        let s14 = concat {| a: s13, b: "(%rip), %rdi" |}
        let s15 = concat {| a: s14, b: n |}
        let s17 = concat {| a: s15, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "make_closure" |} |} |} |}
        let f = fresh_var {| prefix: "_t", counter: sr.state.counter |}
        let st1 = {| counter: f.counter, slot_counter: sr.state.slot_counter, slots: sr.state.slots, strs: sr.state.strs |}
        let ar = alloc_slot {| name: f.name, state: st1 |}
        let store = emit_store_slot_x86 {| slot: ar.slot, reg: "%rax" |}
        {| code: concat {| a: s17, b: store |}, var: f.name, state: ar.state |}
    end
end

fn emit_closure_call_x86
  case {| node, state, mode |} =>
    let pfx = sym_prefix_x86 {| mode: mode |}
    let r = emit_expr_x86 {| node: node.arg, state: state, mode: mode |}
    let f = fresh_var {| prefix: "_t", counter: r.state.counter |}
    let st = {| counter: f.counter, slot_counter: r.state.slot_counter, slots: r.state.slots, strs: r.state.strs |}
    let ar = alloc_slot {| name: f.name, state: st |}
    let cn = c_name {| name: node.closure_var |}
    let cs = lookup_slot {| name: cn, slots: ar.state.slots |}
    let cl = emit_load_slot_x86 {| slot: cs, reg: "%rdi" |}
    let as2 = lookup_slot {| name: r.var, slots: ar.state.slots |}
    let al = emit_load_slot_x86 {| slot: as2, reg: "%rsi" |}
    let store = emit_store_slot_x86 {| slot: ar.slot, reg: "%rax" |}
    let rla = emit_load_slot_x86 {| slot: as2, reg: "%rdi" |}
    let s1 = concat {| a: r.code, b: cl |}
    let s2 = concat {| a: s1, b: al |}
    let s3 = concat {| a: s2, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "stele_call_closure" |} |} |} |}
    let s4 = concat {| a: s3, b: store |}
    let s5 = concat {| a: s4, b: rla |}
    {| code: concat {| a: s5, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_release" |} |} |} |}, var: f.name, state: ar.state |}
end

-- Expression dispatcher (x86-64)
fn emit_expr_x86
  case {| node, state, mode |} =>
    match node.tag
      case "int_lit" => emit_int_lit_x86 {| node: node, state: state, mode: mode |}
      case "str_lit" => emit_str_lit_x86 {| node: node, state: state, mode: mode |}
      case "var" => emit_var_x86 {| node: node, state: state, mode: mode |}
      case "binop" => emit_binop_x86 {| node: node, state: state, mode: mode |}
      case "unop" => emit_unop_x86 {| node: node, state: state, mode: mode |}
      case "field_access" => emit_field_access_x86 {| node: node, state: state, mode: mode |}
      case "record" => emit_record_x86 {| node: node, state: state, mode: mode |}
      case "named_record" => emit_record_x86 {| node: {| tag: "record", fields: node.fields |}, state: state, mode: mode |}
      case "call" => emit_call_x86 {| node: node, state: state, mode: mode |}
      case "readln" => emit_readln_x86 {| state: state, mode: mode |}
      case "readint" => emit_readint_x86 {| state: state, mode: mode |}
      case "let_in" => emit_let_in_x86 {| node: node, state: state, mode: mode |}
      case "match" => emit_match_x86 {| node: node, state: state, mode: mode |}
      case "closure_ref" => emit_closure_ref_x86 {| node: node, state: state, mode: mode |}
      case "closure_call" => emit_closure_call_x86 {| node: node, state: state, mode: mode |}
    end
end

-- ============================================================
-- x86-64: Rite & Clause Emission
-- ============================================================

fn emit_clause_x86
  case {| clause, clause_id, func_prefix, state, mode |} =>
    let n = nl {| |}
    let cid = int_to_str {| n: clause_id |}
    let fl1 = concat {| a: func_prefix, b: "c" |}
    let fl2 = concat {| a: fl1, b: cid |}
    let fail_label = concat {| a: fl2, b: "f" |}
    let saved_slots = state.slots
    let saved_sc = state.slot_counter
    let arg_slot = lookup_slot {| name: "arg", slots: state.slots |}
    let pm = emit_pat_match_x86 {| var_slot: arg_slot, pat: clause.pat, fail_label: fail_label, state: state, mode: mode |}
    let bound = extract_bound_names {| pat: clause.pat |}
    let retain = gen_retain_code_x86 {| names: bound, slots: pm.state.slots, mode: mode |}
    let rb = emit_expr_x86 {| node: clause.body, state: pm.state, mode: mode |}
    let release = gen_release_code_x86 {| names: bound, slots: rb.state.slots, mode: mode |}
    let bs = lookup_slot {| name: rb.var, slots: rb.state.slots |}
    let lr = emit_load_slot_x86 {| slot: bs, reg: "%rax" |}
    let epi = emit_epilogue_x86 {| |}
    let s1 = concat {| a: pm.code, b: retain |}
    let s2 = concat {| a: s1, b: rb.code |}
    let s3 = concat {| a: s2, b: release |}
    let s4 = concat {| a: s3, b: lr |}
    let s5 = concat {| a: s4, b: epi |}
    let s6 = concat {| a: s5, b: fail_label |}
    let s7 = concat {| a: s6, b: ":" |}
    let code = concat {| a: s7, b: n |}
    let high_sc = match rb.state.slot_counter > saved_sc
      case 1 => rb.state.slot_counter
      case 0 => saved_sc
    end
    {| code: code, state: {| counter: rb.state.counter, slot_counter: high_sc, slots: saved_slots, strs: rb.state.strs |} |}
end

fn emit_clauses_loop_x86
  case {| clauses, clause_id, func_prefix, state, acc, mode |} =>
    match is_nil {| list: clauses |}
      case 1 => {| code: acc, state: state |}
      case 0 =>
        let head = list_head {| list: clauses |}
        let tail = list_tail {| list: clauses |}
        let r = emit_clause_x86 {| clause: head, clause_id: clause_id, func_prefix: func_prefix, state: state, mode: mode |}
        emit_clauses_loop_x86 {| clauses: tail, clause_id: clause_id + 1, func_prefix: func_prefix, state: r.state, acc: concat {| a: acc, b: r.code |}, mode: mode |}
    end
end

fn emit_fn_x86
  case {| name, clauses, closure, state, mode |} =>
    let n = nl {| |}
    let pfx = sym_prefix_x86 {| mode: mode |}
    let fp = concat {| a: "fn_", b: name |}
    let fp2 = concat {| a: fp, b: "_" |}
    let arg_s = cons {| head: {| name: "arg", slot: 0 |}, tail: nil {| |} |}
    let init_s = match closure
      case 1 => cons {| head: {| name: "stele_closure_env", slot: 1 |}, tail: arg_s |}
      case 0 => arg_s
    end
    let initial_slots = match closure
      case 1 => 2
      case 0 => 1
    end
    let fst = {| counter: state.counter, slot_counter: initial_slots, slots: init_s, strs: state.strs |}
    let store_arg = emit_store_slot_x86 {| slot: 0, reg: "%rdi" |}
    let store_env = match closure
      case 1 => emit_store_slot_x86 {| slot: 1, reg: "%rsi" |}
      case 0 => ""
    end
    let rc = emit_clauses_loop_x86 {| clauses: clauses, clause_id: 0, func_prefix: fp2, state: fst, acc: "", mode: mode |}
    let frame_size = ((rc.state.slot_counter * 8 + 15) / 16) * 16
    let pro = emit_prologue_x86 {| frame_size: frame_size |}
    let mf_msg = concat {| a: "fn '", b: name |}
    let mf_msg2 = concat {| a: mf_msg, b: "'" |}
    let mf_sr = add_str_asm {| s: mf_msg2, state: rc.state |}
    let mf1 = concat {| a: "  leaq ", b: mf_sr.label |}
    let mf2 = concat {| a: mf1, b: "(%rip), %rdi" |}
    let mf3 = concat {| a: mf2, b: n |}
    let mf4 = concat {| a: mf3, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "stele_match_fail" |} |} |} |}
    let l1 = concat {| a: ".globl ", b: pfx |}
    let l2 = concat {| a: l1, b: "fn_" |}
    let l3 = concat {| a: l2, b: name |}
    let l4 = concat {| a: l3, b: n |}
    let l5 = concat {| a: l4, b: pfx |}
    let l6 = concat {| a: l5, b: "fn_" |}
    let l7 = concat {| a: l6, b: name |}
    let l8 = concat {| a: l7, b: ":" |}
    let l9 = concat {| a: l8, b: n |}
    let s1 = concat {| a: l9, b: pro |}
    let s2 = concat {| a: s1, b: store_arg |}
    let s2b = concat {| a: s2, b: store_env |}
    let s3 = concat {| a: s2b, b: rc.code |}
    let s4 = concat {| a: s3, b: mf4 |}
    let code = concat {| a: s4, b: n |}
    {| code: code, state: {| counter: mf_sr.state.counter, slot_counter: state.slot_counter, slots: state.slots, strs: mf_sr.state.strs |} |}
end

-- ============================================================
-- x86-64: Statement & Main Emission
-- ============================================================

fn emit_stmt_x86
  case {| stmt, state, mode, declared |} =>
    let pfx = sym_prefix_x86 {| mode: mode |}
    match stmt
      case StmtLet {| name, value |} =>
        let r = emit_expr_x86 {| node: value, state: state, mode: mode |}
        let cn = c_name {| name: name |}
        let vs = lookup_slot {| name: r.var, slots: r.state.slots |}
        let already = list_contains_str {| list: declared, s: name |}
        -- If variable already declared, release old value before reassigning
        let release_old = match already
          case 1 =>
            let old_slot = lookup_slot {| name: cn, slots: r.state.slots |}
            let load_old = emit_load_slot_x86 {| slot: old_slot, reg: "%rdi" |}
            concat {| a: load_old, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_release" |} |} |} |}
          case 0 => ""
        end
        let ns = cons {| head: {| name: cn, slot: vs |}, tail: r.state.slots |}
        let new_declared = match already
          case 1 => declared
          case 0 => cons {| head: name, tail: declared |}
        end
        {| code: concat {| a: r.code, b: release_old |}, state: {| counter: r.state.counter, slot_counter: r.state.slot_counter, slots: ns, strs: r.state.strs |}, declared: new_declared |}
      case StmtPrint {| value |} =>
        let r = emit_expr_x86 {| node: value, state: state, mode: mode |}
        let vs = lookup_slot {| name: r.var, slots: r.state.slots |}
        let load = emit_load_slot_x86 {| slot: vs, reg: "%rdi" |}
        let rload = emit_load_slot_x86 {| slot: vs, reg: "%rdi" |}
        let s1 = concat {| a: r.code, b: load |}
        let s2 = concat {| a: s1, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "stele_print" |} |} |} |}
        let s3 = concat {| a: s2, b: rload |}
        {| code: concat {| a: s3, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_release" |} |} |} |}, state: r.state, declared: declared |}
      case StmtWrite {| value |} =>
        let r = emit_expr_x86 {| node: value, state: state, mode: mode |}
        let vs = lookup_slot {| name: r.var, slots: r.state.slots |}
        let load = emit_load_slot_x86 {| slot: vs, reg: "%rdi" |}
        let rload = emit_load_slot_x86 {| slot: vs, reg: "%rdi" |}
        let s1 = concat {| a: r.code, b: load |}
        let s2 = concat {| a: s1, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "stele_write" |} |} |} |}
        let s3 = concat {| a: s2, b: rload |}
        {| code: concat {| a: s3, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_release" |} |} |} |}, state: r.state, declared: declared |}
      case StmtExpr {| value |} =>
        let r = emit_expr_x86 {| node: value, state: state, mode: mode |}
        let vs = lookup_slot {| name: r.var, slots: r.state.slots |}
        let load = emit_load_slot_x86 {| slot: vs, reg: "%rdi" |}
        let s1 = concat {| a: r.code, b: load |}
        {| code: concat {| a: s1, b: asm_ln {| s: concat {| a: "  callq ", b: concat {| a: pfx, b: "rc_release" |} |} |} |}, state: r.state, declared: declared |}
    end
end

fn emit_stmts_loop_x86
  case {| stmts, state, acc, mode, declared |} =>
    match is_nil {| list: stmts |}
      case 1 => {| code: acc, state: state |}
      case 0 =>
        let head = list_head {| list: stmts |}
        let tail = list_tail {| list: stmts |}
        let r = emit_stmt_x86 {| stmt: head, state: state, mode: mode, declared: declared |}
        emit_stmts_loop_x86 {| stmts: tail, state: r.state, acc: concat {| a: acc, b: r.code |}, mode: mode, declared: r.declared |}
    end
end

fn emit_main_fn_x86
  case {| decls, state, mode |} =>
    let n = nl {| |}
    let pfx = sym_prefix_x86 {| mode: mode |}
    let rit = find_do {| decls: decls, name: "main" |}
    let ac1 = concat {| a: "  movq ", b: pfx |}
    let ac2 = concat {| a: ac1, b: "g_argc@GOTPCREL(%rip), %r8" |}
    let ac3 = concat {| a: ac2, b: n |}
    let argc_code = concat {| a: ac3, b: asm_ln {| s: "  movl %edi, (%r8)" |} |}
    let av1 = concat {| a: "  movq ", b: pfx |}
    let av2 = concat {| a: av1, b: "g_argv@GOTPCREL(%rip), %r8" |}
    let av3 = concat {| a: av2, b: n |}
    let argv_code = concat {| a: av3, b: asm_ln {| s: "  movq %rsi, (%r8)" |} |}
    let main_hdr = concat {| a: ".globl ", b: pfx |}
    let main_hdr2 = concat {| a: main_hdr, b: "main" |}
    let main_hdr3 = concat {| a: main_hdr2, b: n |}
    let main_hdr4 = concat {| a: main_hdr3, b: pfx |}
    let main_hdr5 = concat {| a: main_hdr4, b: "main:" |}
    let main_hdr6 = concat {| a: main_hdr5, b: n |}
    match rit.tag
      case "none" =>
        let pro = emit_prologue_x86 {| frame_size: 0 |}
        let s1 = concat {| a: main_hdr6, b: pro |}
        let s2 = concat {| a: s1, b: argc_code |}
        let s3 = concat {| a: s2, b: argv_code |}
        let s4 = concat {| a: s3, b: asm_ln {| s: "  xorl %eax, %eax" |} |}
        {| code: concat {| a: s4, b: emit_epilogue_x86 {| |} |}, state: state |}
      case "some" =>
        let init = nil {| |}
        let fst = {| counter: state.counter, slot_counter: 0, slots: init, strs: state.strs |}
        let rs = emit_stmts_loop_x86 {| stmts: rit.stmts, state: fst, acc: "", mode: mode, declared: nil {| |} |}
        let frame_size = ((rs.state.slot_counter * 8 + 15) / 16) * 16
        let pro = emit_prologue_x86 {| frame_size: frame_size |}
        let empty = nil {| |}
        let let_names = collect_let_names {| stmts: rit.stmts, acc: empty |}
        let rel = gen_release_code_x86 {| names: let_names, slots: rs.state.slots, mode: mode |}
        let s1 = concat {| a: main_hdr6, b: pro |}
        let s2 = concat {| a: s1, b: argc_code |}
        let s3 = concat {| a: s2, b: argv_code |}
        let s4 = concat {| a: s3, b: rs.code |}
        let s5 = concat {| a: s4, b: rel |}
        let s6 = concat {| a: s5, b: asm_ln {| s: "  xorl %eax, %eax" |} |}
        let code = concat {| a: s6, b: emit_epilogue_x86 {| |} |}
        {| code: code, state: {| counter: rs.state.counter, slot_counter: state.slot_counter, slots: state.slots, strs: rs.state.strs |} |}
    end
end

fn emit_test_body_x86
  case {| decl, state, mode |} =>
    let rs = emit_stmts_loop_x86 {| stmts: decl.stmts, state: state, acc: "", mode: mode, declared: nil {| |} |}
    let let_names = collect_let_names {| stmts: decl.stmts, acc: nil {| |} |}
    let rel = gen_release_code_x86 {| names: let_names, slots: rs.state.slots, mode: mode |}
    {| code: concat {| a: rs.code, b: rel |}, state: rs.state |}
end

fn emit_test_bodies_loop_x86
  case {| tests, state, acc, mode |} =>
    match is_nil {| list: tests |}
      case 1 => {| code: acc, state: state |}
      case 0 =>
        let head = list_head {| list: tests |}
        let tail = list_tail {| list: tests |}
        let r = emit_test_body_x86 {| decl: head, state: state, mode: mode |}
        emit_test_bodies_loop_x86 {| tests: tail, state: r.state, acc: concat {| a: acc, b: r.code |}, mode: mode |}
    end
end

fn emit_test_main_x86
  case {| decls, state, mode |} =>
    let tests = collect_tests {| decls: decls, acc: nil {| |} |}
    match is_nil {| list: tests |}
      case 1 => emit_main_fn_x86 {| decls: decls, state: state, mode: mode |}
      case 0 =>
        let n = nl {| |}
        let pfx = sym_prefix_x86 {| mode: mode |}
        let fst = {| counter: state.counter, slot_counter: 0, slots: nil {| |}, strs: state.strs |}
        let rs = emit_test_bodies_loop_x86 {| tests: tests, state: fst, acc: "", mode: mode |}
        let frame_size = ((rs.state.slot_counter * 8 + 15) / 16) * 16
        let pro = emit_prologue_x86 {| frame_size: frame_size |}
        let ac1 = concat {| a: "  movq ", b: pfx |}
        let ac2 = concat {| a: ac1, b: "g_argc@GOTPCREL(%rip), %r8" |}
        let argc_code = concat {| a: concat {| a: ac2, b: n |}, b: asm_ln {| s: "  movl %edi, (%r8)" |} |}
        let av1 = concat {| a: "  movq ", b: pfx |}
        let av2 = concat {| a: av1, b: "g_argv@GOTPCREL(%rip), %r8" |}
        let argv_code = concat {| a: concat {| a: av2, b: n |}, b: asm_ln {| s: "  movq %rsi, (%r8)" |} |}
        let h1 = concat {| a: ".globl ", b: pfx |}
        let h2 = concat {| a: h1, b: "main" |}
        let h3 = concat {| a: h2, b: n |}
        let h4 = concat {| a: h3, b: pfx |}
        let h5 = concat {| a: concat {| a: h4, b: "main:" |}, b: n |}
        let s1 = concat {| a: h5, b: pro |}
        let s2 = concat {| a: s1, b: argc_code |}
        let s3 = concat {| a: s2, b: argv_code |}
        let s4 = concat {| a: s3, b: rs.code |}
        let s5 = concat {| a: s4, b: asm_ln {| s: "  xorl %eax, %eax" |} |}
        let code = concat {| a: s5, b: emit_epilogue_x86 {| |} |}
        {| code: code, state: {| counter: rs.state.counter, slot_counter: state.slot_counter, slots: state.slots, strs: rs.state.strs |} |}
    end
end

-- ============================================================
-- x86-64: Top-Level Pipeline
-- ============================================================

fn emit_decls_loop_x86
  case {| decls, state, acc, mode |} =>
    match is_nil {| list: decls |}
      case 1 => {| code: acc, state: state |}
      case 0 =>
        let head = list_head {| list: decls |}
        let tail = list_tail {| list: decls |}
        let r = match head
          case DeclFn {| name, clauses, closure |} =>
            match is_builtin_fn {| name: name |}
              case 1 => {| code: "", state: state |}
              case 0 => emit_fn_x86 {| name: name, clauses: clauses, closure: closure, state: state, mode: mode |}
            end
          case _ => {| code: "", state: state |}
        end
        emit_decls_loop_x86 {| decls: tail, state: r.state, acc: concat {| a: acc, b: r.code |}, mode: mode |}
    end
end

fn emit_string_table_x86
  case {| strs, mode |} =>
    let n = nl {| |}
    let reversed = list_reverse {| list: strs |}
    let sect = cstring_section_x86 {| mode: mode |}
    let hdr = concat {| a: n, b: sect |}
    let hdr2 = concat {| a: hdr, b: n |}
    emit_string_table_loop {| strs: reversed, acc: hdr2 |}
end

-- Assemble the complete .s file (x86-64)
fn emit_x86
  case {| decls, mode |} =>
    let n = nl {| |}
    let empty = nil {| |}
    let init_state = {| counter: 0, slot_counter: 0, slots: empty, strs: empty |}
    let fn_defs = emit_decls_loop_x86 {| decls: decls, state: init_state, acc: "", mode: mode |}
    let main_fn = match is_test_mode {| |}
      case 1 => emit_test_main_x86 {| decls: decls, state: fn_defs.state, mode: mode |}
      case 0 => emit_main_fn_x86 {| decls: decls, state: fn_defs.state, mode: mode |}
    end
    let str_table = emit_string_table_x86 {| strs: main_fn.state.strs, mode: mode |}
    let sect = text_section_x86 {| mode: mode |}
    let hdr = concat {| a: sect, b: n |}
    let hdr2 = concat {| a: hdr, b: ".p2align 4" |}
    let hdr3 = concat {| a: hdr2, b: n |}
    let hdr4 = concat {| a: hdr3, b: n |}
    let s1 = concat {| a: hdr4, b: fn_defs.code |}
    let s2 = concat {| a: s1, b: main_fn.code |}
    let s3 = concat {| a: s2, b: str_table |}
    let gnu_stack = match str_eq {| a: mode, b: "x86-linux" |}
      case 1 =>
        let gs1 = concat {| a: n, b: ".section .note.GNU-stack," |}
        let gs2 = concat {| a: gs1, b: concat {| a: dq {| |}, b: dq {| |} |} |}
        concat {| a: gs2, b: concat {| a: ",@progbits", b: n |} |}
      case 0 => ""
    end
    concat {| a: s3, b: gnu_stack |}
end
