-- ============================================================
-- Main: Compiler Pipeline
-- ============================================================

open Lexer
open Parser
open Resolve
open Lambda_lift
open Codegen_c
open Codegen_aarch64
open Codegen_x86

do main
  let src = read {| path: argv {| n: 1 |} |}
  let tokens = tokenize {| src: src |}
  let parsed_decls = parse_program {| tokens: tokens |}
  let base_path = extract_base_path {| filepath: argv {| n: 1 |} |}
  let resolved_decls = resolve_modules {| decls: parsed_decls, base_path: base_path |}
  let decls = lift_lambdas {| decls: resolved_decls |}
  let mode = get_mode {| |}
  let output = match mode
    case 1 => emit_asm {| decls: decls |}
    case 4 => emit_asm {| decls: decls |}
    case 2 => emit_x86 {| decls: decls, mode: "x86" |}
    case 3 => emit_x86 {| decls: decls, mode: "x86-linux" |}
    case 0 => emit_c {| decls: decls |}
  end
  let out_path = argv {| n: 2 |}
  write {| path: out_path, content: output |}
end
