do main
  print "=== Stele IO demo ==="

  print "What is your name?"
  write "> "
  let name = readln
  write "Hello, "
  write name
  print "!"

  print "Pick a number:"
  write "> "
  let n = readint
  print "You chose:"
  print n

  print "Number of CLI args:"
  print argc {| |}

  print "Program name:"
  print argv {| n: 0 |}

  write {| path: "io_test.txt", content: "Written by Stele!" |}
  print "Wrote io_test.txt"

  let contents = read {| path: "io_test.txt" |}
  print "Read back:"
  print contents
end
