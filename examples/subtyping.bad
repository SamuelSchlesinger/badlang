-- Structural subtyping: fns accept any record with the required fields.
-- Extra fields are silently permitted (width subtyping).

struct Vec2
  x : Int
  y : Int
end

struct Vec3
  x : Int
  y : Int
  z : Int
end

-- This fn requires only {| x, y |} — any wider record works.
fn magnitude_sq
  case {| x, y |} => x * x + y * y
end

-- This fn requires {| x, y, z |} — a narrower contract.
fn magnitude_sq_3d
  case {| x, y, z |} => x * x + y * y + z * z
end

-- Pattern matching with literal fields
fn classify
  case {| x: 0, y: 0 |} => 0
  case {| x: 0 |}       => 1
  case {| y: 0 |}       => 2
  case {| x, y |}       => 3
end

do main
  let flat = Vec2 {| x: 3, y: 4 |}
  let deep = Vec3 {| x: 1, y: 2, z: 3 |}

  -- Width subtyping: Vec3 has x and y, so it works with magnitude_sq
  print magnitude_sq(flat)
  print magnitude_sq(deep)
  print magnitude_sq_3d(deep)

  -- Pattern dispatch
  print classify {| x: 0, y: 0 |}
  print classify {| x: 0, y: 5 |}
  print classify {| x: 7, y: 0 |}
  print classify {| x: 3, y: 4 |}

  -- Anonymous records work too — no struct needed
  print magnitude_sq {| x: 10, y: 10, extra: 999 |}
end
