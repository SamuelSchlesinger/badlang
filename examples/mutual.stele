-- Mutual recursion: Collatz conjecture meets the Hofstadter sequence
-- with structural records threading state between entangled fns.

-- Hofstadter's Female and Male sequences:
--   F(0) = 1, M(0) = 0
--   F(n) = n - M(F(n-1))
--   M(n) = n - F(M(n-1))

fn female
  case {| n: 0 |} => 1
  case {| n |} =>
    n - (male {|
      n: female {| n: n - 1 |}
    |})
end

fn male
  case {| n: 0 |} => 0
  case {| n |} =>
    n - (female {|
      n: male {| n: n - 1 |}
    |})
end

-- Collatz sequence: count steps to reach 1
-- Uses even/odd helper fns for dispatch

fn is_even
  case {| n |} =>
    let half = n / 2
    match half * 2 == n
      case 1 => 1
      case 0 => 0
    end
end

fn collatz_step
  case {| n |} =>
    match is_even {| n: n |}
      case 1 => n / 2
      case 0 => n * 3 + 1
    end
end

fn collatz_count
  case {| n: 1, steps |} => steps
  case {| n, steps |} =>
    collatz_count {|
      n: collatz_step {| n: n |},
      steps: steps + 1
    |}
end

-- Ackermann function: the classic recursion stress test
--   A(0, n) = n + 1
--   A(m, 0) = A(m-1, 1)
--   A(m, n) = A(m-1, A(m, n-1))

fn ackermann
  case {| m: 0, n |} => n + 1
  case {| m, n: 0 |} =>
    ackermann {| m: m - 1, n: 1 |}
  case {| m, n |} =>
    ackermann {|
      m: m - 1,
      n: ackermann {| m: m, n: n - 1 |}
    |}
end

-- GCD via the Euclidean algorithm with structural dispatch

fn gcd
  case {| a, b: 0 |} => a
  case {| a: 0, b |} => b
  case {| a, b |} =>
    match a > b
      case 1 => gcd {| a: a - b, b: b |}
      case 0 => gcd {| a: a, b: b - a |}
    end
end

-- Fibonacci with accumulator (tail-recursive style)

fn fib_acc
  case {| n: 0, a, b |} => a
  case {| n, a, b |} =>
    fib_acc {| n: n - 1, a: b, b: a + b |}
end

fn fib
  case {| n |} => fib_acc {| n: n, a: 0, b: 1 |}
end

do main
  -- Hofstadter sequences
  print female {| n: 10 |}
  print male {| n: 10 |}

  -- Collatz conjecture
  print collatz_count {| n: 27, steps: 0 |}
  print collatz_count {| n: 7, steps: 0 |}

  -- Ackermann (small values — this grows FAST)
  print ackermann {| m: 0, n: 5 |}
  print ackermann {| m: 1, n: 5 |}
  print ackermann {| m: 2, n: 4 |}
  print ackermann {| m: 3, n: 3 |}

  -- GCD
  print gcd {| a: 252, b: 105 |}
  print gcd {| a: 1071, b: 462 |}

  -- Fibonacci
  print fib {| n: 20 |}
  print fib {| n: 30 |}
end
