struct Point
  x : Int
  y : Int
end

fn square
  case {| n |} => n * n
end

fn distance
  case {| a : Point, b : Point |} =>
    let dx = a.x - b.x
    let dy = a.y - b.y
    (square {| n: dx |}) + (square {| n: dy |})
end

fn factorial
  case {| n: 0 |} => 1
  case {| n |} => n * (factorial {| n: n - 1 |})
end

do main
  let origin = Point {| x: 0, y: 0 |}
  let there = Point {| x: 3, y: 4 |}
  print distance {| a: origin, b: there |}
  print factorial {| n: 10 |}
end
