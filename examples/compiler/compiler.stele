-- Phase 1: Utility library for self-hosting compiler
-- Character classification, string helpers, linked lists, string builder

-- ============================================================
-- Character Classification
-- ============================================================

fn is_digit
  case {| c |} => (c >= 48) && (c <= 57)
end

fn is_alpha
  case {| c |} => ((c >= 65) && (c <= 90)) || ((c >= 97) && (c <= 122))
end

fn is_alnum
  case {| c |} => (is_digit {| c: c |}) || (is_alpha {| c: c |})
end

fn is_whitespace
  case {| c |} => (c == 32) || (c == 10) || (c == 13) || (c == 9)
end

fn is_underscore
  case {| c |} => c == 95
end

fn is_ident_char
  case {| c |} => (is_alnum {| c: c |}) || (is_underscore {| c: c |})
end

-- ============================================================
-- String Helpers
-- ============================================================

fn str_eq
  case {| a, b |} =>
    match strcmp {| a: a, b: b |}
      case 0 => 1
      case _ => 0
    end
end

fn starts_with
  case {| s, prefix |} =>
    let plen = strlen {| s: prefix |}
    let slen = strlen {| s: s |}
    match slen >= plen
      case 0 => 0
      case 1 =>
        let sub = substr {| s: s, start: 0, len: plen |}
        str_eq {| a: sub, b: prefix |}
    end
end

fn str_to_int_acc
  case {| s, pos, acc |} =>
    let slen = strlen {| s: s |}
    match pos >= slen
      case 1 => acc
      case 0 =>
        let ch = char_at {| s: s, n: pos |}
        let digit = ch - 48
        str_to_int_acc {| s: s, pos: pos + 1, acc: acc * 10 + digit |}
    end
end

fn str_to_int
  case {| s |} =>
    let slen = strlen {| s: s |}
    match slen == 0
      case 1 => 0
      case 0 =>
        let first = char_at {| s: s, n: 0 |}
        match first == 45
          case 1 =>
            let rest = substr {| s: s, start: 1, len: slen - 1 |}
            0 - (str_to_int_acc {| s: rest, pos: 0, acc: 0 |})
          case 0 =>
            str_to_int_acc {| s: s, pos: 0, acc: 0 |}
        end
    end
end

fn char_to_str
  case {| c |} => char_of_int {| n: c |}
end

-- ============================================================
-- List Operations
-- ============================================================

fn nil
  case {| |} => {| tag: "nil" |}
end

fn cons
  case {| head, tail |} => {| tag: "cons", head: head, tail: tail |}
end

fn is_nil
  case {| list |} =>
    match list
      case {| tag: "nil" |} => 1
      case {| tag: "cons" |} => 0
    end
end

fn list_head
  case {| list |} =>
    match list
      case {| tag: "cons", head |} => head
    end
end

fn list_tail
  case {| list |} =>
    match list
      case {| tag: "cons", tail |} => tail
    end
end

fn list_len_acc
  case {| list, acc |} =>
    match list
      case {| tag: "nil" |} => acc
      case {| tag: "cons", tail |} =>
        list_len_acc {| list: tail, acc: acc + 1 |}
    end
end

fn list_len
  case {| list |} => list_len_acc {| list: list, acc: 0 |}
end

fn list_reverse_acc
  case {| list, acc |} =>
    match list
      case {| tag: "nil" |} => acc
      case {| tag: "cons", head, tail |} =>
        let new_acc = cons {| head: head, tail: acc |}
        list_reverse_acc {| list: tail, acc: new_acc |}
    end
end

fn list_reverse
  case {| list |} =>
    let empty = nil {| |}
    list_reverse_acc {| list: list, acc: empty |}
end

fn list_nth
  case {| list, n |} =>
    match list
      case {| tag: "cons", head, tail |} =>
        match n == 0
          case 1 => head
          case 0 => list_nth {| list: tail, n: n - 1 |}
        end
    end
end

-- ============================================================
-- String Builder
-- ============================================================

fn sb_empty
  case {| |} => ""
end

fn sb_append
  case {| buf, s |} => concat {| a: buf, b: s |}
end

-- ============================================================
-- Lexer Helpers
-- ============================================================

fn make_tok
  case {| type, value |} => {| type: type, value: value |}
end

fn skip_ws
  case {| src, pos |} =>
    let slen = strlen {| s: src |}
    match pos >= slen
      case 1 => pos
      case 0 =>
        let ch = char_at {| s: src, n: pos |}
        match is_whitespace {| c: ch |}
          case 1 => skip_ws {| src: src, pos: pos + 1 |}
          case 0 => pos
        end
    end
end

fn skip_line
  case {| src, pos |} =>
    let slen = strlen {| s: src |}
    match pos >= slen
      case 1 => pos
      case 0 =>
        let ch = char_at {| s: src, n: pos |}
        match ch == 10
          case 1 => pos + 1
          case 0 => skip_line {| src: src, pos: pos + 1 |}
        end
    end
end

fn skip_ws_cmt
  case {| src, pos |} =>
    let p1 = skip_ws {| src: src, pos: pos |}
    let slen = strlen {| s: src |}
    match (p1 + 1) < slen
      case 1 =>
        let c1 = char_at {| s: src, n: p1 |}
        let c2 = char_at {| s: src, n: p1 + 1 |}
        match (c1 == 45) && (c2 == 45)
          case 1 =>
            let p2 = skip_line {| src: src, pos: p1 + 2 |}
            skip_ws_cmt {| src: src, pos: p2 |}
          case 0 => p1
        end
      case 0 => p1
    end
end

fn find_digit_end
  case {| src, pos |} =>
    let slen = strlen {| s: src |}
    match pos >= slen
      case 1 => pos
      case 0 =>
        let ch = char_at {| s: src, n: pos |}
        match is_digit {| c: ch |}
          case 1 => find_digit_end {| src: src, pos: pos + 1 |}
          case 0 => pos
        end
    end
end

fn find_word_end
  case {| src, pos |} =>
    let slen = strlen {| s: src |}
    match pos >= slen
      case 1 => pos
      case 0 =>
        let ch = char_at {| s: src, n: pos |}
        match is_ident_char {| c: ch |}
          case 1 => find_word_end {| src: src, pos: pos + 1 |}
          case 0 => pos
        end
    end
end

fn find_str_end
  case {| src, pos |} =>
    let slen = strlen {| s: src |}
    match pos >= slen
      case 1 => pos
      case 0 =>
        let ch = char_at {| s: src, n: pos |}
        match ch == 34
          case 1 => pos
          case 0 =>
            match ch == 92
              case 1 => find_str_end {| src: src, pos: pos + 2 |}
              case 0 => find_str_end {| src: src, pos: pos + 1 |}
            end
        end
    end
end

fn process_escapes
  case {| s, pos, acc |} =>
    let slen = strlen {| s: s |}
    match pos >= slen
      case 1 => acc
      case 0 =>
        let ch = char_at {| s: s, n: pos |}
        match ch == 92
          case 1 =>
            let next = char_at {| s: s, n: pos + 1 |}
            let esc = match next
              case 110 => char_of_int {| n: 10 |}
              case 116 => char_of_int {| n: 9 |}
              case 114 => char_of_int {| n: 13 |}
              case 92 => char_of_int {| n: 92 |}
              case 34 => char_of_int {| n: 34 |}
              case _ => char_of_int {| n: next |}
            end
            process_escapes {| s: s, pos: pos + 2, acc: concat {| a: acc, b: esc |} |}
          case 0 =>
            process_escapes {| s: s, pos: pos + 1, acc: concat {| a: acc, b: char_of_int {| n: ch |} |} |}
        end
    end
end

fn is_keyword
  case {| word |} =>
    (str_eq {| a: word, b: "struct" |}) ||
    (str_eq {| a: word, b: "fn" |}) ||
    (str_eq {| a: word, b: "do" |}) ||
    (str_eq {| a: word, b: "case" |}) ||
    (str_eq {| a: word, b: "end" |}) ||
    (str_eq {| a: word, b: "let" |}) ||
    (str_eq {| a: word, b: "in" |}) ||
    (str_eq {| a: word, b: "print" |}) ||
    (str_eq {| a: word, b: "write" |}) ||
    (str_eq {| a: word, b: "match" |}) ||
    (str_eq {| a: word, b: "readln" |}) ||
    (str_eq {| a: word, b: "readint" |})
end

fn peek_char
  case {| src, pos |} =>
    let slen = strlen {| s: src |}
    match (pos + 1) < slen
      case 1 => char_at {| s: src, n: pos + 1 |}
      case 0 => 0 - 1
    end
end

-- ============================================================
-- Lexer Core
-- ============================================================

fn lex_number
  case {| src, pos |} =>
    let end_pos = find_digit_end {| src: src, pos: pos |}
    let value = substr {| s: src, start: pos, len: end_pos - pos |}
    {| type: "int", value: value, pos: end_pos |}
end

fn lex_string
  case {| src, pos |} =>
    let end_pos = find_str_end {| src: src, pos: pos + 1 |}
    let raw = substr {| s: src, start: pos + 1, len: end_pos - pos - 1 |}
    let value = process_escapes {| s: raw, pos: 0, acc: "" |}
    {| type: "str", value: value, pos: end_pos + 1 |}
end

fn lex_word
  case {| src, pos |} =>
    let end_pos = find_word_end {| src: src, pos: pos |}
    let word = substr {| s: src, start: pos, len: end_pos - pos |}
    match str_eq {| a: word, b: "_" |}
      case 1 => {| type: "_", value: "_", pos: end_pos |}
      case 0 =>
        match is_keyword {| word: word |}
          case 1 => {| type: word, value: word, pos: end_pos |}
          case 0 => {| type: "ident", value: word, pos: end_pos |}
        end
    end
end

fn lex_punct
  case {| src, pos, ch |} =>
    let next_ch = peek_char {| src: src, pos: pos |}
    match ch
      case 123 => {| type: "{|", value: "{|", pos: pos + 2 |}
      case 124 =>
        match next_ch
          case 125 => {| type: "|}", value: "|}", pos: pos + 2 |}
          case 124 => {| type: "||", value: "||", pos: pos + 2 |}
        end
      case 61 =>
        match next_ch
          case 61 => {| type: "==", value: "==", pos: pos + 2 |}
          case 62 => {| type: "=>", value: "=>", pos: pos + 2 |}
          case _ => {| type: "=", value: "=", pos: pos + 1 |}
        end
      case 33 => {| type: "!=", value: "!=", pos: pos + 2 |}
      case 60 =>
        match next_ch
          case 61 => {| type: "<=", value: "<=", pos: pos + 2 |}
          case _ => {| type: "<", value: "<", pos: pos + 1 |}
        end
      case 62 =>
        match next_ch
          case 61 => {| type: ">=", value: ">=", pos: pos + 2 |}
          case _ => {| type: ">", value: ">", pos: pos + 1 |}
        end
      case 38 => {| type: "&&", value: "&&", pos: pos + 2 |}
      case 45 => {| type: "-", value: "-", pos: pos + 1 |}
      case 43 => {| type: "+", value: "+", pos: pos + 1 |}
      case 42 => {| type: "*", value: "*", pos: pos + 1 |}
      case 47 => {| type: "/", value: "/", pos: pos + 1 |}
      case 37 => {| type: "%", value: "%", pos: pos + 1 |}
      case 40 => {| type: "(", value: "(", pos: pos + 1 |}
      case 41 => {| type: ")", value: ")", pos: pos + 1 |}
      case 46 => {| type: ".", value: ".", pos: pos + 1 |}
      case 44 => {| type: ",", value: ",", pos: pos + 1 |}
      case 58 => {| type: ":", value: ":", pos: pos + 1 |}
    end
end

fn lex_next
  case {| src, pos |} =>
    let slen = strlen {| s: src |}
    match pos >= slen
      case 1 => {| type: "eof", value: "", pos: pos |}
      case 0 =>
        let ch = char_at {| s: src, n: pos |}
        match is_digit {| c: ch |}
          case 1 => lex_number {| src: src, pos: pos |}
          case 0 =>
            match (is_alpha {| c: ch |}) || (is_underscore {| c: ch |})
              case 1 => lex_word {| src: src, pos: pos |}
              case 0 =>
                match ch == 34
                  case 1 => lex_string {| src: src, pos: pos |}
                  case 0 => lex_punct {| src: src, pos: pos, ch: ch |}
                end
            end
        end
    end
end

-- ============================================================
-- Lexer Driver
-- ============================================================

fn tokenize_loop
  case {| src, pos, acc |} =>
    let p = skip_ws_cmt {| src: src, pos: pos |}
    let tok_result = lex_next {| src: src, pos: p |}
    match str_eq {| a: tok_result.type, b: "eof" |}
      case 1 =>
        let eof_tok = make_tok {| type: "eof", value: "" |}
        let final_list = cons {| head: eof_tok, tail: acc |}
        list_reverse {| list: final_list |}
      case 0 =>
        let tok = make_tok {| type: tok_result.type, value: tok_result.value |}
        let new_acc = cons {| head: tok, tail: acc |}
        tokenize_loop {| src: src, pos: tok_result.pos, acc: new_acc |}
    end
end

fn tokenize
  case {| src |} =>
    let empty = nil {| |}
    tokenize_loop {| src: src, pos: 0, acc: empty |}
end

-- ============================================================
-- Token Printing
-- ============================================================

fn tok_to_str
  case {| tok |} =>
    let nl = char_of_int {| n: 10 |}
    let vlen = strlen {| s: tok.value |}
    match vlen == 0
      case 1 => concat {| a: tok.type, b: nl |}
      case 0 =>
        let s1 = concat {| a: tok.type, b: " " |}
        let s2 = concat {| a: s1, b: tok.value |}
        concat {| a: s2, b: nl |}
    end
end

fn print_tokens_acc
  case {| list, acc |} =>
    match is_nil {| list: list |}
      case 1 => acc
      case 0 =>
        let head = list_head {| list: list |}
        let tail = list_tail {| list: list |}
        let s = tok_to_str {| tok: head |}
        let new_acc = concat {| a: acc, b: s |}
        print_tokens_acc {| list: tail, acc: new_acc |}
    end
end

fn print_tokens
  case {| list |} =>
    print_tokens_acc {| list: list, acc: "" |}
end

-- ============================================================
-- Parser Infrastructure
-- ============================================================

fn peek
  case {| tokens |} =>
    match is_nil {| list: tokens |}
      case 1 => {| type: "eof", value: "" |}
      case 0 => list_head {| list: tokens |}
    end
end

fn advance
  case {| tokens |} =>
    match is_nil {| list: tokens |}
      case 1 => tokens
      case 0 => list_tail {| list: tokens |}
    end
end

fn expect
  case {| tokens, type |} =>
    let tok = peek {| tokens: tokens |}
    match str_eq {| a: tok.type, b: type |}
      case 1 => advance {| tokens: tokens |}
    end
end

fn expect_ident
  case {| tokens |} =>
    let tok = peek {| tokens: tokens |}
    match str_eq {| a: tok.type, b: "ident" |}
      case 1 =>
        let rest = advance {| tokens: tokens |}
        {| name: tok.value, rest: rest |}
    end
end

-- ============================================================
-- Operator Helpers
-- ============================================================

fn is_cmp_op
  case {| type |} =>
    (str_eq {| a: type, b: "==" |}) ||
    (str_eq {| a: type, b: "!=" |}) ||
    (str_eq {| a: type, b: "<" |}) ||
    (str_eq {| a: type, b: ">" |}) ||
    (str_eq {| a: type, b: "<=" |}) ||
    (str_eq {| a: type, b: ">=" |})
end

fn is_add_op
  case {| type |} =>
    (str_eq {| a: type, b: "+" |}) ||
    (str_eq {| a: type, b: "-" |})
end

fn is_mul_op
  case {| type |} =>
    (str_eq {| a: type, b: "*" |}) ||
    (str_eq {| a: type, b: "/" |}) ||
    (str_eq {| a: type, b: "%" |})
end

-- ============================================================
-- Record / Field Parsing
-- ============================================================

fn parse_field_inits
  case {| tokens, acc |} =>
    let id = expect_ident {| tokens: tokens |}
    let rest1 = expect {| tokens: id.rest, type: ":" |}
    let r = parse_expr {| tokens: rest1 |}
    let field = {| name: id.name, value: r.node |}
    let new_acc = cons {| head: field, tail: acc |}
    let tok = peek {| tokens: r.rest |}
    match str_eq {| a: tok.type, b: "," |}
      case 1 =>
        let rest2 = advance {| tokens: r.rest |}
        parse_field_inits {| tokens: rest2, acc: new_acc |}
      case 0 =>
        let result = list_reverse {| list: new_acc |}
        {| node: result, rest: r.rest |}
    end
end

fn parse_record_lit
  case {| tokens |} =>
    let rest1 = expect {| tokens: tokens, type: "{|" |}
    let tok = peek {| tokens: rest1 |}
    match str_eq {| a: tok.type, b: "|}" |}
      case 1 =>
        let rest2 = advance {| tokens: rest1 |}
        let empty = nil {| |}
        {| node: {| tag: "record", fields: empty |}, rest: rest2 |}
      case 0 =>
        let empty = nil {| |}
        let r = parse_field_inits {| tokens: rest1, acc: empty |}
        let rest2 = expect {| tokens: r.rest, type: "|}" |}
        {| node: {| tag: "record", fields: r.node |}, rest: rest2 |}
    end
end

-- ============================================================
-- Pattern Parsing
-- ============================================================

fn parse_pat_fields
  case {| tokens, acc |} =>
    let id = expect_ident {| tokens: tokens |}
    let tok = peek {| tokens: id.rest |}
    match str_eq {| a: tok.type, b: ":" |}
      case 1 =>
        let rest1 = advance {| tokens: id.rest |}
        let r = parse_pattern {| tokens: rest1 |}
        let field = {| name: id.name, pat: r.node |}
        let new_acc = cons {| head: field, tail: acc |}
        let tok2 = peek {| tokens: r.rest |}
        match str_eq {| a: tok2.type, b: "," |}
          case 1 =>
            let rest2 = advance {| tokens: r.rest |}
            parse_pat_fields {| tokens: rest2, acc: new_acc |}
          case 0 =>
            let result = list_reverse {| list: new_acc |}
            {| node: result, rest: r.rest |}
        end
      case 0 =>
        let field = {| name: id.name, pat: {| tag: "pat_none" |} |}
        let new_acc = cons {| head: field, tail: acc |}
        let tok2 = peek {| tokens: id.rest |}
        match str_eq {| a: tok2.type, b: "," |}
          case 1 =>
            let rest1 = advance {| tokens: id.rest |}
            parse_pat_fields {| tokens: rest1, acc: new_acc |}
          case 0 =>
            let result = list_reverse {| list: new_acc |}
            {| node: result, rest: id.rest |}
        end
    end
end

fn parse_record_pat
  case {| tokens |} =>
    let rest1 = expect {| tokens: tokens, type: "{|" |}
    let tok = peek {| tokens: rest1 |}
    match str_eq {| a: tok.type, b: "|}" |}
      case 1 =>
        let rest2 = advance {| tokens: rest1 |}
        let empty = nil {| |}
        {| node: {| tag: "pat_rec", fields: empty |}, rest: rest2 |}
      case 0 =>
        let empty = nil {| |}
        let r = parse_pat_fields {| tokens: rest1, acc: empty |}
        let rest2 = expect {| tokens: r.rest, type: "|}" |}
        {| node: {| tag: "pat_rec", fields: r.node |}, rest: rest2 |}
    end
end

fn parse_pattern
  case {| tokens |} =>
    let tok = peek {| tokens: tokens |}
    match tok.type
      case "{|" => parse_record_pat {| tokens: tokens |}
      case "int" =>
        let rest1 = advance {| tokens: tokens |}
        {| node: {| tag: "pat_int", value: tok.value |}, rest: rest1 |}
      case "str" =>
        let rest1 = advance {| tokens: tokens |}
        {| node: {| tag: "pat_str", value: tok.value |}, rest: rest1 |}
      case "_" =>
        let rest1 = advance {| tokens: tokens |}
        {| node: {| tag: "pat_wild" |}, rest: rest1 |}
      case _ =>
        let rest1 = advance {| tokens: tokens |}
        {| node: {| tag: "pat_var", name: tok.value |}, rest: rest1 |}
    end
end

-- ============================================================
-- Block Expression / Let Bindings
-- ============================================================

fn fold_let_bindings
  case {| bindings, body |} =>
    match is_nil {| list: bindings |}
      case 1 => body
      case 0 =>
        let head = list_head {| list: bindings |}
        let tail = list_tail {| list: bindings |}
        let inner = fold_let_bindings {| bindings: tail, body: body |}
        {| tag: "let_in", name: head.name, value: head.value, body: inner |}
    end
end

fn collect_let_chain_acc
  case {| node, acc |} =>
    match node.tag
      case "let_in" =>
        let binding = {| name: node.name, value: node.value |}
        let new_acc = cons {| head: binding, tail: acc |}
        collect_let_chain_acc {| node: node.body, acc: new_acc |}
      case _ =>
        let reversed = list_reverse {| list: acc |}
        {| bindings: reversed, body: node |}
    end
end

fn collect_let_chain
  case {| node |} =>
    let empty = nil {| |}
    collect_let_chain_acc {| node: node, acc: empty |}
end

fn parse_let_bindings
  case {| tokens, acc |} =>
    let tok = peek {| tokens: tokens |}
    match str_eq {| a: tok.type, b: "let" |}
      case 1 =>
        let rest1 = advance {| tokens: tokens |}
        let id = expect_ident {| tokens: rest1 |}
        let rest2 = expect {| tokens: id.rest, type: "=" |}
        let r = parse_expr {| tokens: rest2 |}
        let binding = {| name: id.name, value: r.node |}
        let new_acc = cons {| head: binding, tail: acc |}
        parse_let_bindings {| tokens: r.rest, acc: new_acc |}
      case 0 =>
        let result = list_reverse {| list: acc |}
        {| node: result, rest: tokens |}
    end
end

fn parse_block_expr
  case {| tokens |} =>
    let empty = nil {| |}
    let r_bindings = parse_let_bindings {| tokens: tokens, acc: empty |}
    let r_expr = parse_expr {| tokens: r_bindings.rest |}
    let body = fold_let_bindings {| bindings: r_bindings.node, body: r_expr.node |}
    {| node: body, rest: r_expr.rest |}
end

-- ============================================================
-- Given Clauses
-- ============================================================

fn parse_case_clause
  case {| tokens |} =>
    let rest1 = expect {| tokens: tokens, type: "case" |}
    let r_pat = parse_pattern {| tokens: rest1 |}
    let rest2 = expect {| tokens: r_pat.rest, type: "=>" |}
    let r_body = parse_block_expr {| tokens: rest2 |}
    {| node: {| pat: r_pat.node, body: r_body.node |}, rest: r_body.rest |}
end

fn parse_case_clauses
  case {| tokens, acc |} =>
    let tok = peek {| tokens: tokens |}
    match str_eq {| a: tok.type, b: "case" |}
      case 1 =>
        let r = parse_case_clause {| tokens: tokens |}
        let new_acc = cons {| head: r.node, tail: acc |}
        parse_case_clauses {| tokens: r.rest, acc: new_acc |}
      case 0 =>
        let result = list_reverse {| list: acc |}
        {| node: result, rest: tokens |}
    end
end

-- ============================================================
-- Complex Expressions (function calls, named records, match)
-- ============================================================

fn parse_named_record_expr
  case {| tokens |} =>
    let id = expect_ident {| tokens: tokens |}
    let r = parse_record_lit {| tokens: id.rest |}
    {| node: {| tag: "named_record", name: id.name, fields: r.node.fields |}, rest: r.rest |}
end

fn parse_match_expr
  case {| tokens |} =>
    let rest1 = expect {| tokens: tokens, type: "match" |}
    let r = parse_expr {| tokens: rest1 |}
    let empty = nil {| |}
    let r2 = parse_case_clauses {| tokens: r.rest, acc: empty |}
    let rest2 = expect {| tokens: r2.rest, type: "end" |}
    {| node: {| tag: "match", scrutinee: r.node, clauses: r2.node |}, rest: rest2 |}
end

-- ============================================================
-- Primary Expression
-- ============================================================

fn parse_primary
  case {| tokens |} =>
    let tok = peek {| tokens: tokens |}
    match tok.type
      case "int" =>
        let rest1 = advance {| tokens: tokens |}
        {| node: {| tag: "int_lit", value: tok.value |}, rest: rest1 |}
      case "str" =>
        let rest1 = advance {| tokens: tokens |}
        {| node: {| tag: "str_lit", value: tok.value |}, rest: rest1 |}
      case "ident" =>
        let first_ch = char_at {| s: tok.value, n: 0 |}
        let is_upper = (first_ch >= 65) && (first_ch <= 90)
        let next_tok = peek {| tokens: advance {| tokens: tokens |} |}
        let next_is_rec = str_eq {| a: next_tok.type, b: "{|" |}
        let next_is_paren = str_eq {| a: next_tok.type, b: "(" |}
        match is_upper && next_is_rec
          case 1 => parse_named_record_expr {| tokens: tokens |}
          case 0 =>
            match (is_upper == 0) && next_is_rec
              case 1 =>
                let id = expect_ident {| tokens: tokens |}
                let r = parse_record_lit {| tokens: id.rest |}
                {| node: {| tag: "call", name: id.name, arg: r.node |}, rest: r.rest |}
              case 0 =>
                match (is_upper == 0) && next_is_paren
                  case 1 =>
                    let id = expect_ident {| tokens: tokens |}
                    let rest1 = expect {| tokens: id.rest, type: "(" |}
                    let r = parse_expr {| tokens: rest1 |}
                    let rest2 = expect {| tokens: r.rest, type: ")" |}
                    {| node: {| tag: "call", name: id.name, arg: r.node |}, rest: rest2 |}
                  case 0 =>
                    let rest1 = advance {| tokens: tokens |}
                    {| node: {| tag: "var", name: tok.value |}, rest: rest1 |}
                end
            end
        end
      case "readln" =>
        let rest1 = advance {| tokens: tokens |}
        {| node: {| tag: "readln" |}, rest: rest1 |}
      case "readint" =>
        let rest1 = advance {| tokens: tokens |}
        {| node: {| tag: "readint" |}, rest: rest1 |}
      case "(" =>
        let rest1 = advance {| tokens: tokens |}
        let r = parse_expr {| tokens: rest1 |}
        let rest2 = expect {| tokens: r.rest, type: ")" |}
        {| node: r.node, rest: rest2 |}
      case "match" => parse_match_expr {| tokens: tokens |}
      case "{|" => parse_record_lit {| tokens: tokens |}
    end
end

-- ============================================================
-- Expression Precedence Chain
-- ============================================================

fn parse_postfix_tail
  case {| left, tokens |} =>
    let tok = peek {| tokens: tokens |}
    match str_eq {| a: tok.type, b: "." |}
      case 1 =>
        let rest1 = advance {| tokens: tokens |}
        let id = expect_ident {| tokens: rest1 |}
        let node = {| tag: "field_access", obj: left, field: id.name |}
        parse_postfix_tail {| left: node, tokens: id.rest |}
      case 0 => {| node: left, rest: tokens |}
    end
end

fn parse_postfix_expr
  case {| tokens |} =>
    let r = parse_primary {| tokens: tokens |}
    parse_postfix_tail {| left: r.node, tokens: r.rest |}
end

fn parse_unary_expr
  case {| tokens |} =>
    let tok = peek {| tokens: tokens |}
    match str_eq {| a: tok.type, b: "-" |}
      case 1 =>
        let rest1 = advance {| tokens: tokens |}
        let r = parse_unary_expr {| tokens: rest1 |}
        let node = {| tag: "unop", op: "-", operand: r.node |}
        {| node: node, rest: r.rest |}
      case 0 => parse_postfix_expr {| tokens: tokens |}
    end
end

fn parse_mul_tail
  case {| left, tokens |} =>
    let tok = peek {| tokens: tokens |}
    match is_mul_op {| type: tok.type |}
      case 1 =>
        let rest1 = advance {| tokens: tokens |}
        let r = parse_unary_expr {| tokens: rest1 |}
        let node = {| tag: "binop", op: tok.type, left: left, right: r.node |}
        parse_mul_tail {| left: node, tokens: r.rest |}
      case 0 => {| node: left, rest: tokens |}
    end
end

fn parse_mul_expr
  case {| tokens |} =>
    let r = parse_unary_expr {| tokens: tokens |}
    parse_mul_tail {| left: r.node, tokens: r.rest |}
end

fn parse_add_tail
  case {| left, tokens |} =>
    let tok = peek {| tokens: tokens |}
    match is_add_op {| type: tok.type |}
      case 1 =>
        let rest1 = advance {| tokens: tokens |}
        let r = parse_mul_expr {| tokens: rest1 |}
        let node = {| tag: "binop", op: tok.type, left: left, right: r.node |}
        parse_add_tail {| left: node, tokens: r.rest |}
      case 0 => {| node: left, rest: tokens |}
    end
end

fn parse_add_expr
  case {| tokens |} =>
    let r = parse_mul_expr {| tokens: tokens |}
    parse_add_tail {| left: r.node, tokens: r.rest |}
end

fn parse_cmp_expr
  case {| tokens |} =>
    let r = parse_add_expr {| tokens: tokens |}
    let tok = peek {| tokens: r.rest |}
    match is_cmp_op {| type: tok.type |}
      case 1 =>
        let rest1 = advance {| tokens: r.rest |}
        let r2 = parse_add_expr {| tokens: rest1 |}
        let node = {| tag: "binop", op: tok.type, left: r.node, right: r2.node |}
        {| node: node, rest: r2.rest |}
      case 0 => {| node: r.node, rest: r.rest |}
    end
end

fn parse_and_tail
  case {| left, tokens |} =>
    let tok = peek {| tokens: tokens |}
    match str_eq {| a: tok.type, b: "&&" |}
      case 1 =>
        let rest1 = advance {| tokens: tokens |}
        let r = parse_cmp_expr {| tokens: rest1 |}
        let node = {| tag: "binop", op: "&&", left: left, right: r.node |}
        parse_and_tail {| left: node, tokens: r.rest |}
      case 0 => {| node: left, rest: tokens |}
    end
end

fn parse_and_expr
  case {| tokens |} =>
    let r = parse_cmp_expr {| tokens: tokens |}
    parse_and_tail {| left: r.node, tokens: r.rest |}
end

fn parse_or_tail
  case {| left, tokens |} =>
    let tok = peek {| tokens: tokens |}
    match str_eq {| a: tok.type, b: "||" |}
      case 1 =>
        let rest1 = advance {| tokens: tokens |}
        let r = parse_and_expr {| tokens: rest1 |}
        let node = {| tag: "binop", op: "||", left: left, right: r.node |}
        parse_or_tail {| left: node, tokens: r.rest |}
      case 0 => {| node: left, rest: tokens |}
    end
end

fn parse_or_expr
  case {| tokens |} =>
    let r = parse_and_expr {| tokens: tokens |}
    parse_or_tail {| left: r.node, tokens: r.rest |}
end

fn parse_expr
  case {| tokens |} => parse_or_expr {| tokens: tokens |}
end

-- ============================================================
-- Statement Parsing
-- ============================================================

fn parse_stmt
  case {| tokens |} =>
    let tok = peek {| tokens: tokens |}
    match tok.type
      case "let" =>
        let rest1 = advance {| tokens: tokens |}
        let id = expect_ident {| tokens: rest1 |}
        let rest2 = expect {| tokens: id.rest, type: "=" |}
        let r = parse_expr {| tokens: rest2 |}
        {| node: {| tag: "stmt_let", name: id.name, value: r.node |}, rest: r.rest |}
      case "print" =>
        let rest1 = advance {| tokens: tokens |}
        let r = parse_expr {| tokens: rest1 |}
        {| node: {| tag: "stmt_stele_print", value: r.node |}, rest: r.rest |}
      case "write" =>
        let rest1 = advance {| tokens: tokens |}
        let r = parse_expr {| tokens: rest1 |}
        {| node: {| tag: "stmt_stele_write", value: r.node |}, rest: r.rest |}
      case _ =>
        let r = parse_expr {| tokens: tokens |}
        {| node: {| tag: "stmt_expr", value: r.node |}, rest: r.rest |}
    end
end

fn parse_stmts
  case {| tokens, acc |} =>
    let tok = peek {| tokens: tokens |}
    match str_eq {| a: tok.type, b: "end" |}
      case 1 =>
        let result = list_reverse {| list: acc |}
        {| node: result, rest: tokens |}
      case 0 =>
        let r = parse_stmt {| tokens: tokens |}
        let new_acc = cons {| head: r.node, tail: acc |}
        parse_stmts {| tokens: r.rest, acc: new_acc |}
    end
end

-- ============================================================
-- Declaration Parsing
-- ============================================================

fn parse_struct_fields
  case {| tokens, acc |} =>
    let tok = peek {| tokens: tokens |}
    match str_eq {| a: tok.type, b: "end" |}
      case 1 =>
        let result = list_reverse {| list: acc |}
        {| node: result, rest: tokens |}
      case 0 =>
        let id = expect_ident {| tokens: tokens |}
        let rest1 = expect {| tokens: id.rest, type: ":" |}
        let type_id = expect_ident {| tokens: rest1 |}
        let field = {| name: id.name, type_name: type_id.name |}
        let new_acc = cons {| head: field, tail: acc |}
        parse_struct_fields {| tokens: type_id.rest, acc: new_acc |}
    end
end

fn parse_fn_decl
  case {| tokens |} =>
    let rest1 = expect {| tokens: tokens, type: "fn" |}
    let id = expect_ident {| tokens: rest1 |}
    let empty = nil {| |}
    let r = parse_case_clauses {| tokens: id.rest, acc: empty |}
    let rest2 = expect {| tokens: r.rest, type: "end" |}
    {| node: {| tag: "decl_fn", name: id.name, clauses: r.node |}, rest: rest2 |}
end

fn parse_do_decl
  case {| tokens |} =>
    let rest1 = expect {| tokens: tokens, type: "do" |}
    let id = expect_ident {| tokens: rest1 |}
    let empty = nil {| |}
    let r = parse_stmts {| tokens: id.rest, acc: empty |}
    let rest2 = expect {| tokens: r.rest, type: "end" |}
    {| node: {| tag: "decl_do", name: id.name, stmts: r.node |}, rest: rest2 |}
end

fn parse_struct_decl
  case {| tokens |} =>
    let rest1 = expect {| tokens: tokens, type: "struct" |}
    let id = expect_ident {| tokens: rest1 |}
    let empty = nil {| |}
    let r = parse_struct_fields {| tokens: id.rest, acc: empty |}
    let rest2 = expect {| tokens: r.rest, type: "end" |}
    {| node: {| tag: "decl_struct", name: id.name, fields: r.node |}, rest: rest2 |}
end

fn parse_decl
  case {| tokens |} =>
    let tok = peek {| tokens: tokens |}
    match tok.type
      case "fn" => parse_fn_decl {| tokens: tokens |}
      case "do" => parse_do_decl {| tokens: tokens |}
      case "struct" => parse_struct_decl {| tokens: tokens |}
    end
end

fn parse_decls
  case {| tokens, acc |} =>
    let tok = peek {| tokens: tokens |}
    match str_eq {| a: tok.type, b: "eof" |}
      case 1 => list_reverse {| list: acc |}
      case 0 =>
        let r = parse_decl {| tokens: tokens |}
        let new_acc = cons {| head: r.node, tail: acc |}
        parse_decls {| tokens: r.rest, acc: new_acc |}
    end
end

fn parse_program
  case {| tokens |} =>
    let empty = nil {| |}
    parse_decls {| tokens: tokens, acc: empty |}
end

-- ============================================================
-- Code Generation: Foundation Helpers
-- ============================================================

-- Character constants
fn dq
  case {| |} => char_of_int {| n: 34 |}
end

fn bsl
  case {| |} => char_of_int {| n: 92 |}
end

fn nl
  case {| |} => char_of_int {| n: 10 |}
end

-- Fresh variable generation: returns {| name: "_tN", counter: N+1 |}
fn fresh_var
  case {| prefix, counter |} =>
    let name = concat {| a: prefix, b: int_to_str {| n: counter |} |}
    {| name: name, counter: counter + 1 |}
end

-- Escape a single character for C string literals
fn c_escape_char
  case {| c |} =>
    match c
      case 34 =>
        let b = bsl {| |}
        let q = dq {| |}
        concat {| a: b, b: q |}
      case 92 =>
        let b = bsl {| |}
        concat {| a: b, b: b |}
      case 10 =>
        let b = bsl {| |}
        concat {| a: b, b: "n" |}
      case 9 =>
        let b = bsl {| |}
        concat {| a: b, b: "t" |}
      case 13 =>
        let b = bsl {| |}
        concat {| a: b, b: "r" |}
      case _ => char_of_int {| n: c |}
    end
end

-- Loop helper for c_string
fn c_escape_str_loop
  case {| s, pos, acc |} =>
    let slen = strlen {| s: s |}
    match pos >= slen
      case 1 => acc
      case 0 =>
        let ch = char_at {| s: s, n: pos |}
        let esc = c_escape_char {| c: ch |}
        let new_acc = concat {| a: acc, b: esc |}
        c_escape_str_loop {| s: s, pos: pos + 1, acc: new_acc |}
    end
end

-- Wrap a string in escaped C double quotes: "..."
fn c_string
  case {| s |} =>
    let q = dq {| |}
    let escaped = c_escape_str_loop {| s: s, pos: 0, acc: "" |}
    let s1 = concat {| a: q, b: escaped |}
    concat {| a: s1, b: q |}
end

-- Mangle a Stele identifier for C (stele_ prefix, except "arg")
fn c_name
  case {| name |} =>
    match str_eq {| a: name, b: "arg" |}
      case 1 => "arg"
      case 0 => concat {| a: "stele_", b: name |}
    end
end

-- Check if a fn name is a built-in (defined in runtime, no forward decl needed)
fn is_builtin_fn
  case {| name |} =>
    (str_eq {| a: name, b: "unearth" |}) ||
    (str_eq {| a: name, b: "inscribe" |}) ||
    (str_eq {| a: name, b: "argc" |}) ||
    (str_eq {| a: name, b: "argv" |}) ||
    (str_eq {| a: name, b: "strlen" |}) ||
    (str_eq {| a: name, b: "char_at" |}) ||
    (str_eq {| a: name, b: "substr" |}) ||
    (str_eq {| a: name, b: "concat" |}) ||
    (str_eq {| a: name, b: "int_to_str" |}) ||
    (str_eq {| a: name, b: "char_of_int" |}) ||
    (str_eq {| a: name, b: "strcmp" |})
end

-- ============================================================
-- Code Generation: Expression Emission
-- ============================================================
-- Each emitter returns {| code: String, var: String, counter: Int |}

-- Emit a binary operation (pure helper, operands are variable names)
fn emit_binop_c
  case {| op, a, b |} =>
    match op
      case "+" =>
        let s1 = concat {| a: "make_int(", b: a |}
        let s2 = concat {| a: s1, b: "->int_val + " |}
        let s3 = concat {| a: s2, b: b |}
        concat {| a: s3, b: "->int_val)" |}
      case "-" =>
        let s1 = concat {| a: "make_int(", b: a |}
        let s2 = concat {| a: s1, b: "->int_val - " |}
        let s3 = concat {| a: s2, b: b |}
        concat {| a: s3, b: "->int_val)" |}
      case "*" =>
        let s1 = concat {| a: "make_int(", b: a |}
        let s2 = concat {| a: s1, b: "->int_val * " |}
        let s3 = concat {| a: s2, b: b |}
        concat {| a: s3, b: "->int_val)" |}
      case "/" =>
        let s1 = concat {| a: "make_int(", b: a |}
        let s2 = concat {| a: s1, b: "->int_val / " |}
        let s3 = concat {| a: s2, b: b |}
        concat {| a: s3, b: "->int_val)" |}
      case "%" =>
        let s1 = concat {| a: "make_int(", b: a |}
        let s2 = concat {| a: s1, b: "->int_val % " |}
        let s3 = concat {| a: s2, b: b |}
        concat {| a: s3, b: "->int_val)" |}
      case "==" =>
        let s1 = concat {| a: "make_int(", b: a |}
        let s2 = concat {| a: s1, b: "->int_val == " |}
        let s3 = concat {| a: s2, b: b |}
        concat {| a: s3, b: "->int_val)" |}
      case "!=" =>
        let s1 = concat {| a: "make_int(", b: a |}
        let s2 = concat {| a: s1, b: "->int_val != " |}
        let s3 = concat {| a: s2, b: b |}
        concat {| a: s3, b: "->int_val)" |}
      case "<" =>
        let s1 = concat {| a: "make_int(", b: a |}
        let s2 = concat {| a: s1, b: "->int_val < " |}
        let s3 = concat {| a: s2, b: b |}
        concat {| a: s3, b: "->int_val)" |}
      case ">" =>
        let s1 = concat {| a: "make_int(", b: a |}
        let s2 = concat {| a: s1, b: "->int_val > " |}
        let s3 = concat {| a: s2, b: b |}
        concat {| a: s3, b: "->int_val)" |}
      case "<=" =>
        let s1 = concat {| a: "make_int(", b: a |}
        let s2 = concat {| a: s1, b: "->int_val <= " |}
        let s3 = concat {| a: s2, b: b |}
        concat {| a: s3, b: "->int_val)" |}
      case ">=" =>
        let s1 = concat {| a: "make_int(", b: a |}
        let s2 = concat {| a: s1, b: "->int_val >= " |}
        let s3 = concat {| a: s2, b: b |}
        concat {| a: s3, b: "->int_val)" |}
      case "&&" =>
        let s1 = concat {| a: "make_int(", b: a |}
        let s2 = concat {| a: s1, b: "->int_val && " |}
        let s3 = concat {| a: s2, b: b |}
        concat {| a: s3, b: "->int_val)" |}
      case "||" =>
        let s1 = concat {| a: "make_int(", b: a |}
        let s2 = concat {| a: s1, b: "->int_val || " |}
        let s3 = concat {| a: s2, b: b |}
        concat {| a: s3, b: "->int_val)" |}
    end
end

fn emit_int_lit
  case {| node, counter |} =>
    let f = fresh_var {| prefix: "_t", counter: counter |}
    let n = nl {| |}
    let s1 = concat {| a: "Value* ", b: f.name |}
    let s2 = concat {| a: s1, b: " = make_int(" |}
    let s3 = concat {| a: s2, b: node.value |}
    let s4 = concat {| a: s3, b: ");" |}
    let code = concat {| a: s4, b: n |}
    {| code: code, var: f.name, counter: f.counter |}
end

fn emit_str_lit
  case {| node, counter |} =>
    let f = fresh_var {| prefix: "_t", counter: counter |}
    let n = nl {| |}
    let cs = c_string {| s: node.value |}
    let s1 = concat {| a: "Value* ", b: f.name |}
    let s2 = concat {| a: s1, b: " = make_str(" |}
    let s3 = concat {| a: s2, b: cs |}
    let s4 = concat {| a: s3, b: ");" |}
    let code = concat {| a: s4, b: n |}
    {| code: code, var: f.name, counter: f.counter |}
end

fn emit_var
  case {| node, counter |} =>
    let f = fresh_var {| prefix: "_t", counter: counter |}
    let n = nl {| |}
    let cn = c_name {| name: node.name |}
    let s1 = concat {| a: "Value* ", b: f.name |}
    let s2 = concat {| a: s1, b: " = " |}
    let s3 = concat {| a: s2, b: cn |}
    let s4 = concat {| a: s3, b: "; rc_retain(" |}
    let s5 = concat {| a: s4, b: f.name |}
    let s6 = concat {| a: s5, b: ");" |}
    let code = concat {| a: s6, b: n |}
    {| code: code, var: f.name, counter: f.counter |}
end

fn emit_binop
  case {| node, counter |} =>
    let n = nl {| |}
    let r1 = emit_expr {| node: node.left, counter: counter |}
    let r2 = emit_expr {| node: node.right, counter: r1.counter |}
    let f = fresh_var {| prefix: "_t", counter: r2.counter |}
    let op_str = emit_binop_c {| op: node.op, a: r1.var, b: r2.var |}
    let s1 = concat {| a: r1.code, b: r2.code |}
    let s2 = concat {| a: s1, b: "Value* " |}
    let s3 = concat {| a: s2, b: f.name |}
    let s4 = concat {| a: s3, b: " = " |}
    let s5 = concat {| a: s4, b: op_str |}
    let s6 = concat {| a: s5, b: ";" |}
    let s7 = concat {| a: s6, b: n |}
    let s8 = concat {| a: s7, b: "rc_release(" |}
    let s9 = concat {| a: s8, b: r1.var |}
    let s10 = concat {| a: s9, b: "); rc_release(" |}
    let s11 = concat {| a: s10, b: r2.var |}
    let s12 = concat {| a: s11, b: ");" |}
    let code = concat {| a: s12, b: n |}
    {| code: code, var: f.name, counter: f.counter |}
end

fn emit_unop
  case {| node, counter |} =>
    let n = nl {| |}
    let r = emit_expr {| node: node.operand, counter: counter |}
    let f = fresh_var {| prefix: "_t", counter: r.counter |}
    -- Only negation supported for now
    let s1 = concat {| a: r.code, b: "Value* " |}
    let s2 = concat {| a: s1, b: f.name |}
    let s3 = concat {| a: s2, b: " = make_int(-" |}
    let s4 = concat {| a: s3, b: r.var |}
    let s5 = concat {| a: s4, b: "->int_val);" |}
    let s6 = concat {| a: s5, b: n |}
    let s7 = concat {| a: s6, b: "rc_release(" |}
    let s8 = concat {| a: s7, b: r.var |}
    let s9 = concat {| a: s8, b: ");" |}
    let code = concat {| a: s9, b: n |}
    {| code: code, var: f.name, counter: f.counter |}
end

fn emit_field_access
  case {| node, counter |} =>
    let n = nl {| |}
    let r = emit_expr {| node: node.obj, counter: counter |}
    let f = fresh_var {| prefix: "_t", counter: r.counter |}
    let cs = c_string {| s: node.field |}
    let s1 = concat {| a: r.code, b: "Value* " |}
    let s2 = concat {| a: s1, b: f.name |}
    let s3 = concat {| a: s2, b: " = record_field(" |}
    let s4 = concat {| a: s3, b: r.var |}
    let s5 = concat {| a: s4, b: ", " |}
    let s6 = concat {| a: s5, b: cs |}
    let s7 = concat {| a: s6, b: ");" |}
    let s8 = concat {| a: s7, b: n |}
    let s9 = concat {| a: s8, b: "rc_retain(" |}
    let s10 = concat {| a: s9, b: f.name |}
    let s11 = concat {| a: s10, b: ");" |}
    let s12 = concat {| a: s11, b: n |}
    let s13 = concat {| a: s12, b: "rc_release(" |}
    let s14 = concat {| a: s13, b: r.var |}
    let s15 = concat {| a: s14, b: ");" |}
    let code = concat {| a: s15, b: n |}
    {| code: code, var: f.name, counter: f.counter |}
end

-- Emit record field values, building up code and argument list
fn emit_record_fields_loop
  case {| fields, counter, setup, args |} =>
    match is_nil {| list: fields |}
      case 1 => {| setup: setup, args: args, counter: counter |}
      case 0 =>
        let head = list_head {| list: fields |}
        let tail = list_tail {| list: fields |}
        let r = emit_expr {| node: head.value, counter: counter |}
        let new_setup = concat {| a: setup, b: r.code |}
        let cs = c_string {| s: head.name |}
        let a1 = concat {| a: args, b: ", " |}
        let a2 = concat {| a: a1, b: cs |}
        let a3 = concat {| a: a2, b: ", " |}
        let new_args = concat {| a: a3, b: r.var |}
        emit_record_fields_loop {| fields: tail, counter: r.counter, setup: new_setup, args: new_args |}
    end
end

fn emit_record
  case {| node, counter |} =>
    let n = nl {| |}
    let num_fields = list_len {| list: node.fields |}
    let num_str = int_to_str {| n: num_fields |}
    let r = emit_record_fields_loop {| fields: node.fields, counter: counter, setup: "", args: "" |}
    let f = fresh_var {| prefix: "_t", counter: r.counter |}
    let s1 = concat {| a: r.setup, b: "Value* " |}
    let s2 = concat {| a: s1, b: f.name |}
    let s3 = concat {| a: s2, b: " = make_record(" |}
    let s4 = concat {| a: s3, b: num_str |}
    let s5 = concat {| a: s4, b: r.args |}
    let s6 = concat {| a: s5, b: ");" |}
    let code = concat {| a: s6, b: n |}
    {| code: code, var: f.name, counter: f.counter |}
end

fn emit_call_expr
  case {| node, counter |} =>
    let n = nl {| |}
    let r = emit_expr {| node: node.arg, counter: counter |}
    let f = fresh_var {| prefix: "_t", counter: r.counter |}
    let s1 = concat {| a: r.code, b: "Value* " |}
    let s2 = concat {| a: s1, b: f.name |}
    let s3 = concat {| a: s2, b: " = fn_" |}
    let s4 = concat {| a: s3, b: node.name |}
    let s5 = concat {| a: s4, b: "(" |}
    let s6 = concat {| a: s5, b: r.var |}
    let s7 = concat {| a: s6, b: ");" |}
    let s8 = concat {| a: s7, b: n |}
    let s9 = concat {| a: s8, b: "rc_release(" |}
    let s10 = concat {| a: s9, b: r.var |}
    let s11 = concat {| a: s10, b: ");" |}
    let code = concat {| a: s11, b: n |}
    {| code: code, var: f.name, counter: f.counter |}
end

fn emit_readln
  case {| counter |} =>
    let f = fresh_var {| prefix: "_t", counter: counter |}
    let n = nl {| |}
    let s1 = concat {| a: "Value* ", b: f.name |}
    let s2 = concat {| a: s1, b: " = runtime_readln();" |}
    let code = concat {| a: s2, b: n |}
    {| code: code, var: f.name, counter: f.counter |}
end

fn emit_readint
  case {| counter |} =>
    let f = fresh_var {| prefix: "_t", counter: counter |}
    let n = nl {| |}
    let s1 = concat {| a: "Value* ", b: f.name |}
    let s2 = concat {| a: s1, b: " = runtime_readint();" |}
    let code = concat {| a: s2, b: n |}
    {| code: code, var: f.name, counter: f.counter |}
end

fn emit_let_bindings_loop
  case {| bindings, counter, code_acc, names_acc |} =>
    match is_nil {| list: bindings |}
      case 1 => {| code: code_acc, counter: counter, names: names_acc |}
      case 0 =>
        let head = list_head {| list: bindings |}
        let tail = list_tail {| list: bindings |}
        let n = nl {| |}
        let rv = emit_expr {| node: head.value, counter: counter |}
        let cn = c_name {| name: head.name |}
        let s1 = concat {| a: rv.code, b: "Value* " |}
        let s2 = concat {| a: s1, b: cn |}
        let s3 = concat {| a: s2, b: " = " |}
        let s4 = concat {| a: s3, b: rv.var |}
        let s5 = concat {| a: s4, b: ";" |}
        let line = concat {| a: s5, b: n |}
        let new_code = concat {| a: code_acc, b: line |}
        let new_names = cons {| head: head.name, tail: names_acc |}
        emit_let_bindings_loop {| bindings: tail, counter: rv.counter, code_acc: new_code, names_acc: new_names |}
    end
end

fn emit_let_in
  case {| node, counter |} =>
    let chain = collect_let_chain {| node: node |}
    let empty = nil {| |}
    let br = emit_let_bindings_loop {| bindings: chain.bindings, counter: counter, code_acc: "", names_acc: empty |}
    let rb = emit_expr {| node: chain.body, counter: br.counter |}
    let release = gen_release_code {| names: br.names |}
    let s1 = concat {| a: br.code, b: rb.code |}
    let code = concat {| a: s1, b: release |}
    {| code: code, var: rb.var, counter: rb.counter |}
end

-- ============================================================
-- Code Generation: Pattern Matching
-- ============================================================
-- Returns {| cond: String, bindings: String |}

-- Match a single record field pattern
-- Returns {| cond: String, bindings: String |}
fn emit_rec_field_match
  case {| var, field |} =>
    let n = nl {| |}
    let cs = c_string {| s: field.name |}
    let tmp = concat {| a: "_f_", b: field.name |}
    -- Value* _f_NAME = record_field(var, "NAME");
    let b1 = concat {| a: "Value* ", b: tmp |}
    let b2 = concat {| a: b1, b: " = record_field(" |}
    let b3 = concat {| a: b2, b: var |}
    let b4 = concat {| a: b3, b: ", " |}
    let b5 = concat {| a: b4, b: cs |}
    let b6 = concat {| a: b5, b: ");" |}
    let binding1 = concat {| a: b6, b: n |}
    -- Value* bl_NAME = _f_NAME;
    let cn = c_name {| name: field.name |}
    let b7 = concat {| a: "Value* ", b: cn |}
    let b8 = concat {| a: b7, b: " = " |}
    let b9 = concat {| a: b8, b: tmp |}
    let b10 = concat {| a: b9, b: ";" |}
    let binding2 = concat {| a: b10, b: n |}
    let both_bindings = concat {| a: binding1, b: binding2 |}
    -- Null check is always needed
    let null_check = concat {| a: tmp, b: " != NULL" |}
    match field.pat.tag
      case "pat_none" =>
        {| cond: null_check, bindings: both_bindings |}
      case "pat_var" =>
        {| cond: null_check, bindings: both_bindings |}
      case "pat_int" =>
        let c1 = concat {| a: null_check, b: " && " |}
        let c2 = concat {| a: c1, b: tmp |}
        let c3 = concat {| a: c2, b: "->tag == TAG_INT && " |}
        let c4 = concat {| a: c3, b: tmp |}
        let c5 = concat {| a: c4, b: "->int_val == " |}
        let cond = concat {| a: c5, b: field.pat.value |}
        {| cond: cond, bindings: both_bindings |}
      case "pat_str" =>
        let csv = c_string {| s: field.pat.value |}
        let c1 = concat {| a: null_check, b: " && " |}
        let c2 = concat {| a: c1, b: tmp |}
        let c3 = concat {| a: c2, b: "->tag == TAG_STR && strcmp(" |}
        let c4 = concat {| a: c3, b: tmp |}
        let c5 = concat {| a: c4, b: "->str_val, " |}
        let c6 = concat {| a: c5, b: csv |}
        let cond = concat {| a: c6, b: ") == 0" |}
        {| cond: cond, bindings: both_bindings |}
      case "pat_wild" =>
        {| cond: null_check, bindings: binding1 |}
    end
end

-- Loop over record pattern fields, accumulating conditions and bindings
fn emit_rec_pat_loop
  case {| var, fields, cond_acc, bind_acc |} =>
    match is_nil {| list: fields |}
      case 1 => {| cond: cond_acc, bindings: bind_acc |}
      case 0 =>
        let head = list_head {| list: fields |}
        let tail = list_tail {| list: fields |}
        let r = emit_rec_field_match {| var: var, field: head |}
        -- Combine conditions with &&
        let new_cond = match str_eq {| a: cond_acc, b: "" |}
          case 1 => r.cond
          case 0 =>
            let c1 = concat {| a: cond_acc, b: " && " |}
            concat {| a: c1, b: r.cond |}
        end
        let new_bind = concat {| a: bind_acc, b: r.bindings |}
        emit_rec_pat_loop {| var: var, fields: tail, cond_acc: new_cond, bind_acc: new_bind |}
    end
end

-- Central pattern match dispatcher
-- Returns {| cond: String, bindings: String |}
fn emit_pat_match
  case {| var, pat |} =>
    let n = nl {| |}
    match pat.tag
      case "pat_wild" =>
        {| cond: "1", bindings: "" |}
      case "pat_var" =>
        let cn = c_name {| name: pat.name |}
        let b1 = concat {| a: "Value* ", b: cn |}
        let b2 = concat {| a: b1, b: " = " |}
        let b3 = concat {| a: b2, b: var |}
        let b4 = concat {| a: b3, b: ";" |}
        let bindings = concat {| a: b4, b: n |}
        {| cond: "1", bindings: bindings |}
      case "pat_int" =>
        let c1 = concat {| a: var, b: "->tag == TAG_INT && " |}
        let c2 = concat {| a: c1, b: var |}
        let c3 = concat {| a: c2, b: "->int_val == " |}
        let cond = concat {| a: c3, b: pat.value |}
        {| cond: cond, bindings: "" |}
      case "pat_str" =>
        let cs = c_string {| s: pat.value |}
        let c1 = concat {| a: var, b: "->tag == TAG_STR && strcmp(" |}
        let c2 = concat {| a: c1, b: var |}
        let c3 = concat {| a: c2, b: "->str_val, " |}
        let c4 = concat {| a: c3, b: cs |}
        let cond = concat {| a: c4, b: ") == 0" |}
        {| cond: cond, bindings: "" |}
      case "pat_rec" =>
        let r = emit_rec_pat_loop {| var: var, fields: pat.fields, cond_acc: "", bind_acc: "" |}
        -- Prepend TAG_RECORD check
        let rec_check = concat {| a: var, b: "->tag == TAG_RECORD" |}
        let cond = match str_eq {| a: r.cond, b: "" |}
          case 1 => rec_check
          case 0 =>
            let c1 = concat {| a: rec_check, b: " && " |}
            concat {| a: c1, b: r.cond |}
        end
        {| cond: cond, bindings: r.bindings |}
    end
end

-- Extract bound variable names from a pattern (for retain/release)
fn extract_field_bound_names
  case {| field |} =>
    match field.pat.tag
      case "pat_none" =>
        cons {| head: field.name, tail: nil {| |} |}
      case "pat_var" =>
        cons {| head: field.name, tail: nil {| |} |}
      case "pat_int" =>
        cons {| head: field.name, tail: nil {| |} |}
      case "pat_str" =>
        cons {| head: field.name, tail: nil {| |} |}
      case _ => nil {| |}
    end
end

fn extract_bound_names_loop
  case {| fields, acc |} =>
    match is_nil {| list: fields |}
      case 1 => acc
      case 0 =>
        let head = list_head {| list: fields |}
        let tail = list_tail {| list: fields |}
        let names = extract_field_bound_names {| field: head |}
        -- Append names to acc
        let new_acc = match is_nil {| list: names |}
          case 1 => acc
          case 0 =>
            let name = list_head {| list: names |}
            cons {| head: name, tail: acc |}
        end
        extract_bound_names_loop {| fields: tail, acc: new_acc |}
    end
end

fn extract_bound_names
  case {| pat |} =>
    match pat.tag
      case "pat_var" =>
        cons {| head: pat.name, tail: nil {| |} |}
      case "pat_rec" =>
        let empty = nil {| |}
        extract_bound_names_loop {| fields: pat.fields, acc: empty |}
      case _ => nil {| |}
    end
end

-- Generate retain code for a list of bound names
fn gen_retain_code
  case {| names |} =>
    let n = nl {| |}
    match is_nil {| list: names |}
      case 1 => ""
      case 0 =>
        let head = list_head {| list: names |}
        let tail = list_tail {| list: names |}
        let cn = c_name {| name: head |}
        let s1 = concat {| a: "rc_retain(", b: cn |}
        let s2 = concat {| a: s1, b: ");" |}
        let s3 = concat {| a: s2, b: n |}
        let rest = gen_retain_code {| names: tail |}
        concat {| a: s3, b: rest |}
    end
end

-- Generate release code for a list of bound names
fn gen_release_code
  case {| names |} =>
    let n = nl {| |}
    match is_nil {| list: names |}
      case 1 => ""
      case 0 =>
        let head = list_head {| list: names |}
        let tail = list_tail {| list: names |}
        let cn = c_name {| name: head |}
        let s1 = concat {| a: "rc_release(", b: cn |}
        let s2 = concat {| a: s1, b: ");" |}
        let s3 = concat {| a: s2, b: n |}
        let rest = gen_release_code {| names: tail |}
        concat {| a: s3, b: rest |}
    end
end

-- ============================================================
-- Code Generation: Divine Expression
-- ============================================================

-- Emit a single match clause
fn emit_match_clause
  case {| scr, dvn, lbl, clause, counter |} =>
    let n = nl {| |}
    let pm = emit_pat_match {| var: scr, pat: clause.pat |}
    let bound = extract_bound_names {| pat: clause.pat |}
    let rb = emit_expr {| node: clause.body, counter: counter |}
    let retain = gen_retain_code {| names: bound |}
    let release = gen_release_code {| names: bound |}
    let s1 = concat {| a: "{", b: n |}
    let s2 = concat {| a: s1, b: pm.bindings |}
    let s3 = concat {| a: s2, b: "if (" |}
    let s4 = concat {| a: s3, b: pm.cond |}
    let s5 = concat {| a: s4, b: ") {" |}
    let s6 = concat {| a: s5, b: n |}
    let s7 = concat {| a: s6, b: retain |}
    let s8 = concat {| a: s7, b: rb.code |}
    let s9 = concat {| a: s8, b: release |}
    let s10 = concat {| a: s9, b: dvn |}
    let s11 = concat {| a: s10, b: " = " |}
    let s12 = concat {| a: s11, b: rb.var |}
    let s13 = concat {| a: s12, b: ";" |}
    let s14 = concat {| a: s13, b: n |}
    let s15 = concat {| a: s14, b: "goto " |}
    let s16 = concat {| a: s15, b: lbl |}
    let s17 = concat {| a: s16, b: ";" |}
    let s18 = concat {| a: s17, b: n |}
    let s19 = concat {| a: s18, b: "}" |}
    let s20 = concat {| a: s19, b: n |}
    let s21 = concat {| a: s20, b: "}" |}
    let code = concat {| a: s21, b: n |}
    {| code: code, counter: rb.counter |}
end

-- Loop over match clauses
fn emit_match_clauses_loop
  case {| scr, dvn, lbl, clauses, counter, acc |} =>
    match is_nil {| list: clauses |}
      case 1 => {| code: acc, counter: counter |}
      case 0 =>
        let head = list_head {| list: clauses |}
        let tail = list_tail {| list: clauses |}
        let r = emit_match_clause {| scr: scr, dvn: dvn, lbl: lbl, clause: head, counter: counter |}
        let new_acc = concat {| a: acc, b: r.code |}
        emit_match_clauses_loop {| scr: scr, dvn: dvn, lbl: lbl, clauses: tail, counter: r.counter, acc: new_acc |}
    end
end

-- Emit a match expression
fn emit_match
  case {| node, counter |} =>
    let n = nl {| |}
    let rs = emit_expr {| node: node.scrutinee, counter: counter |}
    let fdvn = fresh_var {| prefix: "_dvn", counter: rs.counter |}
    let fscr = fresh_var {| prefix: "_scr", counter: fdvn.counter |}
    let flbl = fresh_var {| prefix: "_done", counter: fscr.counter |}
    let rc = emit_match_clauses_loop {| scr: fscr.name, dvn: fdvn.name, lbl: flbl.name, clauses: node.clauses, counter: flbl.counter, acc: "" |}
    let s1 = concat {| a: rs.code, b: "Value* " |}
    let s2 = concat {| a: s1, b: fdvn.name |}
    let s3 = concat {| a: s2, b: ";" |}
    let s4 = concat {| a: s3, b: n |}
    let s5 = concat {| a: s4, b: "Value* " |}
    let s6 = concat {| a: s5, b: fscr.name |}
    let s7 = concat {| a: s6, b: " = " |}
    let s8 = concat {| a: s7, b: rs.var |}
    let s9 = concat {| a: s8, b: ";" |}
    let s10 = concat {| a: s9, b: n |}
    let s11 = concat {| a: s10, b: rc.code |}
    let bslash = bsl {| |}
    let bsn = concat {| a: bslash, b: "n" |}
    let divine_err = concat {| a: "Pattern match failure in match", b: bsn |}
    let divine_err_c = c_string {| s: divine_err |}
    let s12 = concat {| a: s11, b: "fprintf(stderr, " |}
    let s13 = concat {| a: s12, b: divine_err_c |}
    let s14 = concat {| a: s13, b: "); exit(1);" |}
    let s15 = concat {| a: s14, b: n |}
    let s16 = concat {| a: s15, b: flbl.name |}
    let s17 = concat {| a: s16, b: ":;" |}
    let s18 = concat {| a: s17, b: n |}
    let s19 = concat {| a: s18, b: "rc_release(" |}
    let s20 = concat {| a: s19, b: fscr.name |}
    let s21 = concat {| a: s20, b: ");" |}
    let code = concat {| a: s21, b: n |}
    {| code: code, var: fdvn.name, counter: rc.counter |}
end

-- Central expression dispatcher
fn emit_expr
  case {| node, counter |} =>
    match node.tag
      case "int_lit" => emit_int_lit {| node: node, counter: counter |}
      case "str_lit" => emit_str_lit {| node: node, counter: counter |}
      case "var" => emit_var {| node: node, counter: counter |}
      case "binop" => emit_binop {| node: node, counter: counter |}
      case "unop" => emit_unop {| node: node, counter: counter |}
      case "field_access" => emit_field_access {| node: node, counter: counter |}
      case "record" => emit_record {| node: node, counter: counter |}
      case "named_record" => emit_record {| node: {| tag: "record", fields: node.fields |}, counter: counter |}
      case "call" => emit_call_expr {| node: node, counter: counter |}
      case "readln" => emit_readln {| counter: counter |}
      case "readint" => emit_readint {| counter: counter |}
      case "let_in" => emit_let_in {| node: node, counter: counter |}
      case "match" => emit_match {| node: node, counter: counter |}
    end
end

-- ============================================================
-- Code Generation: Rite (Function) Emission
-- ============================================================

-- Emit a single case clause inside a fn
fn emit_clause
  case {| clause, counter |} =>
    let n = nl {| |}
    let pm = emit_pat_match {| var: "arg", pat: clause.pat |}
    let bound = extract_bound_names {| pat: clause.pat |}
    let rb = emit_expr {| node: clause.body, counter: counter |}
    let retain = gen_retain_code {| names: bound |}
    let release = gen_release_code {| names: bound |}
    let s1 = concat {| a: "{", b: n |}
    let s2 = concat {| a: s1, b: pm.bindings |}
    let s3 = concat {| a: s2, b: "if (" |}
    let s4 = concat {| a: s3, b: pm.cond |}
    let s5 = concat {| a: s4, b: ") {" |}
    let s6 = concat {| a: s5, b: n |}
    let s7 = concat {| a: s6, b: retain |}
    let s8 = concat {| a: s7, b: rb.code |}
    let s9 = concat {| a: s8, b: release |}
    let s10 = concat {| a: s9, b: "return " |}
    let s11 = concat {| a: s10, b: rb.var |}
    let s12 = concat {| a: s11, b: ";" |}
    let s13 = concat {| a: s12, b: n |}
    let s14 = concat {| a: s13, b: "}" |}
    let s15 = concat {| a: s14, b: n |}
    let s16 = concat {| a: s15, b: "}" |}
    let code = concat {| a: s16, b: n |}
    {| code: code, counter: rb.counter |}
end

-- Loop over clauses in a fn
fn emit_clauses_loop
  case {| clauses, counter, acc |} =>
    match is_nil {| list: clauses |}
      case 1 => {| code: acc, counter: counter |}
      case 0 =>
        let head = list_head {| list: clauses |}
        let tail = list_tail {| list: clauses |}
        let r = emit_clause {| clause: head, counter: counter |}
        let new_acc = concat {| a: acc, b: r.code |}
        emit_clauses_loop {| clauses: tail, counter: r.counter, acc: new_acc |}
    end
end

-- Emit a fn definition
fn emit_fn
  case {| name, clauses, counter |} =>
    let n = nl {| |}
    let rc = emit_clauses_loop {| clauses: clauses, counter: counter, acc: "" |}
    let s1 = concat {| a: "static Value* fn_", b: name |}
    let s2 = concat {| a: s1, b: "(Value* arg) {" |}
    let s3 = concat {| a: s2, b: n |}
    let s4 = concat {| a: s3, b: rc.code |}
    let s5 = concat {| a: s4, b: "fprintf(stderr, " |}
    let bslash = bsl {| |}
    let bsn = concat {| a: bslash, b: "n" |}
    let err_msg = concat {| a: "Pattern match failure in fn '", b: name |}
    let err_msg2 = concat {| a: err_msg, b: "'" |}
    let err_msg3 = concat {| a: err_msg2, b: bsn |}
    let s6 = concat {| a: s5, b: c_string {| s: err_msg3 |} |}
    let s7 = concat {| a: s6, b: ");" |}
    let s8 = concat {| a: s7, b: n |}
    let s9 = concat {| a: s8, b: "exit(1);" |}
    let s10 = concat {| a: s9, b: n |}
    let s11 = concat {| a: s10, b: "}" |}
    let s12 = concat {| a: s11, b: n |}
    let code = concat {| a: s12, b: n |}
    {| code: code, counter: rc.counter |}
end

-- Emit a forward declaration for a fn
fn emit_forward_decl
  case {| name |} =>
    let n = nl {| |}
    match is_builtin_fn {| name: name |}
      case 1 => ""
      case 0 =>
        let s1 = concat {| a: "static Value* fn_", b: name |}
        let s2 = concat {| a: s1, b: "(Value* arg);" |}
        concat {| a: s2, b: n |}
    end
end

-- Loop over declarations to emit forward declarations
fn emit_forward_decls_loop
  case {| decls, acc |} =>
    match is_nil {| list: decls |}
      case 1 => acc
      case 0 =>
        let head = list_head {| list: decls |}
        let tail = list_tail {| list: decls |}
        let new_acc = match str_eq {| a: head.tag, b: "decl_fn" |}
          case 1 =>
            let fd = emit_forward_decl {| name: head.name |}
            concat {| a: acc, b: fd |}
          case 0 => acc
        end
        emit_forward_decls_loop {| decls: tail, acc: new_acc |}
    end
end

-- ============================================================
-- Code Generation: Statement & Main Emission
-- ============================================================

-- Emit a single statement
fn emit_stmt
  case {| stmt, counter |} =>
    let n = nl {| |}
    match stmt.tag
      case "stmt_let" =>
        let r = emit_expr {| node: stmt.value, counter: counter |}
        let cn = c_name {| name: stmt.name |}
        let s1 = concat {| a: r.code, b: "Value* " |}
        let s2 = concat {| a: s1, b: cn |}
        let s3 = concat {| a: s2, b: " = " |}
        let s4 = concat {| a: s3, b: r.var |}
        let s5 = concat {| a: s4, b: ";" |}
        let code = concat {| a: s5, b: n |}
        {| code: code, counter: r.counter |}
      case "stmt_stele_print" =>
        let r = emit_expr {| node: stmt.value, counter: counter |}
        let s1 = concat {| a: r.code, b: "stele_print(" |}
        let s2 = concat {| a: s1, b: r.var |}
        let s3 = concat {| a: s2, b: ");" |}
        let s4 = concat {| a: s3, b: n |}
        let s5 = concat {| a: s4, b: "rc_release(" |}
        let s6 = concat {| a: s5, b: r.var |}
        let s7 = concat {| a: s6, b: ");" |}
        let code = concat {| a: s7, b: n |}
        {| code: code, counter: r.counter |}
      case "stmt_stele_write" =>
        let r = emit_expr {| node: stmt.value, counter: counter |}
        let s1 = concat {| a: r.code, b: "stele_write(" |}
        let s2 = concat {| a: s1, b: r.var |}
        let s3 = concat {| a: s2, b: ");" |}
        let s4 = concat {| a: s3, b: n |}
        let s5 = concat {| a: s4, b: "rc_release(" |}
        let s6 = concat {| a: s5, b: r.var |}
        let s7 = concat {| a: s6, b: ");" |}
        let code = concat {| a: s7, b: n |}
        {| code: code, counter: r.counter |}
      case "stmt_expr" =>
        let r = emit_expr {| node: stmt.value, counter: counter |}
        let s1 = concat {| a: r.code, b: "rc_release(" |}
        let s2 = concat {| a: s1, b: r.var |}
        let s3 = concat {| a: s2, b: ");" |}
        let code = concat {| a: s3, b: n |}
        {| code: code, counter: r.counter |}
    end
end

-- Loop over statements, threading the counter
fn emit_stmts_loop
  case {| stmts, counter, acc |} =>
    match is_nil {| list: stmts |}
      case 1 => {| code: acc, counter: counter |}
      case 0 =>
        let head = list_head {| list: stmts |}
        let tail = list_tail {| list: stmts |}
        let r = emit_stmt {| stmt: head, counter: counter |}
        let new_acc = concat {| a: acc, b: r.code |}
        emit_stmts_loop {| stmts: tail, counter: r.counter, acc: new_acc |}
    end
end

-- Collect let-bound names from statements (for cleanup at end of main)
fn collect_let_names
  case {| stmts, acc |} =>
    match is_nil {| list: stmts |}
      case 1 => acc
      case 0 =>
        let head = list_head {| list: stmts |}
        let tail = list_tail {| list: stmts |}
        let new_acc = match str_eq {| a: head.tag, b: "stmt_let" |}
          case 1 => cons {| head: head.name, tail: acc |}
          case 0 => acc
        end
        collect_let_names {| stmts: tail, acc: new_acc |}
    end
end

-- Find the main do in declarations
fn find_do
  case {| decls, name |} =>
    match is_nil {| list: decls |}
      case 1 => {| tag: "none" |}
      case 0 =>
        let head = list_head {| list: decls |}
        let tail = list_tail {| list: decls |}
        match str_eq {| a: head.tag, b: "decl_do" |}
          case 1 =>
            match str_eq {| a: head.name, b: name |}
              case 1 => {| tag: "some", stmts: head.stmts |}
              case 0 => find_do {| decls: tail, name: name |}
            end
          case 0 => find_do {| decls: tail, name: name |}
        end
    end
end

-- Emit the main function
fn emit_main_fn
  case {| decls, counter |} =>
    let n = nl {| |}
    let rit = find_do {| decls: decls, name: "main" |}
    match rit.tag
      case "none" =>
        let code = concat {| a: "int main(int argc, char** argv) {", b: n |}
        let c2 = concat {| a: code, b: "g_argc = argc;" |}
        let c3 = concat {| a: c2, b: n |}
        let c4 = concat {| a: c3, b: "g_argv = argv;" |}
        let c5 = concat {| a: c4, b: n |}
        let c6 = concat {| a: c5, b: "return 0;" |}
        let c7 = concat {| a: c6, b: n |}
        let c8 = concat {| a: c7, b: "}" |}
        concat {| a: c8, b: n |}
      case "some" =>
        let rs = emit_stmts_loop {| stmts: rit.stmts, counter: counter, acc: "" |}
        let empty = nil {| |}
        let let_names = collect_let_names {| stmts: rit.stmts, acc: empty |}
        let rel = gen_release_code {| names: let_names |}
        let s1 = concat {| a: "int main(int argc, char** argv) {", b: n |}
        let s2 = concat {| a: s1, b: "g_argc = argc;" |}
        let s3 = concat {| a: s2, b: n |}
        let s4 = concat {| a: s3, b: "g_argv = argv;" |}
        let s5 = concat {| a: s4, b: n |}
        let s6 = concat {| a: s5, b: rs.code |}
        let s7 = concat {| a: s6, b: rel |}
        let s8 = concat {| a: s7, b: "return 0;" |}
        let s9 = concat {| a: s8, b: n |}
        let s10 = concat {| a: s9, b: "}" |}
        concat {| a: s10, b: n |}
    end
end

-- ============================================================
-- Code Generation: Top-Level Pipeline
-- ============================================================

-- Loop over declarations, emitting fn definitions
fn emit_decls_loop
  case {| decls, counter, acc |} =>
    match is_nil {| list: decls |}
      case 1 => {| code: acc, counter: counter |}
      case 0 =>
        let head = list_head {| list: decls |}
        let tail = list_tail {| list: decls |}
        let r = match str_eq {| a: head.tag, b: "decl_fn" |}
          case 1 =>
            match is_builtin_fn {| name: head.name |}
              case 1 => {| code: "", counter: counter |}
              case 0 => emit_fn {| name: head.name, clauses: head.clauses, counter: counter |}
            end
          case 0 => {| code: "", counter: counter |}
        end
        let new_acc = concat {| a: acc, b: r.code |}
        emit_decls_loop {| decls: tail, counter: r.counter, acc: new_acc |}
    end
end

-- Assemble the complete C source file
fn emit_c
  case {| decls |} =>
    let n = nl {| |}
    -- Load the C runtime from file
    let runtime = unearth {| path: "runtime.c" |}
    -- Forward declarations
    let fwd_decls = emit_forward_decls_loop {| decls: decls, acc: "" |}
    -- Rite definitions
    let fn_defs = emit_decls_loop {| decls: decls, counter: 0, acc: "" |}
    -- Main function
    let main_fn = emit_main_fn {| decls: decls, counter: fn_defs.counter |}
    -- Assemble
    let s1 = concat {| a: runtime, b: n |}
    let s2 = concat {| a: s1, b: "/* -- forward declarations -- */" |}
    let s3 = concat {| a: s2, b: n |}
    let s4 = concat {| a: s3, b: n |}
    let s5 = concat {| a: s4, b: fwd_decls |}
    let s6 = concat {| a: s5, b: n |}
    let s7 = concat {| a: s6, b: "/* -- fn definitions -- */" |}
    let s8 = concat {| a: s7, b: n |}
    let s9 = concat {| a: s8, b: n |}
    let s10 = concat {| a: s9, b: fn_defs.code |}
    let s11 = concat {| a: s10, b: n |}
    let s12 = concat {| a: s11, b: "/* -- entry point -- */" |}
    let s13 = concat {| a: s12, b: n |}
    let s14 = concat {| a: s13, b: n |}
    concat {| a: s14, b: main_fn |}
end

-- ============================================================
-- AArch64 Code Generation: Helpers
-- ============================================================

-- Allocate a stack slot for a named variable
fn alloc_slot
  case {| name, state |} =>
    let slot = state.slot_counter
    let new_slots = cons {| head: {| name: name, slot: slot |}, tail: state.slots |}
    {| slot: slot, state: {| counter: state.counter, slot_counter: slot + 1, slots: new_slots, strs: state.strs |} |}
end

-- Look up a named variable's slot number
fn lookup_slot
  case {| name, slots |} =>
    match slots
      case {| tag: "cons", head, tail |} =>
        match str_eq {| a: head.name, b: name |}
          case 1 => head.slot
          case 0 => lookup_slot {| name: name, slots: tail |}
        end
    end
end

-- Stack offset for a slot: -(16 + (slot+1)*8)
fn slot_offset
  case {| slot |} => 0 - (16 + (slot + 1) * 8)
end

-- Append newline to a string (assembly line terminator)
fn asm_ln
  case {| s |} => concat {| a: s, b: nl {| |} |}
end

-- Generate load from stack slot into register
fn emit_load_slot
  case {| slot, reg |} =>
    let off = slot_offset {| slot: slot |}
    let off_s = int_to_str {| n: off |}
    match off >= (0 - 256)
      case 1 =>
        let s1 = concat {| a: "  ldur ", b: reg |}
        let s2 = concat {| a: s1, b: ", [x29, #" |}
        let s3 = concat {| a: s2, b: off_s |}
        asm_ln {| s: concat {| a: s3, b: "]" |} |}
      case 0 =>
        let mov = emit_mov_imm {| reg: "x16", n: off |}
        let s1 = concat {| a: mov, b: "  ldr " |}
        let s2 = concat {| a: s1, b: reg |}
        asm_ln {| s: concat {| a: s2, b: ", [x29, x16]" |} |}
    end
end

-- Generate store register into stack slot
fn emit_store_slot
  case {| slot, reg |} =>
    let off = slot_offset {| slot: slot |}
    let off_s = int_to_str {| n: off |}
    match off >= (0 - 256)
      case 1 =>
        let s1 = concat {| a: "  stur ", b: reg |}
        let s2 = concat {| a: s1, b: ", [x29, #" |}
        let s3 = concat {| a: s2, b: off_s |}
        asm_ln {| s: concat {| a: s3, b: "]" |} |}
      case 0 =>
        let mov = emit_mov_imm {| reg: "x16", n: off |}
        let s1 = concat {| a: mov, b: "  str " |}
        let s2 = concat {| a: s1, b: reg |}
        asm_ln {| s: concat {| a: s2, b: ", [x29, x16]" |} |}
    end
end

-- Generate mov/movn for integer immediate
fn emit_mov_imm
  case {| reg, n |} =>
    let nc = nl {| |}
    match (n >= 0) && (n < 65536)
      case 1 =>
        let s1 = concat {| a: "  mov ", b: reg |}
        let s2 = concat {| a: s1, b: ", #" |}
        let s3 = concat {| a: s2, b: int_to_str {| n: n |} |}
        concat {| a: s3, b: nc |}
      case 0 =>
        match (n < 0) && (n >= (0 - 65536))
          case 1 =>
            let pos = 0 - (n + 1)
            let s1 = concat {| a: "  movn ", b: reg |}
            let s2 = concat {| a: s1, b: ", #" |}
            let s3 = concat {| a: s2, b: int_to_str {| n: pos |} |}
            concat {| a: s3, b: nc |}
          case 0 =>
            match n >= 0
              case 1 =>
                let lo = n % 65536
                let hi = n / 65536
                let s1 = concat {| a: "  mov ", b: reg |}
                let s2 = concat {| a: s1, b: ", #" |}
                let s3 = concat {| a: s2, b: int_to_str {| n: lo |} |}
                let s4 = concat {| a: s3, b: nc |}
                let s5 = concat {| a: s4, b: "  movk " |}
                let s6 = concat {| a: s5, b: reg |}
                let s7 = concat {| a: s6, b: ", #" |}
                let s8 = concat {| a: s7, b: int_to_str {| n: hi |} |}
                let s9 = concat {| a: s8, b: ", lsl #16" |}
                concat {| a: s9, b: nc |}
              case 0 =>
                let abs_n = 0 - n
                let lo = abs_n % 65536
                let hi = abs_n / 65536
                match hi == 0
                  case 1 =>
                    let s1 = concat {| a: "  mov ", b: reg |}
                    let s2 = concat {| a: s1, b: ", #" |}
                    let s3 = concat {| a: s2, b: int_to_str {| n: lo |} |}
                    let s4 = concat {| a: s3, b: nc |}
                    let s5 = concat {| a: s4, b: "  neg " |}
                    let s6 = concat {| a: s5, b: reg |}
                    let s7 = concat {| a: s6, b: ", " |}
                    let s8 = concat {| a: s7, b: reg |}
                    concat {| a: s8, b: nc |}
                  case 0 =>
                    let s1 = concat {| a: "  mov ", b: reg |}
                    let s2 = concat {| a: s1, b: ", #" |}
                    let s3 = concat {| a: s2, b: int_to_str {| n: lo |} |}
                    let s4 = concat {| a: s3, b: nc |}
                    let s5 = concat {| a: s4, b: "  movk " |}
                    let s6 = concat {| a: s5, b: reg |}
                    let s7 = concat {| a: s6, b: ", #" |}
                    let s8 = concat {| a: s7, b: int_to_str {| n: hi |} |}
                    let s9 = concat {| a: s8, b: ", lsl #16" |}
                    let s10 = concat {| a: s9, b: nc |}
                    let s11 = concat {| a: s10, b: "  neg " |}
                    let s12 = concat {| a: s11, b: reg |}
                    let s13 = concat {| a: s12, b: ", " |}
                    let s14 = concat {| a: s13, b: reg |}
                    concat {| a: s14, b: nc |}
                end
            end
        end
    end
end

-- Search string table for existing entry
fn find_str_asm
  case {| s, strs |} =>
    match is_nil {| list: strs |}
      case 1 => {| tag: "none" |}
      case 0 =>
        let head = list_head {| list: strs |}
        let tail = list_tail {| list: strs |}
        match str_eq {| a: head.value, b: s |}
          case 1 => {| tag: "some", label: head.label |}
          case 0 => find_str_asm {| s: s, strs: tail |}
        end
    end
end

-- Add string to table (with dedup), return label
fn add_str_asm
  case {| s, state |} =>
    let found = find_str_asm {| s: s, strs: state.strs |}
    match found.tag
      case "some" => {| label: found.label, state: state |}
      case "none" =>
        let idx = list_len {| list: state.strs |}
        let label = concat {| a: "Lstr", b: int_to_str {| n: idx |} |}
        let entry = {| label: label, value: s |}
        let new_strs = cons {| head: entry, tail: state.strs |}
        {| label: label, state: {| counter: state.counter, slot_counter: state.slot_counter, slots: state.slots, strs: new_strs |} |}
    end
end

-- Escape a character for .asciz
fn asm_escape_char
  case {| c |} =>
    match c
      case 34 => concat {| a: bsl {| |}, b: dq {| |} |}
      case 92 =>
        let b = bsl {| |}
        concat {| a: b, b: b |}
      case 10 => concat {| a: bsl {| |}, b: "n" |}
      case 9 => concat {| a: bsl {| |}, b: "t" |}
      case 13 => concat {| a: bsl {| |}, b: "r" |}
      case _ => char_of_int {| n: c |}
    end
end

fn asm_escape_loop
  case {| s, pos, acc |} =>
    let slen = strlen {| s: s |}
    match pos >= slen
      case 1 => acc
      case 0 =>
        let ch = char_at {| s: s, n: pos |}
        let esc = asm_escape_char {| c: ch |}
        asm_escape_loop {| s: s, pos: pos + 1, acc: concat {| a: acc, b: esc |} |}
    end
end

fn asm_string
  case {| s |} =>
    let q = dq {| |}
    let escaped = asm_escape_loop {| s: s, pos: 0, acc: "" |}
    let s1 = concat {| a: q, b: escaped |}
    concat {| a: s1, b: q |}
end

-- Fixed-size function prologue/epilogue (2064-byte frame)
fn emit_prologue
  case {| |} =>
    let n = nl {| |}
    let s1 = concat {| a: "  stp x29, x30, [sp, #-16]!", b: n |}
    let s2 = concat {| a: s1, b: "  mov x29, sp" |}
    let s3 = concat {| a: s2, b: n |}
    let s4 = concat {| a: s3, b: "  sub sp, sp, #2048" |}
    concat {| a: s4, b: n |}
end

fn emit_epilogue
  case {| |} =>
    let n = nl {| |}
    let s1 = concat {| a: "  add sp, sp, #2048", b: n |}
    let s2 = concat {| a: s1, b: "  ldp x29, x30, [sp], #16" |}
    let s3 = concat {| a: s2, b: n |}
    let s4 = concat {| a: s3, b: "  ret" |}
    concat {| a: s4, b: n |}
end

-- Check mode from argv[3]
fn get_mode
  case {| |} =>
    let ac = argc {| |}
    match ac >= 4
      case 1 =>
        match str_eq {| a: argv {| n: 3 |}, b: "asm" |}
          case 1 => 1
          case 0 => 0
        end
      case 0 => 0
    end
end

-- Retain/release code for bound pattern vars (ASM)
fn gen_retain_code_asm
  case {| names, slots |} =>
    match is_nil {| list: names |}
      case 1 => ""
      case 0 =>
        let head = list_head {| list: names |}
        let tail = list_tail {| list: names |}
        let cn = c_name {| name: head |}
        let slot = lookup_slot {| name: cn, slots: slots |}
        let load = emit_load_slot {| slot: slot, reg: "x0" |}
        let s1 = concat {| a: load, b: asm_ln {| s: "  bl _rc_retain" |} |}
        let rest = gen_retain_code_asm {| names: tail, slots: slots |}
        concat {| a: s1, b: rest |}
    end
end

fn gen_release_code_asm
  case {| names, slots |} =>
    match is_nil {| list: names |}
      case 1 => ""
      case 0 =>
        let head = list_head {| list: names |}
        let tail = list_tail {| list: names |}
        let cn = c_name {| name: head |}
        let slot = lookup_slot {| name: cn, slots: slots |}
        let load = emit_load_slot {| slot: slot, reg: "x0" |}
        let s1 = concat {| a: load, b: asm_ln {| s: "  bl _rc_release" |} |}
        let rest = gen_release_code_asm {| names: tail, slots: slots |}
        concat {| a: s1, b: rest |}
    end
end

-- ============================================================
-- AArch64: Expression Emission
-- ============================================================

fn emit_int_lit_asm
  case {| node, state |} =>
    let f = fresh_var {| prefix: "_t", counter: state.counter |}
    let st1 = {| counter: f.counter, slot_counter: state.slot_counter, slots: state.slots, strs: state.strs |}
    let r = alloc_slot {| name: f.name, state: st1 |}
    let val = str_to_int {| s: node.value |}
    let mov = emit_mov_imm {| reg: "x0", n: val |}
    let store = emit_store_slot {| slot: r.slot, reg: "x0" |}
    let code = concat {| a: mov, b: asm_ln {| s: "  bl _make_int" |} |}
    {| code: concat {| a: code, b: store |}, var: f.name, state: r.state |}
end

fn emit_str_lit_asm
  case {| node, state |} =>
    let n = nl {| |}
    let f = fresh_var {| prefix: "_t", counter: state.counter |}
    let st1 = {| counter: f.counter, slot_counter: state.slot_counter, slots: state.slots, strs: state.strs |}
    let sr = add_str_asm {| s: node.value, state: st1 |}
    let r = alloc_slot {| name: f.name, state: sr.state |}
    let store = emit_store_slot {| slot: r.slot, reg: "x0" |}
    let s1 = concat {| a: "  adrp x0, ", b: sr.label |}
    let s2 = concat {| a: s1, b: "@PAGE" |}
    let s3 = concat {| a: s2, b: n |}
    let s4 = concat {| a: s3, b: "  add x0, x0, " |}
    let s5 = concat {| a: s4, b: sr.label |}
    let s6 = concat {| a: s5, b: "@PAGEOFF" |}
    let s7 = concat {| a: s6, b: n |}
    let code = concat {| a: s7, b: asm_ln {| s: "  bl _make_str" |} |}
    {| code: concat {| a: code, b: store |}, var: f.name, state: r.state |}
end

fn emit_var_asm
  case {| node, state |} =>
    let cn = c_name {| name: node.name |}
    let src_slot = lookup_slot {| name: cn, slots: state.slots |}
    let f = fresh_var {| prefix: "_t", counter: state.counter |}
    let st1 = {| counter: f.counter, slot_counter: state.slot_counter, slots: state.slots, strs: state.strs |}
    let r = alloc_slot {| name: f.name, state: st1 |}
    let load = emit_load_slot {| slot: src_slot, reg: "x8" |}
    let store = emit_store_slot {| slot: r.slot, reg: "x8" |}
    let rload = emit_load_slot {| slot: r.slot, reg: "x0" |}
    let s1 = concat {| a: load, b: store |}
    let s2 = concat {| a: s1, b: rload |}
    {| code: concat {| a: s2, b: asm_ln {| s: "  bl _rc_retain" |} |}, var: f.name, state: r.state |}
end

fn emit_binop_op_asm
  case {| op |} =>
    let n = nl {| |}
    match op
      case "+" => asm_ln {| s: "  add x0, x8, x9" |}
      case "-" => asm_ln {| s: "  sub x0, x8, x9" |}
      case "*" => asm_ln {| s: "  mul x0, x8, x9" |}
      case "/" => asm_ln {| s: "  sdiv x0, x8, x9" |}
      case "%" =>
        let s1 = concat {| a: "  sdiv x10, x8, x9", b: n |}
        concat {| a: s1, b: asm_ln {| s: "  msub x0, x10, x9, x8" |} |}
      case "==" =>
        let s1 = concat {| a: "  cmp x8, x9", b: n |}
        concat {| a: s1, b: asm_ln {| s: "  cset x0, eq" |} |}
      case "!=" =>
        let s1 = concat {| a: "  cmp x8, x9", b: n |}
        concat {| a: s1, b: asm_ln {| s: "  cset x0, ne" |} |}
      case "<" =>
        let s1 = concat {| a: "  cmp x8, x9", b: n |}
        concat {| a: s1, b: asm_ln {| s: "  cset x0, lt" |} |}
      case ">" =>
        let s1 = concat {| a: "  cmp x8, x9", b: n |}
        concat {| a: s1, b: asm_ln {| s: "  cset x0, gt" |} |}
      case "<=" =>
        let s1 = concat {| a: "  cmp x8, x9", b: n |}
        concat {| a: s1, b: asm_ln {| s: "  cset x0, le" |} |}
      case ">=" =>
        let s1 = concat {| a: "  cmp x8, x9", b: n |}
        concat {| a: s1, b: asm_ln {| s: "  cset x0, ge" |} |}
      case "&&" =>
        let s1 = concat {| a: "  cmp x8, #0", b: n |}
        let s2 = concat {| a: s1, b: "  cset w10, ne" |}
        let s3 = concat {| a: s2, b: n |}
        let s4 = concat {| a: s3, b: "  cmp x9, #0" |}
        let s5 = concat {| a: s4, b: n |}
        let s6 = concat {| a: s5, b: "  cset w11, ne" |}
        let s7 = concat {| a: s6, b: n |}
        concat {| a: s7, b: asm_ln {| s: "  and x0, x10, x11" |} |}
      case "||" =>
        let s1 = concat {| a: "  orr x10, x8, x9", b: n |}
        let s2 = concat {| a: s1, b: "  cmp x10, #0" |}
        let s3 = concat {| a: s2, b: n |}
        concat {| a: s3, b: asm_ln {| s: "  cset x0, ne" |} |}
    end
end

fn emit_binop_asm
  case {| node, state |} =>
    let r1 = emit_expr_asm {| node: node.left, state: state |}
    let r2 = emit_expr_asm {| node: node.right, state: r1.state |}
    let f = fresh_var {| prefix: "_t", counter: r2.state.counter |}
    let st = {| counter: f.counter, slot_counter: r2.state.slot_counter, slots: r2.state.slots, strs: r2.state.strs |}
    let ar = alloc_slot {| name: f.name, state: st |}
    let ls = lookup_slot {| name: r1.var, slots: ar.state.slots |}
    let rs = lookup_slot {| name: r2.var, slots: ar.state.slots |}
    let ll = emit_load_slot {| slot: ls, reg: "x8" |}
    let rl = emit_load_slot {| slot: rs, reg: "x9" |}
    let op = emit_binop_op_asm {| op: node.op |}
    let store = emit_store_slot {| slot: ar.slot, reg: "x0" |}
    let rll = emit_load_slot {| slot: ls, reg: "x0" |}
    let rrl = emit_load_slot {| slot: rs, reg: "x0" |}
    let s1 = concat {| a: r1.code, b: r2.code |}
    let s2 = concat {| a: s1, b: ll |}
    let s3 = concat {| a: s2, b: asm_ln {| s: "  ldr x8, [x8, #8]" |} |}
    let s4 = concat {| a: s3, b: rl |}
    let s5 = concat {| a: s4, b: asm_ln {| s: "  ldr x9, [x9, #8]" |} |}
    let s6 = concat {| a: s5, b: op |}
    let s7 = concat {| a: s6, b: asm_ln {| s: "  bl _make_int" |} |}
    let s8 = concat {| a: s7, b: store |}
    let s9 = concat {| a: s8, b: rll |}
    let s10 = concat {| a: s9, b: asm_ln {| s: "  bl _rc_release" |} |}
    let s11 = concat {| a: s10, b: rrl |}
    {| code: concat {| a: s11, b: asm_ln {| s: "  bl _rc_release" |} |}, var: f.name, state: ar.state |}
end

fn emit_unop_asm
  case {| node, state |} =>
    let n = nl {| |}
    let r = emit_expr_asm {| node: node.operand, state: state |}
    let f = fresh_var {| prefix: "_t", counter: r.state.counter |}
    let st = {| counter: f.counter, slot_counter: r.state.slot_counter, slots: r.state.slots, strs: r.state.strs |}
    let ar = alloc_slot {| name: f.name, state: st |}
    let ss = lookup_slot {| name: r.var, slots: ar.state.slots |}
    let load = emit_load_slot {| slot: ss, reg: "x8" |}
    let store = emit_store_slot {| slot: ar.slot, reg: "x0" |}
    let rload = emit_load_slot {| slot: ss, reg: "x0" |}
    let s1 = concat {| a: r.code, b: load |}
    let s2 = concat {| a: s1, b: "  ldr x8, [x8, #8]" |}
    let s3 = concat {| a: s2, b: n |}
    let s4 = concat {| a: s3, b: "  neg x0, x8" |}
    let s5 = concat {| a: s4, b: n |}
    let s6 = concat {| a: s5, b: asm_ln {| s: "  bl _make_int" |} |}
    let s7 = concat {| a: s6, b: store |}
    let s8 = concat {| a: s7, b: rload |}
    {| code: concat {| a: s8, b: asm_ln {| s: "  bl _rc_release" |} |}, var: f.name, state: ar.state |}
end

fn emit_field_access_asm
  case {| node, state |} =>
    let n = nl {| |}
    let r = emit_expr_asm {| node: node.obj, state: state |}
    let f = fresh_var {| prefix: "_t", counter: r.state.counter |}
    let st1 = {| counter: f.counter, slot_counter: r.state.slot_counter, slots: r.state.slots, strs: r.state.strs |}
    let sr = add_str_asm {| s: node.field, state: st1 |}
    let ar = alloc_slot {| name: f.name, state: sr.state |}
    let os = lookup_slot {| name: r.var, slots: ar.state.slots |}
    let lo = emit_load_slot {| slot: os, reg: "x0" |}
    let store = emit_store_slot {| slot: ar.slot, reg: "x0" |}
    let rl = emit_load_slot {| slot: ar.slot, reg: "x0" |}
    let ol = emit_load_slot {| slot: os, reg: "x0" |}
    let s1 = concat {| a: r.code, b: lo |}
    let s2 = concat {| a: s1, b: "  adrp x1, " |}
    let s3 = concat {| a: s2, b: sr.label |}
    let s4 = concat {| a: s3, b: "@PAGE" |}
    let s5 = concat {| a: s4, b: n |}
    let s6 = concat {| a: s5, b: "  add x1, x1, " |}
    let s7 = concat {| a: s6, b: sr.label |}
    let s8 = concat {| a: s7, b: "@PAGEOFF" |}
    let s9 = concat {| a: s8, b: n |}
    let s10 = concat {| a: s9, b: asm_ln {| s: "  bl _record_field" |} |}
    let s11 = concat {| a: s10, b: store |}
    let s12 = concat {| a: s11, b: rl |}
    let s13 = concat {| a: s12, b: asm_ln {| s: "  bl _rc_retain" |} |}
    let s14 = concat {| a: s13, b: ol |}
    {| code: concat {| a: s14, b: asm_ln {| s: "  bl _rc_release" |} |}, var: f.name, state: ar.state |}
end

-- Emit all record field value expressions
fn emit_record_vals_loop_asm
  case {| fields, state, code_acc, vars_acc |} =>
    match is_nil {| list: fields |}
      case 1 => {| code: code_acc, vars: vars_acc, state: state |}
      case 0 =>
        let head = list_head {| list: fields |}
        let tail = list_tail {| list: fields |}
        let r = emit_expr_asm {| node: head.value, state: state |}
        let entry = {| name: head.name, var: r.var |}
        let new_vars = cons {| head: entry, tail: vars_acc |}
        emit_record_vals_loop_asm {| fields: tail, state: r.state, code_acc: concat {| a: code_acc, b: r.code |}, vars_acc: new_vars |}
    end
end

-- Set up name/value arrays on stack for record creation
fn emit_record_setup_loop_asm
  case {| entries, state, idx, num_fields |} =>
    match is_nil {| list: entries |}
      case 1 => {| code: "", state: state |}
      case 0 =>
        let n = nl {| |}
        let head = list_head {| list: entries |}
        let tail = list_tail {| list: entries |}
        let sr = add_str_asm {| s: head.name, state: state |}
        let names_off = int_to_str {| n: idx * 8 |}
        let vals_off = int_to_str {| n: num_fields * 8 + idx * 8 |}
        let n1 = concat {| a: "  adrp x8, ", b: sr.label |}
        let n2 = concat {| a: n1, b: "@PAGE" |}
        let n3 = concat {| a: n2, b: n |}
        let n4 = concat {| a: n3, b: "  add x8, x8, " |}
        let n5 = concat {| a: n4, b: sr.label |}
        let n6 = concat {| a: n5, b: "@PAGEOFF" |}
        let n7 = concat {| a: n6, b: n |}
        let n8 = concat {| a: n7, b: "  str x8, [sp, #" |}
        let n9 = concat {| a: n8, b: names_off |}
        let n10 = asm_ln {| s: concat {| a: n9, b: "]" |} |}
        let vs = lookup_slot {| name: head.var, slots: sr.state.slots |}
        let vl = emit_load_slot {| slot: vs, reg: "x9" |}
        let v1 = concat {| a: vl, b: "  str x9, [sp, #" |}
        let v2 = concat {| a: v1, b: vals_off |}
        let v3 = asm_ln {| s: concat {| a: v2, b: "]" |} |}
        let rest = emit_record_setup_loop_asm {| entries: tail, state: sr.state, idx: idx + 1, num_fields: num_fields |}
        let s1 = concat {| a: n10, b: v3 |}
        {| code: concat {| a: s1, b: rest.code |}, state: rest.state |}
    end
end

fn emit_record_asm
  case {| node, state |} =>
    let n = nl {| |}
    let nf = list_len {| list: node.fields |}
    let empty = nil {| |}
    let vr = emit_record_vals_loop_asm {| fields: node.fields, state: state, code_acc: "", vars_acc: empty |}
    let entries = list_reverse {| list: vr.vars |}
    let total = ((nf * 16 + 15) / 16) * 16
    let sr = emit_record_setup_loop_asm {| entries: entries, state: vr.state, idx: 0, num_fields: nf |}
    let f = fresh_var {| prefix: "_t", counter: sr.state.counter |}
    let st1 = {| counter: f.counter, slot_counter: sr.state.slot_counter, slots: sr.state.slots, strs: sr.state.strs |}
    let ar = alloc_slot {| name: f.name, state: st1 |}
    let store = emit_store_slot {| slot: ar.slot, reg: "x0" |}
    let ns_s = int_to_str {| n: nf * 8 |}
    let tot_s = int_to_str {| n: total |}
    let sub_sp = match total == 0
      case 1 => ""
      case 0 => asm_ln {| s: concat {| a: "  sub sp, sp, #", b: tot_s |} |}
    end
    let add_sp = match total == 0
      case 1 => ""
      case 0 => asm_ln {| s: concat {| a: "  add sp, sp, #", b: tot_s |} |}
    end
    let s1 = concat {| a: vr.code, b: sub_sp |}
    let s2 = concat {| a: s1, b: sr.code |}
    let s3 = concat {| a: s2, b: emit_mov_imm {| reg: "x0", n: nf |} |}
    let s4 = concat {| a: s3, b: "  mov x1, sp" |}
    let s5 = concat {| a: s4, b: n |}
    let s6 = concat {| a: s5, b: "  add x2, sp, #" |}
    let s7 = concat {| a: s6, b: ns_s |}
    let s8 = concat {| a: s7, b: n |}
    let s9 = concat {| a: s8, b: asm_ln {| s: "  bl _make_record_with_fields" |} |}
    let s10 = concat {| a: s9, b: add_sp |}
    {| code: concat {| a: s10, b: store |}, var: f.name, state: ar.state |}
end

fn emit_call_asm
  case {| node, state |} =>
    let n = nl {| |}
    let r = emit_expr_asm {| node: node.arg, state: state |}
    let f = fresh_var {| prefix: "_t", counter: r.state.counter |}
    let st = {| counter: f.counter, slot_counter: r.state.slot_counter, slots: r.state.slots, strs: r.state.strs |}
    let ar = alloc_slot {| name: f.name, state: st |}
    let as2 = lookup_slot {| name: r.var, slots: ar.state.slots |}
    let la = emit_load_slot {| slot: as2, reg: "x0" |}
    let store = emit_store_slot {| slot: ar.slot, reg: "x0" |}
    let rla = emit_load_slot {| slot: as2, reg: "x0" |}
    let s1 = concat {| a: r.code, b: la |}
    let s2 = concat {| a: s1, b: "  bl _fn_" |}
    let s3 = concat {| a: s2, b: node.name |}
    let s4 = concat {| a: s3, b: n |}
    let s5 = concat {| a: s4, b: store |}
    let s6 = concat {| a: s5, b: rla |}
    {| code: concat {| a: s6, b: asm_ln {| s: "  bl _rc_release" |} |}, var: f.name, state: ar.state |}
end

fn emit_readln_asm
  case {| state |} =>
    let f = fresh_var {| prefix: "_t", counter: state.counter |}
    let st = {| counter: f.counter, slot_counter: state.slot_counter, slots: state.slots, strs: state.strs |}
    let ar = alloc_slot {| name: f.name, state: st |}
    let store = emit_store_slot {| slot: ar.slot, reg: "x0" |}
    {| code: concat {| a: asm_ln {| s: "  bl _runtime_readln" |}, b: store |}, var: f.name, state: ar.state |}
end

fn emit_readint_asm
  case {| state |} =>
    let f = fresh_var {| prefix: "_t", counter: state.counter |}
    let st = {| counter: f.counter, slot_counter: state.slot_counter, slots: state.slots, strs: state.strs |}
    let ar = alloc_slot {| name: f.name, state: st |}
    let store = emit_store_slot {| slot: ar.slot, reg: "x0" |}
    {| code: concat {| a: asm_ln {| s: "  bl _runtime_readint" |}, b: store |}, var: f.name, state: ar.state |}
end

fn emit_let_bindings_loop_asm
  case {| bindings, state, code_acc, names_acc |} =>
    match is_nil {| list: bindings |}
      case 1 => {| code: code_acc, state: state, names: names_acc |}
      case 0 =>
        let head = list_head {| list: bindings |}
        let tail = list_tail {| list: bindings |}
        let rv = emit_expr_asm {| node: head.value, state: state |}
        let vs = lookup_slot {| name: rv.var, slots: rv.state.slots |}
        let cn = c_name {| name: head.name |}
        let new_slots = cons {| head: {| name: cn, slot: vs |}, tail: rv.state.slots |}
        let ns = {| counter: rv.state.counter, slot_counter: rv.state.slot_counter, slots: new_slots, strs: rv.state.strs |}
        let new_names = cons {| head: head.name, tail: names_acc |}
        emit_let_bindings_loop_asm {| bindings: tail, state: ns, code_acc: concat {| a: code_acc, b: rv.code |}, names_acc: new_names |}
    end
end

fn emit_let_in_asm
  case {| node, state |} =>
    let chain = collect_let_chain {| node: node |}
    let empty = nil {| |}
    let br = emit_let_bindings_loop_asm {| bindings: chain.bindings, state: state, code_acc: "", names_acc: empty |}
    let rb = emit_expr_asm {| node: chain.body, state: br.state |}
    let release = gen_release_code_asm {| names: br.names, slots: rb.state.slots |}
    let s1 = concat {| a: br.code, b: rb.code |}
    {| code: concat {| a: s1, b: release |}, var: rb.var, state: rb.state |}
end

-- ============================================================
-- AArch64: Pattern Matching
-- ============================================================

fn emit_rec_field_match_asm
  case {| var_slot, field, fail_label, state |} =>
    let n = nl {| |}
    let sr = add_str_asm {| s: field.name, state: state |}
    let tmp = concat {| a: "_f_", b: field.name |}
    let ar = alloc_slot {| name: tmp, state: sr.state |}
    let lr = emit_load_slot {| slot: var_slot, reg: "x0" |}
    let st = emit_store_slot {| slot: ar.slot, reg: "x0" |}
    let s1 = concat {| a: lr, b: "  adrp x1, " |}
    let s2 = concat {| a: s1, b: sr.label |}
    let s3 = concat {| a: s2, b: "@PAGE" |}
    let s4 = concat {| a: s3, b: n |}
    let s5 = concat {| a: s4, b: "  add x1, x1, " |}
    let s6 = concat {| a: s5, b: sr.label |}
    let s7 = concat {| a: s6, b: "@PAGEOFF" |}
    let s8 = concat {| a: s7, b: n |}
    let s9 = concat {| a: s8, b: asm_ln {| s: "  bl _record_field" |} |}
    let s10 = concat {| a: s9, b: st |}
    let s11 = concat {| a: s10, b: "  cbz x0, " |}
    let s12 = concat {| a: s11, b: fail_label |}
    let base = concat {| a: s12, b: n |}
    let cn = c_name {| name: field.name |}
    match field.pat.tag
      case "pat_none" =>
        let ns = cons {| head: {| name: cn, slot: ar.slot |}, tail: ar.state.slots |}
        {| code: base, state: {| counter: ar.state.counter, slot_counter: ar.state.slot_counter, slots: ns, strs: ar.state.strs |} |}
      case "pat_var" =>
        let ns = cons {| head: {| name: cn, slot: ar.slot |}, tail: ar.state.slots |}
        {| code: base, state: {| counter: ar.state.counter, slot_counter: ar.state.slot_counter, slots: ns, strs: ar.state.strs |} |}
      case "pat_wild" =>
        {| code: base, state: ar.state |}
      case _ =>
        let ns = cons {| head: {| name: cn, slot: ar.slot |}, tail: ar.state.slots |}
        let nst = {| counter: ar.state.counter, slot_counter: ar.state.slot_counter, slots: ns, strs: ar.state.strs |}
        let pm = emit_pat_match_asm {| var_slot: ar.slot, pat: field.pat, fail_label: fail_label, state: nst |}
        {| code: concat {| a: base, b: pm.code |}, state: pm.state |}
    end
end

fn emit_rec_pat_loop_asm
  case {| var_slot, fields, fail_label, state, code_acc |} =>
    match is_nil {| list: fields |}
      case 1 => {| code: code_acc, state: state |}
      case 0 =>
        let head = list_head {| list: fields |}
        let tail = list_tail {| list: fields |}
        let r = emit_rec_field_match_asm {| var_slot: var_slot, field: head, fail_label: fail_label, state: state |}
        emit_rec_pat_loop_asm {| var_slot: var_slot, fields: tail, fail_label: fail_label, state: r.state, code_acc: concat {| a: code_acc, b: r.code |} |}
    end
end

fn emit_pat_match_asm
  case {| var_slot, pat, fail_label, state |} =>
    let n = nl {| |}
    match pat.tag
      case "pat_wild" => {| code: "", state: state |}
      case "pat_var" =>
        let cn = c_name {| name: pat.name |}
        let ar = alloc_slot {| name: cn, state: state |}
        let load = emit_load_slot {| slot: var_slot, reg: "x8" |}
        let store = emit_store_slot {| slot: ar.slot, reg: "x8" |}
        {| code: concat {| a: load, b: store |}, state: ar.state |}
      case "pat_int" =>
        let val = str_to_int {| s: pat.value |}
        let load = emit_load_slot {| slot: var_slot, reg: "x8" |}
        let s1 = concat {| a: load, b: "  ldr w9, [x8]" |}
        let s2 = concat {| a: s1, b: n |}
        let s3 = concat {| a: s2, b: "  cmp w9, #0" |}
        let s4 = concat {| a: s3, b: n |}
        let s5 = concat {| a: s4, b: "  b.ne " |}
        let s6 = concat {| a: s5, b: fail_label |}
        let s7 = concat {| a: s6, b: n |}
        let s8 = concat {| a: s7, b: "  ldr x8, [x8, #8]" |}
        let s9 = concat {| a: s8, b: n |}
        let mov = emit_mov_imm {| reg: "x9", n: val |}
        let s10 = concat {| a: s9, b: mov |}
        let s11 = concat {| a: s10, b: "  cmp x8, x9" |}
        let s12 = concat {| a: s11, b: n |}
        let s13 = concat {| a: s12, b: "  b.ne " |}
        let s14 = concat {| a: s13, b: fail_label |}
        {| code: concat {| a: s14, b: n |}, state: state |}
      case "pat_str" =>
        let sr = add_str_asm {| s: pat.value, state: state |}
        let load = emit_load_slot {| slot: var_slot, reg: "x8" |}
        let s1 = concat {| a: load, b: "  ldr w9, [x8]" |}
        let s2 = concat {| a: s1, b: n |}
        let s3 = concat {| a: s2, b: "  cmp w9, #1" |}
        let s4 = concat {| a: s3, b: n |}
        let s5 = concat {| a: s4, b: "  b.ne " |}
        let s6 = concat {| a: s5, b: fail_label |}
        let s7 = concat {| a: s6, b: n |}
        let s8 = concat {| a: s7, b: "  ldr x0, [x8, #8]" |}
        let s9 = concat {| a: s8, b: n |}
        let s10 = concat {| a: s9, b: "  adrp x1, " |}
        let s11 = concat {| a: s10, b: sr.label |}
        let s12 = concat {| a: s11, b: "@PAGE" |}
        let s13 = concat {| a: s12, b: n |}
        let s14 = concat {| a: s13, b: "  add x1, x1, " |}
        let s15 = concat {| a: s14, b: sr.label |}
        let s16 = concat {| a: s15, b: "@PAGEOFF" |}
        let s17 = concat {| a: s16, b: n |}
        let s18 = concat {| a: s17, b: asm_ln {| s: "  bl _strcmp" |} |}
        let s19 = concat {| a: s18, b: "  cbnz w0, " |}
        let s20 = concat {| a: s19, b: fail_label |}
        {| code: concat {| a: s20, b: n |}, state: sr.state |}
      case "pat_rec" =>
        let load = emit_load_slot {| slot: var_slot, reg: "x8" |}
        let s1 = concat {| a: load, b: "  ldr w9, [x8]" |}
        let s2 = concat {| a: s1, b: n |}
        let s3 = concat {| a: s2, b: "  cmp w9, #2" |}
        let s4 = concat {| a: s3, b: n |}
        let s5 = concat {| a: s4, b: "  b.ne " |}
        let s6 = concat {| a: s5, b: fail_label |}
        let s7 = concat {| a: s6, b: n |}
        emit_rec_pat_loop_asm {| var_slot: var_slot, fields: pat.fields, fail_label: fail_label, state: state, code_acc: s7 |}
    end
end

-- ============================================================
-- AArch64: Divine Expression
-- ============================================================

fn emit_match_clause_asm
  case {| scr_slot, dvn_slot, done_label, clause, state |} =>
    let n = nl {| |}
    let fl = fresh_var {| prefix: "Ldvnf", counter: state.counter |}
    let st1 = {| counter: fl.counter, slot_counter: state.slot_counter, slots: state.slots, strs: state.strs |}
    let saved_slots = st1.slots
    let saved_sc = st1.slot_counter
    let pm = emit_pat_match_asm {| var_slot: scr_slot, pat: clause.pat, fail_label: fl.name, state: st1 |}
    let bound = extract_bound_names {| pat: clause.pat |}
    let retain = gen_retain_code_asm {| names: bound, slots: pm.state.slots |}
    let rb = emit_expr_asm {| node: clause.body, state: pm.state |}
    let release = gen_release_code_asm {| names: bound, slots: rb.state.slots |}
    let bs = lookup_slot {| name: rb.var, slots: rb.state.slots |}
    let lb = emit_load_slot {| slot: bs, reg: "x8" |}
    let sd = emit_store_slot {| slot: dvn_slot, reg: "x8" |}
    let s1 = concat {| a: pm.code, b: retain |}
    let s2 = concat {| a: s1, b: rb.code |}
    let s3 = concat {| a: s2, b: release |}
    let s4 = concat {| a: s3, b: lb |}
    let s5 = concat {| a: s4, b: sd |}
    let s6 = concat {| a: s5, b: "  b " |}
    let s7 = concat {| a: s6, b: done_label |}
    let s8 = concat {| a: s7, b: n |}
    let s9 = concat {| a: s8, b: fl.name |}
    let s10 = concat {| a: s9, b: ":" |}
    let code = concat {| a: s10, b: n |}
    {| code: code, state: {| counter: rb.state.counter, slot_counter: saved_sc, slots: saved_slots, strs: rb.state.strs |} |}
end

fn emit_match_clauses_loop_asm
  case {| scr_slot, dvn_slot, done_label, clauses, state, acc |} =>
    match is_nil {| list: clauses |}
      case 1 => {| code: acc, state: state |}
      case 0 =>
        let head = list_head {| list: clauses |}
        let tail = list_tail {| list: clauses |}
        let r = emit_match_clause_asm {| scr_slot: scr_slot, dvn_slot: dvn_slot, done_label: done_label, clause: head, state: state |}
        emit_match_clauses_loop_asm {| scr_slot: scr_slot, dvn_slot: dvn_slot, done_label: done_label, clauses: tail, state: r.state, acc: concat {| a: acc, b: r.code |} |}
    end
end

fn emit_match_asm
  case {| node, state |} =>
    let n = nl {| |}
    let rs = emit_expr_asm {| node: node.scrutinee, state: state |}
    let scr = fresh_var {| prefix: "_scr", counter: rs.state.counter |}
    let st1 = {| counter: scr.counter, slot_counter: rs.state.slot_counter, slots: rs.state.slots, strs: rs.state.strs |}
    let scr_r = alloc_slot {| name: scr.name, state: st1 |}
    let src_s = lookup_slot {| name: rs.var, slots: scr_r.state.slots |}
    let ls = emit_load_slot {| slot: src_s, reg: "x8" |}
    let ss = emit_store_slot {| slot: scr_r.slot, reg: "x8" |}
    let dvn = fresh_var {| prefix: "_dvn", counter: scr_r.state.counter |}
    let st2 = {| counter: dvn.counter, slot_counter: scr_r.state.slot_counter, slots: scr_r.state.slots, strs: scr_r.state.strs |}
    let dvn_r = alloc_slot {| name: dvn.name, state: st2 |}
    let done = fresh_var {| prefix: "Ldone", counter: dvn_r.state.counter |}
    let st3 = {| counter: done.counter, slot_counter: dvn_r.state.slot_counter, slots: dvn_r.state.slots, strs: dvn_r.state.strs |}
    let cr = emit_match_clauses_loop_asm {| scr_slot: scr_r.slot, dvn_slot: dvn_r.slot, done_label: done.name, clauses: node.clauses, state: st3, acc: "" |}
    let mf_sr = add_str_asm {| s: "match", state: cr.state |}
    let mf1 = concat {| a: "  adrp x0, ", b: mf_sr.label |}
    let mf2 = concat {| a: mf1, b: "@PAGE" |}
    let mf3 = concat {| a: mf2, b: n |}
    let mf4 = concat {| a: mf3, b: "  add x0, x0, " |}
    let mf5 = concat {| a: mf4, b: mf_sr.label |}
    let mf6 = concat {| a: mf5, b: "@PAGEOFF" |}
    let mf7 = concat {| a: mf6, b: n |}
    let mf8 = concat {| a: mf7, b: asm_ln {| s: "  bl _stele_match_fail" |} |}
    let rl = emit_load_slot {| slot: scr_r.slot, reg: "x0" |}
    let s1 = concat {| a: rs.code, b: ls |}
    let s2 = concat {| a: s1, b: ss |}
    let s3 = concat {| a: s2, b: cr.code |}
    let s4 = concat {| a: s3, b: mf8 |}
    let s5 = concat {| a: s4, b: done.name |}
    let s6 = concat {| a: s5, b: ":" |}
    let s7 = concat {| a: s6, b: n |}
    let s8 = concat {| a: s7, b: rl |}
    let code = concat {| a: s8, b: asm_ln {| s: "  bl _rc_release" |} |}
    {| code: code, var: dvn.name, state: mf_sr.state |}
end

-- Expression dispatcher (ASM)
fn emit_expr_asm
  case {| node, state |} =>
    match node.tag
      case "int_lit" => emit_int_lit_asm {| node: node, state: state |}
      case "str_lit" => emit_str_lit_asm {| node: node, state: state |}
      case "var" => emit_var_asm {| node: node, state: state |}
      case "binop" => emit_binop_asm {| node: node, state: state |}
      case "unop" => emit_unop_asm {| node: node, state: state |}
      case "field_access" => emit_field_access_asm {| node: node, state: state |}
      case "record" => emit_record_asm {| node: node, state: state |}
      case "named_record" => emit_record_asm {| node: {| tag: "record", fields: node.fields |}, state: state |}
      case "call" => emit_call_asm {| node: node, state: state |}
      case "readln" => emit_readln_asm {| state: state |}
      case "readint" => emit_readint_asm {| state: state |}
      case "let_in" => emit_let_in_asm {| node: node, state: state |}
      case "match" => emit_match_asm {| node: node, state: state |}
    end
end

-- ============================================================
-- AArch64: Rite & Clause Emission
-- ============================================================

fn emit_clause_asm
  case {| clause, clause_id, func_prefix, state |} =>
    let n = nl {| |}
    let cid = int_to_str {| n: clause_id |}
    let fl1 = concat {| a: func_prefix, b: "c" |}
    let fl2 = concat {| a: fl1, b: cid |}
    let fail_label = concat {| a: fl2, b: "f" |}
    let saved_slots = state.slots
    let saved_sc = state.slot_counter
    let arg_slot = lookup_slot {| name: "arg", slots: state.slots |}
    let pm = emit_pat_match_asm {| var_slot: arg_slot, pat: clause.pat, fail_label: fail_label, state: state |}
    let bound = extract_bound_names {| pat: clause.pat |}
    let retain = gen_retain_code_asm {| names: bound, slots: pm.state.slots |}
    let rb = emit_expr_asm {| node: clause.body, state: pm.state |}
    let release = gen_release_code_asm {| names: bound, slots: rb.state.slots |}
    let bs = lookup_slot {| name: rb.var, slots: rb.state.slots |}
    let lr = emit_load_slot {| slot: bs, reg: "x0" |}
    let epi = emit_epilogue {| |}
    let s1 = concat {| a: pm.code, b: retain |}
    let s2 = concat {| a: s1, b: rb.code |}
    let s3 = concat {| a: s2, b: release |}
    let s4 = concat {| a: s3, b: lr |}
    let s5 = concat {| a: s4, b: epi |}
    let s6 = concat {| a: s5, b: fail_label |}
    let s7 = concat {| a: s6, b: ":" |}
    let code = concat {| a: s7, b: n |}
    {| code: code, state: {| counter: rb.state.counter, slot_counter: saved_sc, slots: saved_slots, strs: rb.state.strs |} |}
end

fn emit_clauses_loop_asm
  case {| clauses, clause_id, func_prefix, state, acc |} =>
    match is_nil {| list: clauses |}
      case 1 => {| code: acc, state: state |}
      case 0 =>
        let head = list_head {| list: clauses |}
        let tail = list_tail {| list: clauses |}
        let r = emit_clause_asm {| clause: head, clause_id: clause_id, func_prefix: func_prefix, state: state |}
        emit_clauses_loop_asm {| clauses: tail, clause_id: clause_id + 1, func_prefix: func_prefix, state: r.state, acc: concat {| a: acc, b: r.code |} |}
    end
end

fn emit_fn_asm
  case {| name, clauses, state |} =>
    let n = nl {| |}
    let fp = concat {| a: "fn_", b: name |}
    let fp2 = concat {| a: fp, b: "_" |}
    let pro = emit_prologue {| |}
    let init_s = cons {| head: {| name: "arg", slot: 0 |}, tail: nil {| |} |}
    let fst = {| counter: state.counter, slot_counter: 1, slots: init_s, strs: state.strs |}
    let store_arg = emit_store_slot {| slot: 0, reg: "x0" |}
    let rc = emit_clauses_loop_asm {| clauses: clauses, clause_id: 0, func_prefix: fp2, state: fst, acc: "" |}
    let mf_msg = concat {| a: "fn '", b: name |}
    let mf_msg2 = concat {| a: mf_msg, b: "'" |}
    let mf_sr = add_str_asm {| s: mf_msg2, state: rc.state |}
    let mf1 = concat {| a: "  adrp x0, ", b: mf_sr.label |}
    let mf2 = concat {| a: mf1, b: "@PAGE" |}
    let mf3 = concat {| a: mf2, b: n |}
    let mf4 = concat {| a: mf3, b: "  add x0, x0, " |}
    let mf5 = concat {| a: mf4, b: mf_sr.label |}
    let mf6 = concat {| a: mf5, b: "@PAGEOFF" |}
    let mf7 = concat {| a: mf6, b: n |}
    let mf8 = concat {| a: mf7, b: asm_ln {| s: "  bl _stele_match_fail" |} |}
    let l1 = concat {| a: ".globl _fn_", b: name |}
    let l2 = concat {| a: l1, b: n |}
    let l3 = concat {| a: l2, b: "_fn_" |}
    let l4 = concat {| a: l3, b: name |}
    let l5 = concat {| a: l4, b: ":" |}
    let l6 = concat {| a: l5, b: n |}
    let s1 = concat {| a: l6, b: pro |}
    let s2 = concat {| a: s1, b: store_arg |}
    let s3 = concat {| a: s2, b: rc.code |}
    let s4 = concat {| a: s3, b: mf8 |}
    let code = concat {| a: s4, b: n |}
    {| code: code, state: {| counter: mf_sr.state.counter, slot_counter: state.slot_counter, slots: state.slots, strs: mf_sr.state.strs |} |}
end

-- ============================================================
-- AArch64: Statement & Main Emission
-- ============================================================

fn emit_stmt_asm
  case {| stmt, state |} =>
    match stmt.tag
      case "stmt_let" =>
        let r = emit_expr_asm {| node: stmt.value, state: state |}
        let cn = c_name {| name: stmt.name |}
        let vs = lookup_slot {| name: r.var, slots: r.state.slots |}
        let ns = cons {| head: {| name: cn, slot: vs |}, tail: r.state.slots |}
        {| code: r.code, state: {| counter: r.state.counter, slot_counter: r.state.slot_counter, slots: ns, strs: r.state.strs |} |}
      case "stmt_stele_print" =>
        let r = emit_expr_asm {| node: stmt.value, state: state |}
        let vs = lookup_slot {| name: r.var, slots: r.state.slots |}
        let load = emit_load_slot {| slot: vs, reg: "x0" |}
        let rload = emit_load_slot {| slot: vs, reg: "x0" |}
        let s1 = concat {| a: r.code, b: load |}
        let s2 = concat {| a: s1, b: asm_ln {| s: "  bl _stele_print" |} |}
        let s3 = concat {| a: s2, b: rload |}
        {| code: concat {| a: s3, b: asm_ln {| s: "  bl _rc_release" |} |}, state: r.state |}
      case "stmt_stele_write" =>
        let r = emit_expr_asm {| node: stmt.value, state: state |}
        let vs = lookup_slot {| name: r.var, slots: r.state.slots |}
        let load = emit_load_slot {| slot: vs, reg: "x0" |}
        let rload = emit_load_slot {| slot: vs, reg: "x0" |}
        let s1 = concat {| a: r.code, b: load |}
        let s2 = concat {| a: s1, b: asm_ln {| s: "  bl _stele_write" |} |}
        let s3 = concat {| a: s2, b: rload |}
        {| code: concat {| a: s3, b: asm_ln {| s: "  bl _rc_release" |} |}, state: r.state |}
      case "stmt_expr" =>
        let r = emit_expr_asm {| node: stmt.value, state: state |}
        let vs = lookup_slot {| name: r.var, slots: r.state.slots |}
        let load = emit_load_slot {| slot: vs, reg: "x0" |}
        let s1 = concat {| a: r.code, b: load |}
        {| code: concat {| a: s1, b: asm_ln {| s: "  bl _rc_release" |} |}, state: r.state |}
    end
end

fn emit_stmts_loop_asm
  case {| stmts, state, acc |} =>
    match is_nil {| list: stmts |}
      case 1 => {| code: acc, state: state |}
      case 0 =>
        let head = list_head {| list: stmts |}
        let tail = list_tail {| list: stmts |}
        let r = emit_stmt_asm {| stmt: head, state: state |}
        emit_stmts_loop_asm {| stmts: tail, state: r.state, acc: concat {| a: acc, b: r.code |} |}
    end
end

fn emit_main_fn_asm
  case {| decls, state |} =>
    let n = nl {| |}
    let rit = find_do {| decls: decls, name: "main" |}
    let pro = emit_prologue {| |}
    let ac1 = concat {| a: "  adrp x8, _g_argc@GOTPAGE", b: n |}
    let ac2 = concat {| a: ac1, b: "  ldr x8, [x8, _g_argc@GOTPAGEOFF]" |}
    let ac3 = concat {| a: ac2, b: n |}
    let argc_code = concat {| a: ac3, b: asm_ln {| s: "  str w0, [x8]" |} |}
    let av1 = concat {| a: "  adrp x8, _g_argv@GOTPAGE", b: n |}
    let av2 = concat {| a: av1, b: "  ldr x8, [x8, _g_argv@GOTPAGEOFF]" |}
    let av3 = concat {| a: av2, b: n |}
    let argv_code = concat {| a: av3, b: asm_ln {| s: "  str x1, [x8]" |} |}
    let main_hdr = concat {| a: ".globl _main", b: n |}
    let main_hdr2 = concat {| a: main_hdr, b: "_main:" |}
    let main_hdr3 = concat {| a: main_hdr2, b: n |}
    match rit.tag
      case "none" =>
        let s1 = concat {| a: main_hdr3, b: pro |}
        let s2 = concat {| a: s1, b: argc_code |}
        let s3 = concat {| a: s2, b: argv_code |}
        let s4 = concat {| a: s3, b: asm_ln {| s: "  mov x0, #0" |} |}
        {| code: concat {| a: s4, b: emit_epilogue {| |} |}, state: state |}
      case "some" =>
        let init = nil {| |}
        let fst = {| counter: state.counter, slot_counter: 0, slots: init, strs: state.strs |}
        let rs = emit_stmts_loop_asm {| stmts: rit.stmts, state: fst, acc: "" |}
        let empty = nil {| |}
        let let_names = collect_let_names {| stmts: rit.stmts, acc: empty |}
        let rel = gen_release_code_asm {| names: let_names, slots: rs.state.slots |}
        let s1 = concat {| a: main_hdr3, b: pro |}
        let s2 = concat {| a: s1, b: argc_code |}
        let s3 = concat {| a: s2, b: argv_code |}
        let s4 = concat {| a: s3, b: rs.code |}
        let s5 = concat {| a: s4, b: rel |}
        let s6 = concat {| a: s5, b: asm_ln {| s: "  mov x0, #0" |} |}
        let code = concat {| a: s6, b: emit_epilogue {| |} |}
        {| code: code, state: {| counter: rs.state.counter, slot_counter: state.slot_counter, slots: state.slots, strs: rs.state.strs |} |}
    end
end

-- ============================================================
-- AArch64: Top-Level Pipeline
-- ============================================================

fn emit_decls_loop_asm
  case {| decls, state, acc |} =>
    match is_nil {| list: decls |}
      case 1 => {| code: acc, state: state |}
      case 0 =>
        let head = list_head {| list: decls |}
        let tail = list_tail {| list: decls |}
        let r = match str_eq {| a: head.tag, b: "decl_fn" |}
          case 1 =>
            match is_builtin_fn {| name: head.name |}
              case 1 => {| code: "", state: state |}
              case 0 => emit_fn_asm {| name: head.name, clauses: head.clauses, state: state |}
            end
          case 0 => {| code: "", state: state |}
        end
        emit_decls_loop_asm {| decls: tail, state: r.state, acc: concat {| a: acc, b: r.code |} |}
    end
end

fn emit_string_table_loop
  case {| strs, acc |} =>
    let n = nl {| |}
    match is_nil {| list: strs |}
      case 1 => acc
      case 0 =>
        let head = list_head {| list: strs |}
        let tail = list_tail {| list: strs |}
        let esc = asm_string {| s: head.value |}
        let s1 = concat {| a: head.label, b: ":" |}
        let s2 = concat {| a: s1, b: n |}
        let s3 = concat {| a: s2, b: "  .asciz " |}
        let s4 = concat {| a: s3, b: esc |}
        let line = concat {| a: s4, b: n |}
        emit_string_table_loop {| strs: tail, acc: concat {| a: acc, b: line |} |}
    end
end

fn emit_string_table
  case {| strs |} =>
    let n = nl {| |}
    let reversed = list_reverse {| list: strs |}
    let hdr = concat {| a: n, b: ".section __TEXT,__cstring" |}
    let hdr2 = concat {| a: hdr, b: n |}
    emit_string_table_loop {| strs: reversed, acc: hdr2 |}
end

-- Assemble the complete .s file
fn emit_asm
  case {| decls |} =>
    let n = nl {| |}
    let empty = nil {| |}
    let init_state = {| counter: 0, slot_counter: 0, slots: empty, strs: empty |}
    let fn_defs = emit_decls_loop_asm {| decls: decls, state: init_state, acc: "" |}
    let main_fn = emit_main_fn_asm {| decls: decls, state: fn_defs.state |}
    let str_table = emit_string_table {| strs: main_fn.state.strs |}
    let hdr = concat {| a: ".section __TEXT,__text", b: n |}
    let hdr2 = concat {| a: hdr, b: ".align 2" |}
    let hdr3 = concat {| a: hdr2, b: n |}
    let hdr4 = concat {| a: hdr3, b: n |}
    let s1 = concat {| a: hdr4, b: fn_defs.code |}
    let s2 = concat {| a: s1, b: main_fn.code |}
    concat {| a: s2, b: str_table |}
end

-- ============================================================
-- Main: Compiler Pipeline
-- ============================================================

do main
  let src = unearth {| path: argv {| n: 1 |} |}
  let tokens = tokenize {| src: src |}
  let decls = parse_program {| tokens: tokens |}
  let mode = get_mode {| |}
  let output = match mode
    case 1 => emit_asm {| decls: decls |}
    case 0 => emit_c {| decls: decls |}
  end
  let out_path = argv {| n: 2 |}
  inscribe {| path: out_path, content: output |}
end
