do main
  let s = "hello world"
  print strlen {| s: s |}
  print char_at {| s: s, n: 0 |}
  print char_at {| s: s, n: 4 |}
  print substr {| s: s, start: 0, len: 5 |}
  print concat {| a: "foo", b: "bar" |}
  print int_to_str {| n: 42 |}
  print char_of_int {| n: 65 |}
  print strcmp {| a: "abc", b: "abc" |}
  print strcmp {| a: "abc", b: "def" |}
  print strcmp {| a: "def", b: "abc" |}
  -- Test mod
  print 10 % 3
  print 15 % 5
end
