cabal-version:   3.14
name:            badlang
version:         0.1.0.0
license:         MIT
license-file:    LICENSE
author:          Samuel Schlesinger
maintainer:      sgschlesinger@gmail.com
build-type:      Simple
extra-doc-files: CHANGELOG.md

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        Badlang.PEG
        Badlang.AST
        Badlang.Grammar
        Badlang.Types
        Badlang.Emit
    build-depends:
        base       ^>=4.18.3.0,
        containers >= 0.6,
        array      >= 0.5,
        transformers >= 0.5
    hs-source-dirs:   src
    default-language: Haskell2010

executable badlang
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base       ^>=4.18.3.0,
        badlang,
        process    >= 1.6
    hs-source-dirs:   app
    default-language: Haskell2010
