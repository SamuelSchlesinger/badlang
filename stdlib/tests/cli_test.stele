-- cli_test.stele
-- Test target for stdlib/cli.stele

fn assert_eq
  case {| actual, expected, code |} =>
    match actual == expected
      case 1 => 0
      case 0 =>
        let ignored = terminate {| code: code |}
        0
    end
end

do main
  let t1 = assert_eq {| actual: cli_argc {| |}, expected: 1, code: 10 |}
  let argv0 = cli_argv {| n: 0 |}
  let t2 = assert_eq {| actual: (strlen {| s: argv0 |}) > 0, expected: 1, code: 11 |}
  let t3 = assert_eq {| actual: cli_has_arg {| n: 1 |}, expected: 0, code: 12 |}
  let t4 = assert_eq {| actual: cli_subcommand {| name: "build" |}, expected: 0, code: 13 |}
  let t5 = assert_eq {| actual: cli_flag {| flag: "--help" |}, expected: 0, code: 14 |}
  let mode = cli_opt_value {| key: "--mode", default: "fallback" |}
  let t6 = assert_eq {| actual: cli_str_eq {| a: mode, b: "fallback" |}, expected: 1, code: 15 |}
  print 1
end

