-- strings_test.stele
-- Test target for stdlib/strings.stele

do main
  let t1 = assert_eq_int {| actual: strings_eq {| a: "a", b: "a" |}, expected: 1, code: 60 |}
  let t2 = assert_eq_int {| actual: strings_ne {| a: "a", b: "b" |}, expected: 1, code: 61 |}
  let t3 = assert_eq_int {| actual: strings_starts_with {| s: "stele", prefix: "ste" |}, expected: 1, code: 62 |}
  let t4 = assert_eq_int {| actual: strings_ends_with {| s: "stele", suffix: "ele" |}, expected: 1, code: 63 |}
  let t5 = assert_eq_int {| actual: strings_index_of {| s: "abcdef", needle: "cd" |}, expected: 2, code: 64 |}
  let t6 = assert_eq_int {| actual: strings_index_of {| s: "abcdef", needle: "zz" |}, expected: 0 - 1, code: 65 |}
  let t7 = assert_eq_int {| actual: strings_contains {| s: "abcdef", needle: "bc" |}, expected: 1, code: 66 |}
  let t8 = assert_eq_str {| actual: strings_join2 {| a: "a", b: "b", sep: "-" |}, expected: "a-b", code: 67 |}
  let t9 = assert_eq_str {| actual: strings_trim_left {| s: "   x" |}, expected: "x", code: 68 |}
  let t10 = assert_eq_str {| actual: strings_trim_right {| s: "x   " |}, expected: "x", code: 69 |}
  let t11 = assert_eq_str {| actual: strings_trim {| s: "  x  " |}, expected: "x", code: 70 |}
  print 1
end

