end

fn fail_add_opts
  case {| msg, opts |} =>
    let ignored1 = echo_line {| msg: msg |}
    let ignored2 = terminate {| code: 1 |}
    opts
end

fn parse_add_opts_loop
  case {| i, ac, opts |} =>
    match i >= ac
      case 1 => opts
      case 0 =>
        let arg1 = argv {| n: i |}
        match str_eq {| a: arg1, b: "--ref" |}
          case 1 =>
            match (i + 1) < ac
              case 1 =>
                let val = argv {| n: i + 1 |}
                let next = add_opts_set_ref {| opts: opts, ref: val |}
                parse_add_opts_loop {| i: i + 2, ac: ac, opts: next |}
              case 0 =>
                fail_add_opts {| msg: "stela: missing value for --ref", opts: opts |}
            end
          case 0 =>
            match str_eq {| a: arg1, b: "--manifest" |}
              case 1 =>
                match (i + 1) < ac
                  case 1 =>
                    let val = argv {| n: i + 1 |}
                    let next = add_opts_set_manifest {| opts: opts, manifest: val |}
                    parse_add_opts_loop {| i: i + 2, ac: ac, opts: next |}
                  case 0 =>
                    fail_add_opts {| msg: "stela: missing value for --manifest", opts: opts |}
                end
              case 0 =>
                match str_eq {| a: arg1, b: "--major" |}
                  case 1 =>
                    match (i + 1) < ac
                      case 1 =>
                        let val = argv {| n: i + 1 |}
                        match is_digits {| s: val |}
                          case 1 =>
                            let next = add_opts_set_major {| opts: opts, major: val |}
                            parse_add_opts_loop {| i: i + 2, ac: ac, opts: next |}
                          case 0 =>
                            fail_add_opts {| msg: "stela: --major expects digits only", opts: opts |}
                        end
                      case 0 =>
                        fail_add_opts {| msg: "stela: missing value for --major", opts: opts |}
                    end
                  case 0 =>
                    match starts_with {| s: arg1, prefix: "--" |}
                      case 1 =>
                        let m1 = concat {| a: "stela: unknown option ", b: arg1 |}
                        fail_add_opts {| msg: m1, opts: opts |}
                      case 0 =>
                        match opts.has_dep_name
                          case 0 =>
                            let next = add_opts_set_name {| opts: opts, dep_name: arg1 |}
                            parse_add_opts_loop {| i: i + 1, ac: ac, opts: next |}
                          case 1 =>
                            match opts.has_dep_source
                              case 0 =>
                                let next = add_opts_set_source {| opts: opts, dep_source: arg1 |}
                                parse_add_opts_loop {| i: i + 1, ac: ac, opts: next |}
                              case 1 =>
                                let m1 = concat {| a: "stela: unexpected extra argument ", b: arg1 |}
                                fail_add_opts {| msg: m1, opts: opts |}
                            end
                        end
                    end
                end
            end
        end
    end
end

fn add_action
  case {| ac |} =>
    let parsed = parse_add_opts_loop {| i: 2, ac: ac, opts: add_opts_default {| |} |}
    let checked_name = match parsed.has_dep_name
      case 1 => parsed
      case 0 =>
        fail_add_opts {| msg: "stela: add requires <name> <git-url-or-path>", opts: parsed |}
    end
    let checked = match checked_name.has_dep_source
      case 1 => checked_name
      case 0 =>
        fail_add_opts {| msg: "stela: add requires <name> <git-url-or-path>", opts: checked_name |}
    end
    let dep_major = match checked.has_major
      case 1 => checked.major
      case 0 => "1"
    end
    let manifest = load_manifest {| path: checked.manifest |}
    let dep = {|
      ok: 1,
      name: checked.dep_name,
      source: checked.dep_source,
      ref: checked.ref,
      major: dep_major
    |}
    let deps2 = dep_upsert {| deps: manifest.deps, dep: dep |}
    let mf2 = manifest_set_deps {| mf: manifest, deps: deps2 |}
    let body = manifest_render {| mf: mf2 |}
    let ignored_write = inscribe {| path: checked.manifest, content: body |}
    let m1 = concat {| a: "Added dependency ", b: dep_key {| dep: dep |} |}
    let ignored1 = echo_line {| msg: m1 |}
    install_action {| manifest_path: checked.manifest |}
end

fn replace_action
  case {| ac |} =>
    let parsed = parse_add_opts_loop {| i: 2, ac: ac, opts: add_opts_default {| |} |}
    let checked_name = match parsed.has_dep_name
      case 1 => parsed
      case 0 =>
        fail_add_opts {| msg: "stela: replace requires <name> <git-url-or-path>", opts: parsed |}
    end
    let checked = match checked_name.has_dep_source
      case 1 => checked_name
      case 0 =>
        fail_add_opts {| msg: "stela: replace requires <name> <git-url-or-path>", opts: checked_name |}
    end
    let dep_major = match checked.has_major
      case 1 => checked.major
      case 0 => "1"
    end
    let manifest = load_manifest {| path: checked.manifest |}
    let dep = {|
      ok: 1,
      name: checked.dep_name,
      source: checked.dep_source,
      ref: checked.ref,
      major: dep_major
    |}
    let replaces2 = dep_upsert {| deps: manifest.replaces, dep: dep |}
    let mf2 = manifest_set_replaces {| mf: manifest, replaces: replaces2 |}
    let body = manifest_render {| mf: mf2 |}
    let ignored_write = inscribe {| path: checked.manifest, content: body |}
    let m1 = concat {| a: "Set replacement for ", b: dep_key {| dep: dep |} |}
    let ignored1 = echo_line {| msg: m1 |}
    install_action {| manifest_path: checked.manifest |}
end

fn canonicalize_dep_lines_loop
  case {| lines, acc |} =>
    let part = split_first_line {| lines: lines |}
    match part.has
      case 0 => acc
      case 1 =>
        let line = trim {| s: part.head |}
        let llen = strlen {| s: line |}
        match llen == 0
          case 1 =>
            canonicalize_dep_lines_loop {| lines: part.tail, acc: acc |}
          case 0 =>
            let dep = dep_require_valid {| spec: line |}
            let acc2 = dep_upsert {| deps: acc, dep: dep |}
            canonicalize_dep_lines_loop {| lines: part.tail, acc: acc2 |}
        end
    end
end

fn tidy_action
  case {| manifest_path |} =>
    let manifest = load_manifest {| path: manifest_path |}
    let deps2 = canonicalize_dep_lines_loop {| lines: manifest.deps, acc: "" |}
    let replaces2 = canonicalize_dep_lines_loop {| lines: manifest.replaces, acc: "" |}
    let mf1 = manifest_set_deps {| mf: manifest, deps: deps2 |}
    let mf2 = manifest_set_replaces {| mf: mf1, replaces: replaces2 |}
    let body = manifest_render {| mf: mf2 |}
    let ignored_write = inscribe {| path: manifest_path, content: body |}
    let m1 = concat {| a: "Tidied manifest ", b: manifest_path |}
    let ignored1 = echo_line {| msg: m1 |}
    install_action {| manifest_path: manifest_path |}
end

fn path_to_arrow_loop
  case {| lines, acc |} =>
    let part = split_first_line {| lines: lines |}
    match part.has
      case 0 => acc
      case 1 =>
        let item = trim {| s: part.head |}
        let ilen = strlen {| s: item |}
        match ilen == 0
          case 1 =>
            path_to_arrow_loop {| lines: part.tail, acc: acc |}
          case 0 =>
            let acc2 = match strlen {| s: acc |} == 0
              case 1 => item
              case 0 =>
                let s1 = concat {| a: acc, b: " -> " |}
                concat {| a: s1, b: item |}
            end
            path_to_arrow_loop {| lines: part.tail, acc: acc2 |}
        end
    end
end

fn find_dep_path_for_dep
  case {| dep, target_key, root_replaces, path, active |} =>
    let dep_id = dep_key {| dep: dep |}
    let path2 = append_line {| lines: path, line: dep_id |}
    match str_eq {| a: dep_id, b: target_key |}
      case 1 => {| found: 1, path: path2 |}
      case 0 =>
        match line_list_contains {| lines: active, target: dep_id |}
          case 1 => {| found: 0, path: "" |}
          case 0 =>
            let repo_dir = repo_dir_for {| name: dep_storage_key {| dep: dep |} |}
            let ignored_sync = sync_repo_for_dep {| dep: dep, repo_dir: repo_dir |}
            let pkg_path = path_join {| a: repo_dir, b: "stela.pkg" |}
            let pkg = load_manifest {| path: pkg_path |}
            let active2 = append_line {| lines: active, line: dep_id |}
            find_dep_path_in_list {| deps: pkg.deps, target_key: target_key, root_replaces: root_replaces, path: path2, active: active2 |}
        end
    end
end

fn find_dep_path_in_list
  case {| deps, target_key, root_replaces, path, active |} =>
    let part = split_first_line {| lines: deps |}
    match part.has
      case 0 => {| found: 0, path: "" |}
      case 1 =>
        let line = trim {| s: part.head |}
        let llen = strlen {| s: line |}
        match llen == 0
          case 1 =>
            find_dep_path_in_list {| deps: part.tail, target_key: target_key, root_replaces: root_replaces, path: path, active: active |}
          case 0 =>
            let dep0 = dep_require_valid {| spec: line |}
            let dep = apply_replace_for_dep {| dep: dep0, root_replaces: root_replaces |}
            let found_here = find_dep_path_for_dep {| dep: dep, target_key: target_key, root_replaces: root_replaces, path: path, active: active |}
            match found_here.found
              case 1 => found_here
              case 0 =>
                find_dep_path_in_list {| deps: part.tail, target_key: target_key, root_replaces: root_replaces, path: path, active: active |}
            end
        end
    end
end

fn why_action
  case {| opts |} =>
    let ignored1 = ensure_git_available {| |}
    let ignored2 = ensure_pkg_dirs {| |}
    let target_major = match opts.has_major
      case 1 => opts.major
      case 0 => "1"
    end
    let ignored_major = match is_digits {| s: target_major |}
      case 1 => 0
      case 0 =>
        let ignored1 = echo_line {| msg: "stela: why --major expects digits only" |}
        let ignored2 = terminate {| code: 1 |}
        0
    end
    let manifest = load_manifest {| path: opts.manifest |}
    let root_key = dep_key_fields {| name: manifest.name, major: manifest.major |}
    let target_key = dep_key_fields {| name: opts.source, major: target_major |}
    match str_eq {| a: target_key, b: root_key |}
      case 1 =>
        let m1 = concat {| a: "Target is the root module: ", b: root_key |}
        let ignored = echo_line {| msg: m1 |}
        0
      case 0 =>
        let path0 = root_key
        let found = find_dep_path_in_list {| deps: manifest.deps, target_key: target_key, root_replaces: manifest.replaces, path: path0, active: root_key |}
        match found.found
          case 1 =>
            let p = path_to_arrow_loop {| lines: found.path, acc: "" |}
            let m1 = concat {| a: "Why ", b: target_key |}
            let m2 = concat {| a: m1, b: ":" |}
            let ignored1 = echo_line {| msg: m2 |}
            let ignored2 = echo_line {| msg: p |}
            0
          case 0 =>
            let m1 = concat {| a: "stela: no dependency path to ", b: target_key |}
            let ignored1 = echo_line {| msg: m1 |}
            let ignored2 = terminate {| code: 1 |}
            0
        end
    end
end

fn echo_graph_lines
  case {| deps |} =>
    let part = split_first_line {| lines: deps |}
    match part.has
      case 0 => 0
      case 1 =>
        let line = trim {| s: part.head |}
        let llen = strlen {| s: line |}
        let ignored = match llen == 0
          case 1 => 0
          case 0 =>
            let dep = parse_dep_spec {| spec: line |}
            match dep.ok
              case 1 =>
                let ref = dep_ref_or_head {| dep: dep |}
                let dep_id = dep_key {| dep: dep |}
                let s1 = concat {| a: "  - ", b: dep_id |}
                let s2 = concat {| a: s1, b: " => " |}
                let s3 = concat {| a: s2, b: dep.source |}
                let s4 = concat {| a: s3, b: " @ " |}
                let s5 = concat {| a: s4, b: ref |}
                let ignored1 = echo_line {| msg: s5 |}
                0
              case 0 =>
                let s1 = concat {| a: "  - (invalid) ", b: line |}
                let ignored1 = echo_line {| msg: s1 |}
                0
            end
        end
        let ignored2 = echo_graph_lines {| deps: part.tail |}
        0
    end
end

fn echo_lock_lines
  case {| lines |} =>
    let part = split_first_line {| lines: lines |}
    match part.has
      case 0 => 0
      case 1 =>
        let line = trim {| s: part.head |}
        let llen = strlen {| s: line |}
        let ignored = match llen == 0
          case 1 => 0
          case 0 =>
            match starts_with {| s: line, prefix: "dep=" |}
              case 1 =>
                let s = substr {| s: line, start: 4, len: llen - 4 |}
                let p1 = concat {| a: "  * ", b: s |}
                let ignored1 = echo_line {| msg: p1 |}
                0
              case 0 => 0
            end
        end
        let ignored2 = echo_lock_lines {| lines: part.tail |}
        0
    end
end

fn graph_action
  case {| manifest_path |} =>
    let manifest = load_manifest {| path: manifest_path |}
    let h1 = concat {| a: "Project ", b: manifest.name |}
    let h2 = concat {| a: h1, b: " (" |}
    let h3 = concat {| a: h2, b: manifest.kind |}
    let h4 = concat {| a: h3, b: ")" |}
    let ignored1 = echo_line {| msg: h4 |}
    let ignored2 = echo_line {| msg: "Dependencies:" |}
    let ignored3 = echo_graph_lines {| deps: manifest.deps |}
    let has_replaces = strlen {| s: trim {| s: manifest.replaces |} |}
    let ignored_replaces = match has_replaces > 0
      case 1 =>
        let ignored1 = echo_line {| msg: "Replacements:" |}
        let ignored2 = echo_graph_lines {| deps: manifest.replaces |}
        0
      case 0 => 0
    end
    match file_exists {| path: lock_path {| |} |}
      case 1 =>
        let ignored4 = echo_line {| msg: "Resolved lockfile entries:" |}
        let content = unearth {| path: lock_path {| |} |}
        let ignored5 = echo_lock_lines {| lines: content |}
        0
      case 0 =>
        let ignored4 = echo_line {| msg: "No lockfile yet. Run stela install." |}
        0
    end
end

fn with_auto_dep_bundle
  case {| opts |} =>
    let bundle = dep_bundle_path {| |}
    match file_exists {| path: bundle |}
      case 1 =>
        set_libs {| opts: opts, libs: append_word {| words: opts.libs, word: bundle |} |}
      case 0 => opts
    end
end

fn sandbox_available
  case {| |} =>
    let has_bin = sh {| command: "command -v sandbox-exec >/dev/null 2>&1" |}
    match has_bin == 0
      case 1 =>
        let probe = sh {| command: "sandbox-exec -p '(version 1) (allow default)' /usr/bin/true >/dev/null 2>&1" |}
        match probe == 0
          case 1 => 1
          case 0 => 0
        end
      case 0 => 0
    end
end

fn sandbox_policy
  case {| |} =>
    "(version 1)\n(deny default)\n(import \"system.sb\")\n(allow process*)\n(allow file-read*)\n(allow file-write* (subpath \"./target\") (subpath \"/tmp\") (literal \"./.stela.sb\"))\n"
end

fn wrap_cmd
  case {| cmd, use_sandbox |} =>
    match use_sandbox
      case 1 =>
        let prefix = "sandbox-exec -f .stela.sb"
        with_space {| a: prefix, b: cmd |}
      case 0 => cmd
    end
end

fn run_cmd_or_die
  case {| cmd, label |} =>
    let rc = sh {| command: cmd |}
    match rc == 0
      case 1 => 0
      case 0 =>
        let m1 = concat {| a: "stela: failed ", b: label |}
        let m2 = concat {| a: m1, b: " with command: " |}
        let m3 = concat {| a: m2, b: cmd |}
        let ignored1 = echo_line {| msg: m3 |}
        let ignored2 = terminate {| code: 1 |}
        0
    end
end

fn build_compile_cmd
  case {| opts, in_src, out_src |} =>
    match str_eq {| a: opts.mode, b: "c" |}
      case 1 =>
        join3 {| a: opts.compiler, b: in_src, c: out_src |}
      case 0 =>
        join4 {| a: opts.compiler, b: in_src, c: out_src, d: opts.mode |}
    end
end

fn build_link_cmd
  case {| opts, out_src, out_bin |} =>
    match str_eq {| a: opts.mode, b: "c" |}
      case 1 =>
        join5 {| a: "cc", b: "-O1", c: "-o", d: out_bin, e: out_src |}
      case 0 =>
        let runtime = runtime_for_mode {| mode: opts.mode |}
        match str_eq {| a: opts.mode, b: "x86" |}
          case 1 =>
            join8 {| a: "cc", b: "-O1", c: "-arch", d: "x86_64", e: "-o", f: out_bin, g: out_src, h: runtime |}
          case 0 =>
            join6 {| a: "cc", b: "-O1", c: "-o", d: out_bin, e: out_src, f: runtime |}
        end
    end
end

fn ensure_target_dir
  case {| |} =>
    run_cmd_or_die {| cmd: "mkdir -p target/debug", label: "create target/debug" |}
end

fn ensure_lib_dir
  case {| |} =>
    run_cmd_or_die {| cmd: "mkdir -p .stela/lib", label: "create .stela/lib" |}
end

fn materialize_with_libs
  case {| opts, out_path, label |} =>
    let inputs = append_word {| words: opts.libs, word: opts.source |}
    let c1 = concat {| a: "cat ", b: inputs |}
    let c2 = concat {| a: c1, b: " > " |}
    let cmd = concat {| a: c2, b: out_path |}
    run_cmd_or_die {| cmd: cmd, label: label |}
end

fn prepare_build_source
  case {| opts |} =>
    let llen = strlen {| s: opts.libs |}
    match llen == 0
      case 1 => opts.source
      case 0 =>
        let base = basename_no_ext {| path: opts.source |}
        let p1 = concat {| a: target_dir {| |}, b: "/.combo_" |}
        let p2 = concat {| a: p1, b: base |}
        let combo = concat {| a: p2, b: ".stele" |}
        let ignored = materialize_with_libs {| opts: opts, out_path: combo, label: "merge libraries" |}
        combo
    end
end

fn effective_sandbox
  case {| requested |} =>
    match requested
      case 1 =>
        let has_sb = sandbox_available {| |}
        match has_sb
          case 1 => 1
          case 0 =>
            let ignored = echo_line {| msg: "stela: sandbox unavailable; running unsandboxed" |}
            0
        end
      case 0 => 0
    end
end

fn validate_mode
  case {| mode |} =>
    match mode_is_valid {| mode: mode |}
      case 1 => 0
      case 0 =>
        let m1 = concat {| a: "stela: unknown mode ", b: mode |}
        let ignored1 = echo_line {| msg: m1 |}
        let ignored2 = echo_line {| msg: "stela: expected one of c, asm, asm-linux, x86, x86-linux" |}
        let ignored3 = terminate {| code: 1 |}
        0
    end
end

fn build_action
  case {| opts, run_after |} =>
    let opts2 = with_auto_dep_bundle {| opts: opts |}
    let ignored1 = validate_mode {| mode: opts2.mode |}
    let ignored2 = ensure_target_dir {| |}
    let use_sb = effective_sandbox {| requested: opts2.sandbox |}
    let ignored_policy = match use_sb
      case 1 =>
        let ignored = inscribe {| path: ".stela.sb", content: sandbox_policy {| |} |}
        0
      case 0 =>
        0
    end
    let in_src = prepare_build_source {| opts: opts2 |}
    let out_src = output_source_path {| source: opts2.source, mode: opts2.mode |}
    let out_bin = output_binary_path {| source: opts2.source |}
    let compile_cmd = build_compile_cmd {| opts: opts2, in_src: in_src, out_src: out_src |}
    let compile_cmd2 = wrap_cmd {| cmd: compile_cmd, use_sandbox: use_sb |}
    let ignored3 = run_cmd_or_die {| cmd: compile_cmd2, label: "compile" |}
    let link_cmd = build_link_cmd {| opts: opts2, out_src: out_src, out_bin: out_bin |}
    let link_cmd2 = wrap_cmd {| cmd: link_cmd, use_sandbox: use_sb |}
    let ignored4 = run_cmd_or_die {| cmd: link_cmd2, label: "link" |}
    let m1 = concat {| a: "Built ", b: out_bin |}
    let ignored5 = echo_line {| msg: m1 |}
    match run_after == 1
      case 1 =>
        let ignored = run_cmd_or_die {| cmd: out_bin, label: "run" |}
        0
      case 0 =>
        match run_after == 2
          case 1 =>
            let ignored1 = run_cmd_or_die {| cmd: out_bin, label: "test" |}
            let ignored2 = echo_line {| msg: "Test passed" |}
            0
          case 0 =>
            match run_after == 3
              case 1 =>
                let bench_cmd = concat {| a: "/usr/bin/time -p ", b: out_bin |}
                let ignored1 = run_cmd_or_die {| cmd: bench_cmd, label: "bench" |}
                0
              case 0 => 0
            end
        end
    end
end

fn check_action
  case {| opts |} =>
    let opts2 = with_auto_dep_bundle {| opts: opts |}
    let ignored1 = validate_mode {| mode: opts2.mode |}
    let ignored2 = ensure_target_dir {| |}
    let use_sb = effective_sandbox {| requested: opts2.sandbox |}
    let ignored_policy = match use_sb
      case 1 =>
        let ignored = inscribe {| path: ".stela.sb", content: sandbox_policy {| |} |}
        0
      case 0 =>
        0
    end
    let in_src = prepare_build_source {| opts: opts2 |}
    let out_src = check_source_path {| source: opts2.source, mode: opts2.mode |}
    let compile_cmd = build_compile_cmd {| opts: opts2, in_src: in_src, out_src: out_src |}
    let compile_cmd2 = wrap_cmd {| cmd: compile_cmd, use_sandbox: use_sb |}
    let ignored3 = run_cmd_or_die {| cmd: compile_cmd2, label: "check" |}
    let m1 = concat {| a: "Checked ", b: opts2.source |}
    let ignored4 = echo_line {| msg: m1 |}
    0
end

fn package_lib_action
  case {| opts |} =>
    let ignored1 = ensure_lib_dir {| |}
    let lib_name = default_lib_name {| opts: opts |}
    let p1 = concat {| a: ".stela/lib/", b: lib_name |}
    let out_path = concat {| a: p1, b: ".stelib" |}
    let ignored2 = materialize_with_libs {| opts: opts, out_path: out_path, label: "package library" |}
    let m1 = concat {| a: "Packaged library ", b: lib_name |}
    let m2 = concat {| a: m1, b: " -> " |}
    let m3 = concat {| a: m2, b: out_path |}
    let ignored3 = echo_line {| msg: m3 |}
    0
end

fn clean_action
  case {| |} =>
    let ignored = sh {| command: "rm -rf target" |}
    let ignored2 = echo_line {| msg: "Removed target/" |}
    0
end

fn usage
  case {| |} =>
    let ignored1 = echo_line {| msg: "stela - self-hosted Stele build + package manager" |}
    let ignored2 = echo_line {| msg: "Usage:" |}
    let ignored3 = echo_line {| msg: "  stela build <source.stele> [--lib <name> ...] [--compiler <path>] [--mode <c|asm|asm-linux|x86|x86-linux>] [--sandbox|--no-sandbox]" |}
    let ignored4 = echo_line {| msg: "  stela run   <source.stele> [--lib <name> ...] [--compiler <path>] [--mode <c|asm|asm-linux|x86|x86-linux>] [--sandbox|--no-sandbox]" |}
    let ignored5 = echo_line {| msg: "  stela check <source.stele> [--lib <name> ...] [--compiler <path>] [--mode <c|asm|asm-linux|x86|x86-linux>] [--sandbox|--no-sandbox]" |}
    let ignored6 = echo_line {| msg: "  stela test  <source.stele> [--lib <name> ...] [--compiler <path>] [--mode <c|asm|asm-linux|x86|x86-linux>] [--sandbox|--no-sandbox]" |}
    let ignored7 = echo_line {| msg: "  stela bench <source.stele> [--lib <name> ...] [--compiler <path>] [--mode <c|asm|asm-linux|x86|x86-linux>] [--sandbox|--no-sandbox]" |}
    let ignored8 = echo_line {| msg: "  stela package-lib <source.stele> [--lib <name> ...] [--name <name>]" |}
    let ignored9 = echo_line {| msg: "  stela init [--name <name>] [--entry <entry.stele>] [--kind <app|lib>] [--major <n>] [--manifest <path>]" |}
    let ignored10 = echo_line {| msg: "  stela add <name> <git-url-or-path> [--ref <git-ref>] [--major <n>] [--manifest <path>]" |}
    let ignored11 = echo_line {| msg: "  stela replace <name> <git-url-or-path> [--ref <git-ref>] [--major <n>] [--manifest <path>]" |}
    let ignored12 = echo_line {| msg: "  stela install [--manifest <path>]" |}
    let ignored13 = echo_line {| msg: "  stela lock [--manifest <path>]" |}
    let ignored14 = echo_line {| msg: "  stela graph [--manifest <path>]" |}
    let ignored15 = echo_line {| msg: "  stela tidy [--manifest <path>]" |}
    let ignored16 = echo_line {| msg: "  stela why <module> [--major <n>] [--manifest <path>]" |}
    let ignored17 = echo_line {| msg: "  stela clean" |}
    let ignored18 = echo_line {| msg: "" |}
    let ignored19 = echo_line {| msg: "Manifest format (stela.pkg):" |}
    let ignored20 = echo_line {| msg: "  name=<package-name>" |}
    let ignored21 = echo_line {| msg: "  entry=<entry.stele>" |}
    let ignored22 = echo_line {| msg: "  kind=<app|lib>" |}
    let ignored23 = echo_line {| msg: "  major=<n>" |}
    let ignored24 = echo_line {| msg: "  dep=<alias>|<git-url-or-path>|<git-ref>|<major>" |}
    let ignored25 = echo_line {| msg: "  replace=<alias>|<git-url-or-path>|<git-ref>|<major>" |}
    0
end

do main
  let ac = argc {| |}
  match ac >= 2
    case 1 =>
      let cmd = argv {| n: 1 |}
      match str_eq {| a: cmd, b: "build" |}
        case 1 =>
          let opts0 = default_opts {| |}
          let parsed = parse_opts_loop {| i: 2, ac: ac, opts: opts0 |}
          let opts = require_source {| opts: parsed |}
          build_action {| opts: opts, run_after: 0 |}
        case 0 =>
          match str_eq {| a: cmd, b: "run" |}
            case 1 =>
              let opts0 = default_opts {| |}
              let parsed = parse_opts_loop {| i: 2, ac: ac, opts: opts0 |}
              let opts = require_source {| opts: parsed |}
              build_action {| opts: opts, run_after: 1 |}
            case 0 =>
              match str_eq {| a: cmd, b: "test" |}
                case 1 =>
                  let opts0 = default_opts {| |}
                  let parsed = parse_opts_loop {| i: 2, ac: ac, opts: opts0 |}
                  let opts = require_source {| opts: parsed |}
                  build_action {| opts: opts, run_after: 2 |}
                case 0 =>
                  match str_eq {| a: cmd, b: "bench" |}
                    case 1 =>
                      let opts0 = default_opts {| |}
                      let parsed = parse_opts_loop {| i: 2, ac: ac, opts: opts0 |}
                      let opts = require_source {| opts: parsed |}
                      build_action {| opts: opts, run_after: 3 |}
                    case 0 =>
                      match str_eq {| a: cmd, b: "check" |}
                        case 1 =>
                          let opts0 = default_opts {| |}
                          let parsed = parse_opts_loop {| i: 2, ac: ac, opts: opts0 |}
                          let opts = require_source {| opts: parsed |}
                          check_action {| opts: opts |}
                        case 0 =>
                          match str_eq {| a: cmd, b: "package-lib" |}
                            case 1 =>
                              let opts0 = default_opts {| |}
                              let parsed = parse_opts_loop {| i: 2, ac: ac, opts: opts0 |}
                              let opts = require_source {| opts: parsed |}
                              package_lib_action {| opts: opts |}
                            case 0 =>
                              match str_eq {| a: cmd, b: "init" |}
                                case 1 =>
                                  let opts0 = default_opts {| |}
                                  let opts = parse_opts_loop {| i: 2, ac: ac, opts: opts0 |}
                                  init_action {| opts: opts |}
                                case 0 =>
                                  match str_eq {| a: cmd, b: "add" |}
                                    case 1 =>
                                      add_action {| ac: ac |}
                                    case 0 =>
                                      match str_eq {| a: cmd, b: "replace" |}
                                        case 1 =>
                                          replace_action {| ac: ac |}
                                        case 0 =>
                                          match str_eq {| a: cmd, b: "install" |}
                                            case 1 =>
                                              let opts0 = default_opts {| |}
                                              let opts = parse_opts_loop {| i: 2, ac: ac, opts: opts0 |}
                                              install_action {| manifest_path: opts.manifest |}
                                            case 0 =>
                                              match str_eq {| a: cmd, b: "lock" |}
                                                case 1 =>
                                                  let opts0 = default_opts {| |}
                                                  let opts = parse_opts_loop {| i: 2, ac: ac, opts: opts0 |}
                                                  install_action {| manifest_path: opts.manifest |}
                                                case 0 =>
                                                  match str_eq {| a: cmd, b: "graph" |}
                                                    case 1 =>
                                                      let opts0 = default_opts {| |}
                                                      let opts = parse_opts_loop {| i: 2, ac: ac, opts: opts0 |}
                                                      graph_action {| manifest_path: opts.manifest |}
                                                    case 0 =>
                                                      match str_eq {| a: cmd, b: "tidy" |}
                                                        case 1 =>
                                                          let opts0 = default_opts {| |}
                                                          let opts = parse_opts_loop {| i: 2, ac: ac, opts: opts0 |}
                                                          tidy_action {| manifest_path: opts.manifest |}
                                                        case 0 =>
                                                          match str_eq {| a: cmd, b: "why" |}
                                                            case 1 =>
                                                              let opts0 = default_opts {| |}
                                                              let parsed = parse_opts_loop {| i: 2, ac: ac, opts: opts0 |}
                                                              let opts = require_source {| opts: parsed |}
                                                              why_action {| opts: opts |}
                                                            case 0 =>
                                                              match str_eq {| a: cmd, b: "clean" |}
                                                                case 1 =>
                                                                  match ac == 2
                                                                    case 1 => clean_action {| |}
                                                                    case 0 =>
                                                                      let ignored1 = usage {| |}
                                                                      let ignored2 = terminate {| code: 1 |}
                                                                      0
                                                                  end
                                                                case 0 =>
                                                                  let ignored1 = usage {| |}
                                                                  let ignored2 = terminate {| code: 1 |}
                                                                  0
                                                              end
                                                          end
                                                      end
                                                  end
                                              end
                                          end
                                      end
                                  end
                              end
                          end
                      end
                  end
              end
          end
      end
    case 0 =>
      let ignored1 = usage {| |}
      let ignored2 = terminate {| code: 1 |}
      0
  end
end
