-- stela: self-hosted build + package manager for Stele projects
--
-- Core commands:
--   stela build <source.stele> [--lib <name> ...] [--compiler <path>] [--mode <c|asm|asm-linux|x86|x86-linux>] [--sandbox|--no-sandbox]
--   stela run   <source.stele> [--lib <name> ...] [--compiler <path>] [--mode <c|asm|asm-linux|x86|x86-linux>] [--sandbox|--no-sandbox]
--   stela check <source.stele> [--lib <name> ...] [--compiler <path>] [--mode <c|asm|asm-linux|x86|x86-linux>] [--sandbox|--no-sandbox]
--   stela test  <source.stele> [--lib <name> ...] [--compiler <path>] [--mode <c|asm|asm-linux|x86|x86-linux>] [--sandbox|--no-sandbox]
--   stela bench <source.stele> [--lib <name> ...] [--compiler <path>] [--mode <c|asm|asm-linux|x86|x86-linux>] [--sandbox|--no-sandbox]
--   stela package-lib <source.stele> [--lib <name> ...] [--name <name>]
--   stela init [--name <name>] [--entry <entry.stele>] [--kind <app|lib>] [--major <n>] [--manifest <path>]
--   stela add <module> <git-url-or-path> [--ref <git-ref>] [--major <n>] [--manifest <path>]
--   stela replace <module> <git-url-or-path> [--ref <git-ref>] [--major <n>] [--manifest <path>]
--   stela install [--manifest <path>]
--   stela lock [--manifest <path>]
--   stela graph [--manifest <path>]
--   stela tidy [--manifest <path>]
--   stela why <module> [--major <n>] [--manifest <path>]
--   stela clean

fn str_eq
  case {| a, b |} =>
    match strcmp {| a: a, b: b |}
      case 0 => 1
      case _ => 0
    end
end

fn starts_with
  case {| s, prefix |} =>
    let plen = strlen {| s: prefix |}
    let slen = strlen {| s: s |}
    match slen >= plen
      case 0 => 0
      case 1 =>
        let sub = substr {| s: s, start: 0, len: plen |}
        str_eq {| a: sub, b: prefix |}
    end
end

fn is_space_char
  case {| ch |} =>
    (ch == 32) || (ch == 9) || (ch == 10) || (ch == 13)
end

fn trim_left_loop
  case {| s, i, slen |} =>
    match i >= slen
      case 1 => ""
      case 0 =>
        let ch = char_at {| s: s, n: i |}
        match is_space_char {| ch: ch |}
          case 1 =>
            trim_left_loop {| s: s, i: i + 1, slen: slen |}
          case 0 =>
            substr {| s: s, start: i, len: slen - i |}
        end
    end
end

fn trim_left
  case {| s |} =>
    trim_left_loop {| s: s, i: 0, slen: strlen {| s: s |} |}
end

fn trim_right_scan
  case {| s, i, slen, last_non_space |} =>
    match i >= slen
      case 1 => last_non_space
      case 0 =>
        let ch = char_at {| s: s, n: i |}
        match is_space_char {| ch: ch |}
          case 1 =>
            trim_right_scan {| s: s, i: i + 1, slen: slen, last_non_space: last_non_space |}
          case 0 =>
            trim_right_scan {| s: s, i: i + 1, slen: slen, last_non_space: i |}
        end
    end
end

fn trim_right
  case {| s |} =>
    let slen = strlen {| s: s |}
    let last = trim_right_scan {| s: s, i: 0, slen: slen, last_non_space: 0 - 1 |}
    match last >= 0
      case 1 => substr {| s: s, start: 0, len: last + 1 |}
      case 0 => ""
    end
end

fn trim
  case {| s |} =>
    trim_right {| s: trim_left {| s: s |} |}
end

fn append_char
  case {| s, ch |} =>
    concat {| a: s, b: char_of_int {| n: ch |} |}
end

fn index_char_from_loop
  case {| s, target, i, slen |} =>
    match i >= slen
      case 1 => 0 - 1
      case 0 =>
        let ch = char_at {| s: s, n: i |}
        match ch == target
          case 1 => i
          case 0 =>
            index_char_from_loop {| s: s, target: target, i: i + 1, slen: slen |}
        end
    end
end

fn index_char_from
  case {| s, target, start |} =>
    index_char_from_loop {| s: s, target: target, i: start, slen: strlen {| s: s |} |}
end

fn append_line
  case {| lines, line |} =>
    let llen = strlen {| s: lines |}
    match llen == 0
      case 1 => line
      case 0 =>
        let x = concat {| a: lines, b: "\n" |}
        concat {| a: x, b: line |}
    end
end

fn split_first_line
  case {| lines |} =>
    let slen = strlen {| s: lines |}
    match slen == 0
      case 1 => {| has: 0, head: "", tail: "" |}
      case 0 =>
        let idx = index_char_from {| s: lines, target: 10, start: 0 |}
        match idx >= 0
          case 1 =>
            {| has: 1, head: substr {| s: lines, start: 0, len: idx |}, tail: substr {| s: lines, start: idx + 1, len: slen - idx - 1 |} |}
          case 0 =>
            {| has: 1, head: lines, tail: "" |}
        end
    end
end

fn line_list_contains
  case {| lines, target |} =>
    let part = split_first_line {| lines: lines |}
    match part.has
      case 0 => 0
      case 1 =>
        let line = trim {| s: part.head |}
        let llen = strlen {| s: line |}
        match llen == 0
          case 1 => line_list_contains {| lines: part.tail, target: target |}
          case 0 =>
            match str_eq {| a: line, b: target |}
              case 1 => 1
              case 0 => line_list_contains {| lines: part.tail, target: target |}
            end
        end
    end
end

fn is_digit_char
  case {| ch |} =>
    (ch >= 48) && (ch <= 57)
end

fn is_digits_loop
  case {| s, i, slen |} =>
    match i >= slen
      case 1 => 1
      case 0 =>
        let ch = char_at {| s: s, n: i |}
        match is_digit_char {| ch: ch |}
          case 1 => is_digits_loop {| s: s, i: i + 1, slen: slen |}
          case 0 => 0
        end
    end
end

fn is_digits
  case {| s |} =>
    let slen = strlen {| s: s |}
    match slen > 0
      case 1 => is_digits_loop {| s: s, i: 0, slen: slen |}
      case 0 => 0
    end
end

fn normalize_safe_char
  case {| ch |} =>
    match ((ch >= 48) && (ch <= 57)) || ((ch >= 65) && (ch <= 90)) || ((ch >= 97) && (ch <= 122)) || (ch == 45) || (ch == 95)
      case 1 => ch
      case 0 => 95
    end
end

fn sanitize_name_loop
  case {| s, i, slen, acc |} =>
    match i >= slen
      case 1 => acc
      case 0 =>
        let ch = char_at {| s: s, n: i |}
        let nch = normalize_safe_char {| ch: ch |}
        let acc2 = append_char {| s: acc, ch: nch |}
        sanitize_name_loop {| s: s, i: i + 1, slen: slen, acc: acc2 |}
    end
end

fn sanitize_name
  case {| s |} =>
    sanitize_name_loop {| s: s, i: 0, slen: strlen {| s: s |}, acc: "" |}
end

fn echo_line
  case {| msg |} =>
    let s1 = concat {| a: "echo \"", b: msg |}
    let cmd = concat {| a: s1, b: "\"" |}
    sh {| command: cmd |}
end

fn with_space
  case {| a, b |} =>
    let s = concat {| a: a, b: " " |}
    concat {| a: s, b: b |}
end

fn join3
  case {| a, b, c |} =>
    let ab = with_space {| a: a, b: b |}
    with_space {| a: ab, b: c |}
end

fn join4
  case {| a, b, c, d |} =>
    let abc = join3 {| a: a, b: b, c: c |}
    with_space {| a: abc, b: d |}
end

fn join5
  case {| a, b, c, d, e |} =>
    let abcd = join4 {| a: a, b: b, c: c, d: d |}
    with_space {| a: abcd, b: e |}
end

fn join6
  case {| a, b, c, d, e, f |} =>
    let abcde = join5 {| a: a, b: b, c: c, d: d, e: e |}
    with_space {| a: abcde, b: f |}
end

fn join7
  case {| a, b, c, d, e, f, g |} =>
    let abcdef = join6 {| a: a, b: b, c: c, d: d, e: e, f: f |}
    with_space {| a: abcdef, b: g |}
end

fn join8
  case {| a, b, c, d, e, f, g, h |} =>
    let abcdefg = join7 {| a: a, b: b, c: c, d: d, e: e, f: f, g: g |}
    with_space {| a: abcdefg, b: h |}
end

fn last_index_char_loop
  case {| s, pos, target, last |} =>
    let slen = strlen {| s: s |}
    match pos >= slen
      case 1 => last
      case 0 =>
        let ch = char_at {| s: s, n: pos |}
        match ch == target
          case 1 => last_index_char_loop {| s: s, pos: pos + 1, target: target, last: pos |}
          case 0 => last_index_char_loop {| s: s, pos: pos + 1, target: target, last: last |}
        end
    end
end

fn basename_no_ext
  case {| path |} =>
    let plen = strlen {| s: path |}
    let slash = last_index_char_loop {| s: path, pos: 0, target: 47, last: 0 - 1 |}
    let start = slash + 1
    let file = substr {| s: path, start: start, len: plen - start |}
    let flen = strlen {| s: file |}
    let dot = last_index_char_loop {| s: file, pos: 0, target: 46, last: 0 - 1 |}
    match dot >= 0
      case 1 => substr {| s: file, start: 0, len: dot |}
      case 0 => file
    end
end

fn mode_is_valid
  case {| mode |} =>
    (str_eq {| a: mode, b: "c" |}) ||
    (str_eq {| a: mode, b: "asm" |}) ||
    (str_eq {| a: mode, b: "asm-linux" |}) ||
    (str_eq {| a: mode, b: "x86" |}) ||
    (str_eq {| a: mode, b: "x86-linux" |})
end

fn file_exists
  case {| path |} =>
    let c1 = concat {| a: "test -f ", b: path |}
    let rc = sh {| command: c1 |}
    rc == 0
end

fn dir_exists
  case {| path |} =>
    let c1 = concat {| a: "test -d ", b: path |}
    let rc = sh {| command: c1 |}
    rc == 0
end

fn path_join
  case {| a, b |} =>
    let alen = strlen {| s: a |}
    let blen = strlen {| s: b |}
    match alen == 0
      case 1 => b
      case 0 =>
        match blen == 0
          case 1 => a
          case 0 =>
            let a_last = char_at {| s: a, n: alen - 1 |}
            let b_first = char_at {| s: b, n: 0 |}
            match a_last == 47
              case 1 =>
                match b_first == 47
                  case 1 =>
                    let b_trim = substr {| s: b, start: 1, len: blen - 1 |}
                    concat {| a: a, b: b_trim |}
                  case 0 => concat {| a: a, b: b |}
                end
              case 0 =>
                match b_first == 47
                  case 1 => concat {| a: a, b: b |}
                  case 0 =>
                    let x = concat {| a: a, b: "/" |}
                    concat {| a: x, b: b |}
                end
            end
        end
    end
end

fn resolve_runtime_path
  case {| primary, fallback |} =>
    let c1 = concat {| a: "test -f ", b: primary |}
    let rc = sh {| command: c1 |}
    match rc == 0
      case 1 => primary
      case 0 => fallback
    end
end

fn runtime_for_mode
  case {| mode |} =>
    resolve_runtime_path {| primary: "runtime/runtime.c", fallback: "../../runtime/runtime.c" |}
end

fn target_dir
  case {| |} => "target/debug"
end

fn output_binary_path
  case {| source |} =>
    let base = basename_no_ext {| path: source |}
    let p1 = concat {| a: target_dir {| |}, b: "/" |}
    concat {| a: p1, b: base |}
end

fn output_source_path
  case {| source, mode |} =>
    let bin = output_binary_path {| source: source |}
    match str_eq {| a: mode, b: "c" |}
      case 1 => concat {| a: bin, b: ".c" |}
      case 0 => concat {| a: bin, b: ".s" |}
    end
end

fn check_source_path
  case {| source, mode |} =>
    let base = basename_no_ext {| path: source |}
    let p1 = concat {| a: target_dir {| |}, b: "/.check_" |}
    let p2 = concat {| a: p1, b: base |}
    match str_eq {| a: mode, b: "c" |}
      case 1 => concat {| a: p2, b: ".c" |}
      case 0 => concat {| a: p2, b: ".s" |}
    end
end

fn append_word
  case {| words, word |} =>
    let len = strlen {| s: words |}
    match len == 0
      case 1 => word
      case 0 =>
        let s1 = concat {| a: words, b: " " |}
        concat {| a: s1, b: word |}
    end
end

fn lib_path_for
  case {| name |} =>
    let p1 = concat {| a: ".stela/lib/", b: name |}
    concat {| a: p1, b: ".stelib" |}
end

fn dep_bundle_path
  case {| |} => ".stela/lib/.deps.stelib"
end

fn manifest_default
  case {| |} =>
    {|
      name: "",
      has_name: 0,
      entry: "",
      has_entry: 0,
      kind: "lib",
      major: "1",
      deps: "",
      replaces: ""
    |}
end

fn dep_default
  case {| |} =>
    {|
      ok: 0,
      name: "",
      source: "",
      ref: "",
      major: "1"
    |}
end

fn install_state_default
  case {| |} =>
    {|
      visited: "",
      order: "",
      locks: ""
    |}
end

fn default_opts
  case {| |} =>
    {|
      source: "",
      has_source: 0,
      compiler: "./compiler",
      mode: "c",
      sandbox: 1,
      libs: "",
      name: "",
      has_name: 0,
      manifest: "stela.pkg",
      has_manifest: 0,
      ref: "",
      has_ref: 0,
      major: "1",
      has_major: 0,
      kind: "app",
      has_kind: 0
    |}
end

fn set_source
  case {| opts, source |} =>
    {|
      source: source,
      has_source: 1,
      compiler: opts.compiler,
      mode: opts.mode,
      sandbox: opts.sandbox,
      libs: opts.libs,
      name: opts.name,
      has_name: opts.has_name,
      manifest: opts.manifest,
      has_manifest: opts.has_manifest,
      ref: opts.ref,
      has_ref: opts.has_ref,
      major: opts.major,
      has_major: opts.has_major,
      kind: opts.kind,
      has_kind: opts.has_kind
    |}
end

fn set_compiler
  case {| opts, compiler |} =>
    {|
      source: opts.source,
      has_source: opts.has_source,
      compiler: compiler,
      mode: opts.mode,
      sandbox: opts.sandbox,
      libs: opts.libs,
      name: opts.name,
      has_name: opts.has_name,
      manifest: opts.manifest,
      has_manifest: opts.has_manifest,
      ref: opts.ref,
      has_ref: opts.has_ref,
      major: opts.major,
      has_major: opts.has_major,
      kind: opts.kind,
      has_kind: opts.has_kind
    |}
end

fn set_mode
  case {| opts, mode |} =>
    {|
      source: opts.source,
      has_source: opts.has_source,
      compiler: opts.compiler,
      mode: mode,
      sandbox: opts.sandbox,
      libs: opts.libs,
      name: opts.name,
      has_name: opts.has_name,
      manifest: opts.manifest,
      has_manifest: opts.has_manifest,
      ref: opts.ref,
      has_ref: opts.has_ref,
      major: opts.major,
      has_major: opts.has_major,
      kind: opts.kind,
      has_kind: opts.has_kind
    |}
end

fn set_sandbox
  case {| opts, sandbox |} =>
    {|
      source: opts.source,
      has_source: opts.has_source,
      compiler: opts.compiler,
      mode: opts.mode,
      sandbox: sandbox,
      libs: opts.libs,
      name: opts.name,
      has_name: opts.has_name,
      manifest: opts.manifest,
      has_manifest: opts.has_manifest,
      ref: opts.ref,
      has_ref: opts.has_ref,
      major: opts.major,
      has_major: opts.has_major,
      kind: opts.kind,
      has_kind: opts.has_kind
    |}
end

fn add_lib
  case {| opts, lib_name |} =>
    let lib_path = lib_path_for {| name: lib_name |}
    let libs2 = append_word {| words: opts.libs, word: lib_path |}
    {|
      source: opts.source,
      has_source: opts.has_source,
      compiler: opts.compiler,
      mode: opts.mode,
      sandbox: opts.sandbox,
      libs: libs2,
      name: opts.name,
      has_name: opts.has_name,
      manifest: opts.manifest,
      has_manifest: opts.has_manifest,
      ref: opts.ref,
      has_ref: opts.has_ref,
      major: opts.major,
      has_major: opts.has_major,
      kind: opts.kind,
      has_kind: opts.has_kind
    |}
end

